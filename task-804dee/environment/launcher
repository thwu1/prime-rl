#!/usr/bin/env bash
# Discourse Docker Launcher — Configuration Validation Utility
# Based on the official discourse_docker launcher project.
# Provides: precheck <config|all>

set -eo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONTAINERS_DIR="${DISCOURSE_CONTAINERS_DIR:-$SCRIPT_DIR/containers}"
BUNDLED_FILE="$SCRIPT_DIR/bundled_plugins.txt"
SYSINFO_FILE="$SCRIPT_DIR/system_info.json"

RED='\033[0;31m'
YLW='\033[1;33m'
GRN='\033[0;32m'
RST='\033[0m'

errors=0
warnings=0
issues=()

log_error() {
    local file="$1" msg="$2"
    issues+=("[ERROR] $file: $msg")
    ((errors++)) || true
}

log_warning() {
    local file="$1" msg="$2"
    issues+=("[WARNING] $file: $msg")
    ((warnings++)) || true
}

# Minimal YAML single-value extractor — no dependency on external parsers.
yaml_val() {
    local content="$1" key="$2"
    echo "$content" | { grep -m1 -E "^[[:space:]]*${key}:" || true; } | \
        sed 's/[^:]*:[[:space:]]*//' | \
        sed 's/[[:space:]]*$//' | \
        sed "s/^[\"']//" | \
        sed "s/[\"'][[:space:]]*$//"
}

get_git_urls() {
    local content="$1"
    echo "$content" | { grep -oE 'git clone https?://[^ ]+' || true; } | awk '{print $3}'
}

get_host_ports() {
    local content="$1"
    echo "$content" | { grep -oE '"[0-9]+:[0-9]+"' || true; } | tr -d '"' | cut -d: -f1
}

get_templates() {
    local content="$1" capture=0
    while IFS= read -r line; do
        [[ "$line" =~ ^templates: ]] && { capture=1; continue; }
        if (( capture )); then
            if [[ "$line" =~ ^[[:space:]]*-[[:space:]]*\" ]]; then
                echo "$line" | sed 's/.*"\(.*\)".*/\1/'
            elif [[ ! "$line" =~ ^[[:space:]] ]]; then
                break
            fi
        fi
    done <<< "$content"
}

# ── Validation checks ──────────────────────────────────────────────

chk_bundled() {
    local cfg="$1" content="$2" fn
    fn=$(basename "$cfg")
    [[ -f "$BUNDLED_FILE" ]] || return 0

    local urls
    urls=$(get_git_urls "$content")
    for url in $urls; do
        local name
        name=$(basename "$url")
        if grep -qx "$name" "$BUNDLED_FILE"; then
            log_warning "$fn" "Plugin '$name' is bundled with Discourse and should not be git-cloned"
        fi
    done
}

chk_memory() {
    local cfg="$1" content="$2" fn
    fn=$(basename "$cfg")
    [[ -f "$SYSINFO_FILE" ]] || return 0

    local raw
    raw=$(yaml_val "$content" "db_shared_buffers")
    [[ -n "$raw" ]] || return 0

    local val=${raw%%[A-Za-z]*}
    local unit=${raw##*[0-9]}
    [[ "$unit" == "GB" ]] && val=$((val * 1024))

    local ram cap
    ram=$(python3 -c "import json; print(json.load(open('$SYSINFO_FILE'))['system_memory_mb'])")
    cap=$((ram * 25 / 100))

    (
        if (( val > cap )); then
            log_error "$fn" "db_shared_buffers ${raw} exceeds 25% of system RAM (max ${cap}MB)"
        fi
    )
}

chk_smtp() {
    local cfg="$1" content="$2" fn
    fn=$(basename "$cfg")

    local port ftls
    port=$(yaml_val "$content" "DISCOURSE_SMTP_PORT")
    ftls=$(yaml_val "$content" "DISCOURSE_SMTP_FORCE_TLS")
    [[ -n "$port" ]] || return 0

    if [[ "$port" == "465" && "$ftls" != "true" ]]; then
        log_error "$fn" "Port 465 requires DISCOURSE_SMTP_FORCE_TLS=true for implicit TLS"
    fi
}

chk_hostname() {
    local cfg="$1" content="$2" fn
    fn=$(basename "$cfg")

    local host
    host=$(yaml_val "$content" "DISCOURSE_HOSTNAME")
    [[ -n "$host" ]] || return 0

    if echo "$host" | grep -qE '^example\.(com|org|net)$'; then
        log_warning "$fn" "Hostname '$host' appears to be a placeholder"
    fi
}

chk_dev_emails() {
    local cfg="$1" content="$2" fn
    fn=$(basename "$cfg")

    # Only configs that serve web traffic need developer emails
    echo "$content" | grep -q 'web\.standalone\.template\.yml' || return 0

    local emails
    emails=$(yaml_val "$content" "DISCOURSE_DEVELOPER_EMAILS")
    if [[ -z "$emails" ]]; then
        log_error "$fn" "DISCOURSE_DEVELOPER_EMAILS is empty — required for initial admin account"
    fi
}

chk_ssl() {
    local cfg="$1" content="$2" fn
    fn=$(basename "$cfg")

    local tmpls has_ssl=0 has_le=0
    tmpls=$(get_templates "$content")

    while IFS= read -r t; do
        [[ -z "$t" ]] && continue
        if echo "$t" | grep -q '^web\.ssl\.template\.yml$'; then has_ssl=1; fi
        if echo "$t" | grep -q 'web\.letsencrypt\.ssl\.template\.yml'; then has_le=1; fi
    done <<< "$tmpls"

    if (( has_ssl && !has_le )); then
        log_warning "$fn" "SSL template present without Let's Encrypt — manual certificate management required"
    fi
}

chk_shm() {
    local cfg="$1" content="$2" fn
    fn=$(basename "$cfg")

    echo "$content" | grep -q 'postgresql\.template\.yml' || return 0

    local dargs
    dargs=$(yaml_val "$content" "docker_args")
    if [[ -z "$dargs" ]] || ! echo "$dargs" | grep -q 'shm-size'; then
        log_error "$fn" "Missing --shm-size in docker_args; Docker default (64MB) will cause PostgreSQL crashes under load"
    fi
}

chk_ports() {
    local -a cfgs=("$@")
    declare -A seen

    for cfg in "${cfgs[@]}"; do
        local fn
        fn=$(basename "$cfg")
        local content
        content=$(<"$cfg")
        local ports
        ports=$(get_host_ports "$content")

        for p in $ports; do
            if [[ -n "${seen[$p]+_}" ]]; then
                local other="${seen[$p]}"
                if [[ "$fn" = "$other" ]]; then
                    log_error "$fn" "Host port $p conflicts with $other"
                fi
            else
                seen[$p]="$fn"
            fi
        done
    done
}

# ── Entry point ─────────────────────────────────────────────────────

do_precheck() {
    local target="${1:-all}"
    local -a cfgs

    if [[ "$target" == "all" ]]; then
        for f in "$CONTAINERS_DIR"/*.yml; do
            [[ -f "$f" ]] && cfgs+=("$f")
        done
    else
        cfgs=("$CONTAINERS_DIR/${target}.yml")
        [[ -f "${cfgs[0]}" ]] || { echo "Config not found: ${cfgs[0]}"; exit 1; }
    fi

    echo "Discourse Docker — Configuration Precheck"
    echo "==========================================="
    echo ""

    for cfg in "${cfgs[@]}"; do
        echo "  * $(basename "$cfg")"
        local content
        content=$(<"$cfg")

        chk_bundled    "$cfg" "$content"
        chk_memory     "$cfg" "$content"
        chk_smtp       "$cfg" "$content"
        chk_hostname   "$cfg" "$content"
        chk_dev_emails "$cfg" "$content"
        chk_ssl        "$cfg" "$content"
        chk_shm        "$cfg" "$content"
    done

    chk_ports "${cfgs[@]}"

    echo ""
    if (( ${#issues[@]} == 0 )); then
        echo -e "${GRN}All checks passed — no issues found.${RST}"
        exit 0
    fi

    for iss in "${issues[@]}"; do
        if [[ "$iss" == \[ERROR\]* ]]; then
            echo -e "  ${RED}${iss}${RST}"
        else
            echo -e "  ${YLW}${iss}${RST}"
        fi
    done
    echo ""
    echo "  Totals: $errors error(s), $warnings warning(s)"
    exit 1
}

case "${1:-}" in
    precheck) do_precheck "${2:-}" ;;
    *)
        echo "Usage: $(basename "$0") precheck [config|all]"
        exit 1
        ;;
esac
