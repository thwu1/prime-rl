# Scientific/Mathematical Braille Translation Table
#
# This table defines character mappings and translation rules for
# rendering scientific and mathematical text in braille. It covers
# function name contractions, decimal/number formatting, superscript
# and subscript notation, and multi-pass expression cleanup.
#

# ===================================================================
# Whitespace
# ===================================================================

space \s 0
space \t 0

# ===================================================================
# Lowercase Letters (standard English braille)
# ===================================================================

lowercase a 1
lowercase b 12
lowercase c 14
lowercase d 145
lowercase e 15
lowercase f 124
lowercase g 1245
lowercase h 125
lowercase i 24
lowercase j 245
lowercase k 13
lowercase l 123
lowercase m 134
lowercase n 1345
lowercase o 135
lowercase p 1234
lowercase q 12345
lowercase r 1235
lowercase s 234
lowercase t 2345
lowercase u 136
lowercase v 1236
lowercase w 2456
lowercase x 1346
lowercase y 13456
lowercase z 1356

# ===================================================================
# Uppercase Letters
# ===================================================================

base uppercase A a
base uppercase B b
base uppercase C c
base uppercase D d
base uppercase E e
base uppercase F f
base uppercase G g
base uppercase H h
base uppercase I i
base uppercase J j
base uppercase K k
base uppercase L l
base uppercase M m
base uppercase N n
base uppercase O o
base uppercase P p
base uppercase Q q
base uppercase R r
base uppercase S s
base uppercase T t
base uppercase U u
base uppercase V v
base uppercase W w
base uppercase X x
base uppercase Y y
base uppercase Z z

# ===================================================================
# Digits (share dot patterns with letters a-j, preceded by numsign)
# ===================================================================

digit 0 245
digit 1 1
digit 2 12
digit 3 14
digit 4 145
digit 5 15
digit 6 124
digit 7 1245
digit 8 125
digit 9 24

# ===================================================================
# Braille Indicators
# ===================================================================

numsign 3456
capsletter 6

# ===================================================================
# Punctuation
# ===================================================================

punctuation . 256
punctuation , 2
punctuation ; 23
punctuation : 25
punctuation ! 235
punctuation ? 236
punctuation ' 3
punctuation ( 12356
punctuation ) 23456

# ===================================================================
# Mathematical Operators and Signs
# ===================================================================

math + 346
math - 36
math = 2356
sign ^ 45
sign _ 456

# ===================================================================
# TRANSLATION RULES
# ===================================================================

# --- Function name contractions ---
always sin 5-234
always cos 5-14
always tan 5-2345
always log 5-123
always exp 5-15

# --- Decimal point and number formatting ---
midnum . 46
midnum , 2

# --- Superscript notation (context rule, first pass) ---
noback context ["^"]$d @35

# --- Subscript notation (context rule, first pass) ---
noback context ["_"$d] @16

# --- Pass 2: Remove redundant number signs ---
noback pass2 @346@3456 ?
noback pass2 @36@3456 ?
noback pass2 @2356@3456 ?
noback pass2 @45[@3456] ?
noback pass2 @16[@3456] ?
