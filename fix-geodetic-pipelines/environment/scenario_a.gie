# Scenario A: Oblique Stereographic projection
# Region: The Netherlands
# Reference data: GIGS Test 5104 (Amersfoort / RD New)
#
# Fix the projection parameters so all test cases pass within tolerance.

operation +proj=sterea \
          +lat_0=52.15616055555556 \
          +lon_0=5.38763888888889 \
          +k=0.9996 \
          +x_0=155000 \
          +y_0=463000 \
          +ellps=bessel \
          +units=m

tolerance 0.05 m

