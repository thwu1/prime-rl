# Maintainer: Example Maintainer <maintainer@example.com>

pkgname=baselib-git
pkgver=2.2.0.r3.gabc1234
pkgrel=1
pkgdesc="Core utility library (development version)"
arch=('x86_64')
url="https://example.com/baselib"
license=('MIT')
depends=('glibc' 'openssl')
makedepends=('cmake' 'git')
provides=('baselib=2.2.0')
conflicts=('baselib')
source=("git+https://example.com/baselib.git")
sha256sums=('SKIP')

pkgver() {
    cd baselib
    git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
    cd baselib
    cmake -B build -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

package() {
    cd baselib
    DESTDIR="${pkgdir}" cmake --install build
}
