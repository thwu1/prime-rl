int x = 0;

int inc() {
    x = x + 1;
    return x;
}

int main() {
    if (1 || inc()) {}
    putint(x);
    putch(10);

    if (0 && inc()) {}
    putint(x);
    putch(10);

    if (0 || inc()) {}
    putint(x);
    putch(10);

    if (1 && inc()) {}
    putint(x);
    putch(10);

    return 0;
}
