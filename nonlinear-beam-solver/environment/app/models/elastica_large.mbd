# Cantilever beam under large transverse tip force

set: real EI_val = 1.;
set: real EA_val = 1.e6;
set: real GA_val = 1.e6;

begin: data;
    problem: initial value;
end: data;

begin: initial value;
    initial time: 0.;
    final time: 1.;
    time step: 0.05;

    max iterations: 50;
    tolerance: 1.e-6;
end: initial value;

begin: control data;
    structural nodes: 11;
    beams: 5;
    joints: 1;
    forces: 1;
end: control data;

begin: nodes;
    structural: 1, static, 0.0, 0., 0., eye, null, null;
    structural: 2, dynamic, 0.1, 0., 0., eye, null, null;
    structural: 3, dynamic, 0.2, 0., 0., eye, null, null;
    structural: 4, dynamic, 0.3, 0., 0., eye, null, null;
    structural: 5, dynamic, 0.4, 0., 0., eye, null, null;
    structural: 6, dynamic, 0.5, 0., 0., eye, null, null;
    structural: 7, dynamic, 0.6, 0., 0., eye, null, null;
    structural: 8, dynamic, 0.7, 0., 0., eye, null, null;
    structural: 9, dynamic, 0.8, 0., 0., eye, null, null;
    structural: 10, dynamic, 0.9, 0., 0., eye, null, null;
    structural: 11, dynamic, 1.0, 0., 0., eye, null, null;
end: nodes;

begin: elements;
    joint: 1, clamp, 1, node, node;

    beam: 1,
        1, null, 2, null, 3, null,
        eye,
        linear elastic generic,
            diag, EA_val, GA_val, GA_val, EI_val, EI_val, EI_val,
        same,
        same;
    beam: 2,
        3, null, 4, null, 5, null,
        eye,
        linear elastic generic,
            diag, EA_val, GA_val, GA_val, EI_val, EI_val, EI_val,
        same,
        same;
    beam: 3,
        5, null, 6, null, 7, null,
        eye,
        linear elastic generic,
            diag, EA_val, GA_val, GA_val, EI_val, EI_val, EI_val,
        same,
        same;
    beam: 4,
        7, null, 8, null, 9, null,
        eye,
        linear elastic generic,
            diag, EA_val, GA_val, GA_val, EI_val, EI_val, EI_val,
        same,
        same;
    beam: 5,
        9, null, 10, null, 11, null,
        eye,
        linear elastic generic,
            diag, EA_val, GA_val, GA_val, EI_val, EI_val, EI_val,
        same,
        same;

    force: 1, absolute, 11, position, null, 0., 1., 0., const, 5.0;
end: elements;
