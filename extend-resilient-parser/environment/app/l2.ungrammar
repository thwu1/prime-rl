File = Fn*

Fn = 'fn' 'name' ParamList ('->' TypeExpr)? Block

ParamList = '(' Param* ')'
Param = 'name' ':' TypeExpr ','?

TypeExpr = 'name'

Block = '{' Stmt* '}'

Stmt =
  StmtLet
| StmtReturn
| StmtExpr

StmtLet    = 'let' 'name' '=' Expr ';'
StmtReturn = 'return' Expr ';'
StmtExpr   = Expr ';'

Expr =
  ExprLiteral
| ExprName
| ExprParen
| ExprBinary
| ExprUnary
| ExprCall
| ExprIf
| ExprWhile
| ExprFor
| ExprArray
| ExprIndex
| ExprTernary

// Operator precedence (lowest to highest):
//   1. ? :       ternary conditional (RIGHT-associative)
//   2. ||        logical or
//   3. &&        logical and
//   4. == !=     equality
//   5. < >       comparison
//   6. + -       additive
//   7. * /       multiplicative
//   Unary (- !) binds tighter than all binary operators.
//   Postfix call () and index [] bind tighter than unary.

ExprLiteral = 'int' | 'true' | 'false' | 'str'
ExprName    = 'name'
ExprParen   = '(' Expr ')'
ExprBinary  = Expr ('+' | '-' | '*' | '/' | '<' | '>' | '==' | '!=' | '&&' | '||') Expr
ExprUnary   = ('-' | '!') Expr
ExprCall    = Expr ArgList
ExprIf      = 'if' Expr Block ('else' Block)?
ExprWhile   = 'while' Expr Block
ExprFor     = 'for' 'name' 'in' Expr Block
ExprArray   = '[' (Expr (',' Expr)* ','?)? ']'
ExprIndex   = Expr '[' Expr ']'
ExprTernary = Expr '?' Expr ':' Expr

ArgList = '(' Arg* ')'
Arg = Expr ','?
