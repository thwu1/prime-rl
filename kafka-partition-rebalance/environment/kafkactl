#!/usr/bin/env python3
"""
kafkactl - Kafka Cluster Administration Tool

A CLI tool for managing Kafka partition reassignments in the kafka-prod-east-1 cluster.
Reads cluster metadata from /app/metadata/ and validates/simulates reassignment plans.

"""

import argparse
import csv
import json
import os
import re
import sys
import yaml
from collections import defaultdict


METADATA_DIR = "/app/metadata"


def parse_broker_configs():
    """Parse server.properties files to get broker topology."""
    brokers = []
    config_dir = os.path.join(METADATA_DIR, "broker_configs")
    for fname in sorted(os.listdir(config_dir)):
        if not fname.endswith(".properties"):
            continue
        path = os.path.join(config_dir, fname)
        props = {}
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if "=" in line:
                    k, v = line.split("=", 1)
                    props[k.strip()] = v.strip()
        if "broker.id" in props:
            brokers.append({
                "id": int(props["broker.id"]),
                "rack": props.get("broker.rack", "unknown"),
            })
    return sorted(brokers, key=lambda b: b["id"])


def parse_disk_quotas():
    """Parse disk_quotas.csv for broker disk capacities."""
    quotas = {}
    path = os.path.join(METADATA_DIR, "disk_quotas.csv")
    with open(path) as f:
        reader = csv.DictReader(f)
        for row in reader:
            bid = int(row["broker_id"])
            cap_bytes = int(row["capacity_bytes"])
            quotas[bid] = cap_bytes / (1024 ** 3)  # Convert to GB
    return quotas


def parse_topic_descriptions():
    """Parse kafka-topics --describe output format."""
    topics = {}
    path = os.path.join(METADATA_DIR, "topic_descriptions.txt")
    current_topic = None

    with open(path) as f:
        for line in f:
            line = line.rstrip()
            if not line:
                continue

            if not line.startswith("\t"):
                # Topic header line
                fields = {}
                for part in line.split("\t"):
                    if ": " in part:
                        k, v = part.split(": ", 1)
                        fields[k.strip()] = v.strip()
                current_topic = fields.get("Topic")
                if current_topic:
                    topics[current_topic] = {
                        "name": current_topic,
                        "replication_factor": int(fields.get("ReplicationFactor", 1)),
                        "partitions": [],
                    }
            else:
                # Partition detail line
                fields = {}
                for part in line.strip().split("\t"):
                    if ": " in part:
                        k, v = part.split(": ", 1)
                        fields[k.strip()] = v.strip()
                if current_topic and "Partition" in fields:
                    replicas = [int(r) for r in fields["Replicas"].split(",")]
                    topics[current_topic]["partitions"].append({
                        "partition": int(fields["Partition"]),
                        "leader": int(fields["Leader"]),
                        "replicas": replicas,
                    })
    return topics


def parse_log_dirs():
    """Parse kafka-log-dirs --describe JSON output for partition sizes."""
    path = os.path.join(METADATA_DIR, "log_dirs.json")
    with open(path) as f:
        data = json.load(f)

    sizes = {}  # (topic, partition) -> size_gb
    for broker in data["brokers"]:
        for log_dir in broker["logDirs"]:
            for part_entry in log_dir["partitions"]:
                # Parse "topic-partition" format
                pname = part_entry["partition"]
                # Handle topic names with hyphens: last segment after last hyphen is partition number
                match = re.match(r'^(.+)-(\d+)$', pname)
                if match:
                    topic = match.group(1)
                    pid = int(match.group(2))
                    key = (topic, pid)
                    size_gb = part_entry["size"] / (1024 ** 3)
                    if key not in sizes:
                        sizes[key] = size_gb
    return sizes


def parse_constraints():
    """Parse constraints YAML."""
    path = os.path.join(METADATA_DIR, "constraints.yaml")
    with open(path) as f:
        data = yaml.safe_load(f)
    rebal = data.get("rebalancing", {})
    return {
        "max_concurrent_moves": rebal.get("throttling", {}).get("max_concurrent_partition_moves", 10),
        "rack_aware": rebal.get("rack_awareness", {}).get("enabled", True),
        "max_leader_imbalance": rebal.get("balance_limits", {}).get("max_leader_imbalance", 3),
        "max_replica_imbalance": rebal.get("balance_limits", {}).get("max_replica_imbalance", 3),
        "minimize_data_movement": rebal.get("optimization", {}).get("objective", "") == "minimize_data_movement",
    }


def build_cluster_state():
    """Build complete cluster state from metadata files."""
    brokers = parse_broker_configs()
    quotas = parse_disk_quotas()
    topics_data = parse_topic_descriptions()
    sizes = parse_log_dirs()
    constraints = parse_constraints()

    for b in brokers:
        b["disk_capacity_gb"] = quotas.get(b["id"], 0)

    topics_list = []
    for tname in sorted(topics_data.keys()):
        tdata = topics_data[tname]
        parts = []
        for p in sorted(tdata["partitions"], key=lambda x: x["partition"]):
            key = (tname, p["partition"])
            p["size_gb"] = sizes.get(key, 0)
            parts.append(p)
        topics_list.append({
            "name": tname,
            "replication_factor": tdata["replication_factor"],
            "partitions": parts,
        })

    return {
        "cluster_id": "kafka-prod-east-1",
        "brokers": brokers,
        "topics": topics_list,
        "constraints": constraints,
    }


def cmd_inspect(args):
    """Show current cluster state summary."""
    state = build_cluster_state()
    brokers = state["brokers"]
    topics = state["topics"]

    print("=" * 70)
    print(f"  Cluster: {state['cluster_id']}")
    print("=" * 70)

    print("\n--- Broker Topology ---")
    print(f"  {'Broker':>8}  {'Rack':<10}  {'Disk Capacity':>14}")
    for b in brokers:
        print(f"  {b['id']:>8}  {b['rack']:<10}  {b['disk_capacity_gb']:>11.0f} GB")

    broker_rack = {b["id"]: b["rack"] for b in brokers}
    all_racks = set(broker_rack.values())
    num_racks = len(all_racks)

    print("\n--- Topic Summary ---")
    total_partitions = 0
    total_replicas = 0
    rack_violations = 0
    replica_count = defaultdict(int)
    leader_count = defaultdict(int)
    disk_usage = defaultdict(float)

    for topic in topics:
        rf = topic["replication_factor"]
        pc = len(topic["partitions"])
        total_partitions += pc
        total_replicas += pc * rf
        print(f"  {topic['name']:<20}  partitions={pc:<4}  RF={rf}")
        for part in topic["partitions"]:
            leader_count[part["leader"]] += 1
            racks_used = set()
            for bid in part["replicas"]:
                replica_count[bid] += 1
                disk_usage[bid] += part["size_gb"]
                racks_used.add(broker_rack[bid])
            ideal = min(rf, num_racks)
            if len(racks_used) < ideal:
                rack_violations += 1

    print(f"\n--- Cluster Metrics ---")
    print(f"  Total partitions: {total_partitions}")
    print(f"  Total replicas:   {total_replicas}")
    print(f"  Rack violations:  {rack_violations}")

    print(f"\n  {'Broker':>8}  {'Replicas':>10}  {'Leaders':>10}  {'Disk Used':>12}  {'Capacity':>12}  {'Util%':>8}")
    for b in brokers:
        bid = b["id"]
        usage = disk_usage.get(bid, 0)
        cap = b["disk_capacity_gb"]
        util = (usage / cap * 100) if cap > 0 else 0
        print(f"  {bid:>8}  {replica_count.get(bid,0):>10}  {leader_count.get(bid,0):>10}  {usage:>9.1f} GB  {cap:>9.0f} GB  {util:>7.1f}%")

    print(f"\n--- Constraints ---")
    c = state["constraints"]
    print(f"  Max replica imbalance:      {c['max_replica_imbalance']}")
    print(f"  Max leader imbalance:       {c['max_leader_imbalance']}")
    print(f"  Max concurrent moves/batch: {c['max_concurrent_moves']}")
    print(f"  Rack awareness:             {'enabled' if c['rack_aware'] else 'disabled'}")
    print()


def cmd_validate(args):
    """Validate a reassignment plan against cluster constraints."""
    plan_path = args.plan_file
    output_path = args.output or "/app/validation_report.json"

    if not os.path.exists(plan_path):
        print(f"ERROR: Plan file not found: {plan_path}", file=sys.stderr)
        sys.exit(1)

    try:
        with open(plan_path) as f:
            plan = json.load(f)
    except json.JSONDecodeError as e:
        print(f"ERROR: Invalid JSON in plan file: {e}", file=sys.stderr)
        sys.exit(1)

    state = build_cluster_state()
    brokers = state["brokers"]
    topics = state["topics"]
    constraints = state["constraints"]

    broker_ids = sorted([b["id"] for b in brokers])
    broker_rack = {b["id"]: b["rack"] for b in brokers}
    broker_capacity = {b["id"]: b["disk_capacity_gb"] for b in brokers}
    all_racks = set(broker_rack.values())
    num_racks = len(all_racks)

    # Build original assignments
    original = {}
    for topic in topics:
        rf = topic["replication_factor"]
        for part in topic["partitions"]:
            key = (topic["name"], part["partition"])
            original[key] = {
                "replicas": list(part["replicas"]),
                "leader": part["leader"],
                "size_gb": part["size_gb"],
                "rf": rf,
            }

    errors = []
    warnings = []

    # Validate plan structure
    if plan.get("version") != 1:
        errors.append("Plan version must be 1")

    if "batches" not in plan or not isinstance(plan.get("batches"), list):
        errors.append("Plan must contain a 'batches' array")
        report = {"valid": False, "errors": errors, "warnings": warnings, "checks_passed": 0, "checks_total": 1}
        with open(output_path, "w") as f:
            json.dump(report, f, indent=2)
        print(f"VALIDATION FAILED: {len(errors)} error(s)")
        for e in errors:
            print(f"  ERROR: {e}")
        sys.exit(1)

    # Apply plan to get final state
    final = {}
    for key, val in original.items():
        final[key] = dict(val)

    seen_partitions = set()
    checks_passed = 0
    checks_total = 0

    # Check batch structure
    checks_total += 1
    batch_ids = [b.get("batch_id") for b in plan["batches"]]
    if batch_ids == list(range(1, len(batch_ids) + 1)):
        checks_passed += 1
    else:
        errors.append(f"Batch IDs must be sequential starting from 1, got: {batch_ids}")

    # Check batch sizes
    checks_total += 1
    max_moves = constraints["max_concurrent_moves"]
    batch_size_ok = True
    for batch in plan["batches"]:
        if len(batch.get("partitions", [])) > max_moves:
            errors.append(f"Batch {batch.get('batch_id')}: {len(batch['partitions'])} moves exceeds max {max_moves}")
            batch_size_ok = False
    if batch_size_ok:
        checks_passed += 1

    # Check entry format and apply
    checks_total += 1
    format_ok = True
    for batch in plan["batches"]:
        for entry in batch.get("partitions", []):
            for field in ["topic", "partition", "replicas", "log_dirs"]:
                if field not in entry:
                    errors.append(f"Missing field '{field}' in partition entry")
                    format_ok = False
                    continue

            if "replicas" in entry and "log_dirs" in entry:
                if len(entry["log_dirs"]) != len(entry["replicas"]):
                    errors.append(f"log_dirs length must match replicas length for {entry.get('topic')}-{entry.get('partition')}")
                    format_ok = False
                if not all(d == "any" for d in entry.get("log_dirs", [])):
                    errors.append(f"All log_dirs entries must be 'any' for {entry.get('topic')}-{entry.get('partition')}")
                    format_ok = False

            key = (entry.get("topic"), entry.get("partition"))
            if key in seen_partitions:
                errors.append(f"Duplicate partition in plan: {key}")
                format_ok = False
            seen_partitions.add(key)

            if key not in original:
                errors.append(f"Unknown partition: {key}")
                format_ok = False
                continue

            # Check only changed
            if entry.get("replicas") == original[key]["replicas"]:
                warnings.append(f"Partition {key} in plan but replicas unchanged")

            final[key]["replicas"] = list(entry["replicas"])
            final[key]["leader"] = entry["replicas"][0]

    if format_ok:
        checks_passed += 1

    # Check no co-location
    checks_total += 1
    coloc_ok = True
    for key, val in final.items():
        replicas = val["replicas"]
        if len(replicas) != len(set(replicas)):
            errors.append(f"Partition {key}: duplicate broker in replicas {replicas}")
            coloc_ok = False
        for bid in replicas:
            if bid not in broker_ids:
                errors.append(f"Partition {key}: invalid broker ID {bid}")
                coloc_ok = False
    if coloc_ok:
        checks_passed += 1

    # Check RF preserved
    checks_total += 1
    rf_ok = True
    for key in original:
        if len(final[key]["replicas"]) != original[key]["rf"]:
            errors.append(f"Partition {key}: RF changed from {original[key]['rf']} to {len(final[key]['replicas'])}")
            rf_ok = False
    if rf_ok:
        checks_passed += 1

    # Check rack awareness
    checks_total += 1
    rack_ok = True
    rack_violations = 0
    for key, val in final.items():
        rf = val["rf"]
        racks_used = {broker_rack[bid] for bid in val["replicas"]}
        ideal = min(rf, num_racks)
        if len(racks_used) < ideal:
            errors.append(f"Partition {key}: uses {len(racks_used)} racks, needs {ideal}. Replicas: {val['replicas']}")
            rack_ok = False
            rack_violations += 1
    if rack_ok:
        checks_passed += 1

    # Check replica balance
    checks_total += 1
    replica_counts = {bid: 0 for bid in broker_ids}
    for val in final.values():
        for bid in val["replicas"]:
            replica_counts[bid] += 1
    max_rep = max(replica_counts.values())
    min_rep = min(replica_counts.values())
    rep_imbalance = max_rep - min_rep
    if rep_imbalance <= constraints["max_replica_imbalance"]:
        checks_passed += 1
    else:
        errors.append(f"Replica imbalance {rep_imbalance} exceeds max {constraints['max_replica_imbalance']}. Counts: {replica_counts}")

    # Check leader balance
    checks_total += 1
    leader_counts = {bid: 0 for bid in broker_ids}
    for val in final.values():
        leader_counts[val["leader"]] += 1
    max_lead = max(leader_counts.values())
    min_lead = min(leader_counts.values())
    lead_imbalance = max_lead - min_lead
    if lead_imbalance <= constraints["max_leader_imbalance"]:
        checks_passed += 1
    else:
        errors.append(f"Leader imbalance {lead_imbalance} exceeds max {constraints['max_leader_imbalance']}. Counts: {leader_counts}")

    # Check disk capacity
    checks_total += 1
    disk_usage = defaultdict(float)
    for val in final.values():
        for bid in val["replicas"]:
            disk_usage[bid] += val["size_gb"]
    disk_ok = True
    for bid in broker_ids:
        if disk_usage[bid] > broker_capacity[bid]:
            errors.append(f"Broker {bid}: disk usage {disk_usage[bid]:.1f}GB exceeds capacity {broker_capacity[bid]}GB")
            disk_ok = False
    if disk_ok:
        checks_passed += 1

    # Compute movement stats
    total_moves = 0
    total_data_moved = 0.0
    for key in final:
        old_set = set(original[key]["replicas"])
        new_set = set(final[key]["replicas"])
        added = new_set - old_set
        total_moves += len(added)
        total_data_moved += len(added) * original[key]["size_gb"]

    valid = len(errors) == 0

    report = {
        "valid": valid,
        "checks_passed": checks_passed,
        "checks_total": checks_total,
        "errors": errors,
        "warnings": warnings,
        "summary": {
            "partitions_reassigned": len(seen_partitions),
            "total_replica_moves": total_moves,
            "total_data_moved_gb": total_data_moved,
            "num_batches": len(plan.get("batches", [])),
            "rack_violations_remaining": rack_violations,
            "replica_imbalance": rep_imbalance,
            "leader_imbalance": lead_imbalance,
            "replica_counts": {str(k): v for k, v in replica_counts.items()},
            "leader_counts": {str(k): v for k, v in leader_counts.items()},
            "disk_usage_gb": {str(k): round(v, 2) for k, v in disk_usage.items()},
        },
    }

    with open(output_path, "w") as f:
        json.dump(report, f, indent=2)

    if valid:
        print(f"VALIDATION PASSED: {checks_passed}/{checks_total} checks passed")
        print(f"  Partitions reassigned: {len(seen_partitions)}")
        print(f"  Total replica moves:   {total_moves}")
        print(f"  Total data moved:      {total_data_moved:.1f} GB")
        print(f"  Rack violations:       {rack_violations}")
        print(f"  Replica imbalance:     {rep_imbalance}")
        print(f"  Leader imbalance:      {lead_imbalance}")
    else:
        print(f"VALIDATION FAILED: {checks_passed}/{checks_total} checks passed, {len(errors)} error(s)")
        for e in errors:
            print(f"  ERROR: {e}")
        if warnings:
            for w in warnings:
                print(f"  WARN:  {w}")
        sys.exit(1)

    print(f"\nValidation report written to: {output_path}")


def cmd_diff(args):
    """Show the diff between current assignments and a proposed plan."""
    plan_path = args.plan_file

    if not os.path.exists(plan_path):
        print(f"ERROR: Plan file not found: {plan_path}", file=sys.stderr)
        sys.exit(1)

    with open(plan_path) as f:
        plan = json.load(f)

    state = build_cluster_state()
    broker_rack = {b["id"]: b["rack"] for b in state["brokers"]}

    original = {}
    for topic in state["topics"]:
        rf = topic["replication_factor"]
        for part in topic["partitions"]:
            key = (topic["name"], part["partition"])
            original[key] = {
                "replicas": list(part["replicas"]),
                "size_gb": part["size_gb"],
                "rf": rf,
            }

    print(f"{'Partition':<30}  {'Current Replicas':<20}  {'New Replicas':<20}  {'Data (GB)':>10}  {'Moves':>6}")
    print("-" * 95)

    for batch in plan.get("batches", []):
        for entry in batch.get("partitions", []):
            key = (entry["topic"], entry["partition"])
            orig = original.get(key, {})
            old_r = orig.get("replicas", [])
            new_r = entry["replicas"]
            size = orig.get("size_gb", 0)
            added = set(new_r) - set(old_r)

            old_str = ",".join(f"{r}({broker_rack.get(r,'?')})" for r in old_r)
            new_str = ",".join(f"{r}({broker_rack.get(r,'?')})" for r in new_r)
            print(f"  {entry['topic']}-{entry['partition']:<25}  {old_str:<20}  {new_str:<20}  {size:>10.0f}  {len(added):>6}")


def main():
    parser = argparse.ArgumentParser(
        prog="kafkactl",
        description="Kafka Cluster Administration Tool for kafka-prod-east-1",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  kafkactl inspect                                    Show cluster state summary
  kafkactl validate reassignment_plan.json            Validate a reassignment plan
  kafkactl validate plan.json -o /app/report.json     Validate and write report to custom path
  kafkactl diff reassignment_plan.json                Show assignment changes in a plan

Metadata directory: /app/metadata/
  broker_configs/server-*.properties  Broker topology and rack assignments
  topic_descriptions.txt              Topic/partition/replica assignments
  log_dirs.json                       Partition sizes (kafka-log-dirs format)
  disk_quotas.csv                     Broker disk capacity quotas
  constraints.yaml                    Operational constraints for rebalancing
"""
    )

    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # inspect command
    subparsers.add_parser("inspect", help="Show current cluster state summary")

    # validate command
    val_parser = subparsers.add_parser("validate", help="Validate a reassignment plan")
    val_parser.add_argument("plan_file", help="Path to the reassignment plan JSON file")
    val_parser.add_argument("-o", "--output", help="Output path for validation report (default: /app/validation_report.json)")

    # diff command
    diff_parser = subparsers.add_parser("diff", help="Show assignment diffs for a plan")
    diff_parser.add_argument("plan_file", help="Path to the reassignment plan JSON file")

    args = parser.parse_args()

    if args.command == "inspect":
        cmd_inspect(args)
    elif args.command == "validate":
        cmd_validate(args)
    elif args.command == "diff":
        cmd_diff(args)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
