# 3D Laser-Plasma Acceleration - High density regime
# Strong laser, dense plasma configuration

my_constants.plasma_density = 7.0e24
my_constants.laser_wl = 0.8e-6
my_constants.field_amplitude = 32.e12
my_constants.beam_waist = 10.e-6
my_constants.pulse_duration = 20.e-15
# Auxiliary constants for diagnostic scripts (not used in simulation)
my_constants.boost_gamma = 15.0
my_constants.injection_threshold = 0.5

max_step = 10000
amr.n_cell = 128 128 960
amr.max_grid_size = 128
amr.blocking_factor = 64
geometry.dims = 3
geometry.prob_lo = -24.e-6 -24.e-6 -56.e-6
geometry.prob_hi =  24.e-6  24.e-6  12.e-6
amr.max_level = 0

boundary.field_lo = periodic periodic pec
boundary.field_hi = periodic periodic pec

warpx.verbose = 1
warpx.do_dive_cleaning = 0
warpx.use_filter = 1
warpx.cfl = 0.999
warpx.do_moving_window = 1
warpx.moving_window_dir = z
warpx.moving_window_v = 1.0
warpx.do_dynamic_scheduling = 1
algo.particle_shape = 3
algo.maxwell_solver = yee

particles.species_names = electrons ions

electrons.charge = -q_e
electrons.mass = m_e
electrons.injection_style = "NUniformPerCell"
electrons.num_particles_per_cell_each_dim = 2 2 2
electrons.xmin = -20.e-6
electrons.xmax = 20.e-6
electrons.ymin = -20.e-6
electrons.ymax = 20.e-6
electrons.zmin = 0
electrons.profile = constant
electrons.density = plasma_density
electrons.momentum_distribution_type = "at_rest"
electrons.do_continuous_injection = 1

ions.charge = q_e
ions.mass = 1836.15267*m_e
ions.injection_style = "NUniformPerCell"
ions.num_particles_per_cell_each_dim = 1 1 1
ions.xmin = -20.e-6
ions.xmax = 20.e-6
ions.ymin = -20.e-6
ions.ymax = 20.e-6
ions.zmin = 0
ions.profile = constant
ions.density = plasma_density
ions.momentum_distribution_type = "at_rest"
ions.do_continuous_injection = 1

lasers.names = laser1
laser1.profile = Gaussian
laser1.position = 0. 0. 9.e-6
laser1.direction = 0. 0. 1.
laser1.polarization = 0. 1. 0.
laser1.e_max = field_amplitude
laser1.profile_waist = beam_waist
laser1.profile_duration = pulse_duration
laser1.profile_t_peak = 40.e-15
laser1.profile_focal_distance = 50.e-6
laser1.wavelength = laser_wl

diagnostics.diags_names = diag1
diag1.intervals = 1000
diag1.diag_type = Full
diag1.fields_to_plot = Ex Ey Ez Bx By Bz jx jy jz rho
