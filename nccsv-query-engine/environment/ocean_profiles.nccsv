longitude,*DATA_TYPE*,double
longitude,long_name,"Longitude"
longitude,standard_name,"longitude"
longitude,units,"degrees_east"
profile_id,*DATA_TYPE*,String
profile_id,long_name,"Profile Identifier"
profile_id,cf_role,"profile_id"
time,*DATA_TYPE*,String
time,long_name,"Time"
time,standard_name,"time"
time,units,"ISO 8601"
pressure,*DATA_TYPE*,float
pressure,long_name,"Sea Water Pressure"
pressure,standard_name,"sea_water_pressure"
pressure,units,"dbar"
temperature,*DATA_TYPE*,float
temperature,long_name,"Sea Water Temperature"
temperature,standard_name,"sea_water_temperature"
temperature,units,"degree_C"
salinity,*DATA_TYPE*,float
salinity,long_name,"Sea Water Practical Salinity"
salinity,standard_name,"sea_water_practical_salinity"
salinity,units,"PSU"
*END_METADATA*
