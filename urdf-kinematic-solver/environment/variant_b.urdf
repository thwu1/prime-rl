<?xml version="1.0" encoding="utf-8"?>
<robot name="wr6_longreach">

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.18 0.18 0.12"/></geometry>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><box size="0.18 0.18 0.12"/></geometry>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.015"/>
    </inertial>
  </link>

  <!-- Shoulder Pan Link -->
  <link name="shoulder_pan_link">
    <visual>
      <geometry><cylinder radius="0.065" length="0.06"/></geometry>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.065" length="0.06"/></geometry>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/>
    </inertial>
  </link>

  <joint name="shoulder_pan" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_pan_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159265" upper="3.14159265" effort="120.0" velocity="1.5"/>
  </joint>

  <!-- Shoulder Lift Link -->
  <link name="shoulder_lift_link">
    <visual>
      <geometry><box size="0.08 0.08 0.55"/></geometry>
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><box size="0.08 0.08 0.55"/></geometry>
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="4.0"/>
      <origin xyz="0 0 0.275" rpy="0 0 0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.008"/>
    </inertial>
  </link>

  <joint name="shoulder_lift" type="revolute">
    <parent link="shoulder_pan_link"/>
    <child link="shoulder_lift_link"/>
    <origin xyz="0 0 0.06" rpy="0 1.5707963268 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159265" upper="3.14159265" effort="200.0" velocity="1.0"/>
  </joint>

  <!-- Elbow Link -->
  <link name="elbow_link">
    <visual>
      <geometry><box size="0.07 0.07 0.45"/></geometry>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><box size="0.07 0.07 0.45"/></geometry>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="2.5"/>
      <origin xyz="0 0 0.225" rpy="0 0 0"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.004"/>
    </inertial>
  </link>

  <joint name="elbow" type="revolute">
    <parent link="shoulder_lift_link"/>
    <child link="elbow_link"/>
    <origin xyz="0 0 0.55" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159265" upper="0" effort="120.0" velocity="1.5"/>
  </joint>

  <!-- Wrist 1 Link -->
  <link name="wrist_1_link">
    <visual>
      <geometry><cylinder radius="0.045" length="0.06"/></geometry>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.045" length="0.06"/></geometry>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0015"/>
    </inertial>
  </link>

  <joint name="wrist_1" type="revolute">
    <parent link="elbow_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0 0 0.45" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5707963268" upper="1.5707963268" effort="60.0" velocity="2.0"/>
  </joint>

  <!-- Wrist 2 Link -->
  <link name="wrist_2_link">
    <visual>
      <geometry><cylinder radius="0.045" length="0.06"/></geometry>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.045" length="0.06"/></geometry>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0015"/>
    </inertial>
  </link>

  <joint name="wrist_2" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159265" upper="3.14159265" effort="60.0" velocity="2.0"/>
  </joint>

  <!-- Wrist 3 Link -->
  <link name="wrist_3_link">
    <visual>
      <geometry><cylinder radius="0.045" length="0.06"/></geometry>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.045" length="0.06"/></geometry>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0008"/>
    </inertial>
  </link>

  <joint name="wrist_3" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5707963268" upper="1.5707963268" effort="60.0" velocity="2.0"/>
  </joint>

  <!-- Tool0 (end-effector frame) -->
  <link name="tool0">
    <visual>
      <geometry><box size="0.02 0.08 0.02"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.02 0.08 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="tool_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- Camera Link -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.03 0.03 0.02"/></geometry>
    </visual>
    <collision>
      <geometry><box size="0.03 0.03 0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="wrist_1_link"/>
    <child link="camera_link"/>
    <origin xyz="0.06 0 0.03" rpy="0 -1.5707963268 0"/>
  </joint>

</robot>
