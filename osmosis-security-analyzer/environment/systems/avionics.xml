<?xml version="1.0" encoding="UTF-8"?>
<!--
  Avionics mixed-criticality system inspired by INSPECTA/PROVERS seL4 Summit 2025 talks.
  Two isolated clusters: {critical_ctrl, sensor_drv, logger} and {network, crypto}.
-->
<system>
    <memory_region name="sensor_buf" size="0x10000" />
    <memory_region name="ctrl_out" size="0x10000" />
    <memory_region name="net_buf" size="0x10000" />
    <memory_region name="crypto_buf" size="0x10000" />
    <memory_region name="log_archive" size="0x20000" />

    <protection_domain name="critical_ctrl" priority="254">
        <program_image path="critical_ctrl.elf" />
        <map mr="sensor_buf" vaddr="0x10000000" perms="r" />
        <map mr="ctrl_out" vaddr="0x10010000" perms="rw" />
    </protection_domain>

    <protection_domain name="sensor_drv" priority="200">
        <program_image path="sensor_drv.elf" />
        <map mr="sensor_buf" vaddr="0x10000000" perms="rw" />
        <irq irq="33" id="1" />
    </protection_domain>

    <protection_domain name="logger" priority="50">
        <program_image path="logger.elf" />
        <map mr="ctrl_out" vaddr="0x10010000" perms="r" />
        <map mr="log_archive" vaddr="0x10020000" perms="rw" />
    </protection_domain>

    <protection_domain name="network" priority="100">
        <program_image path="network.elf" />
        <map mr="net_buf" vaddr="0x10000000" perms="rw" />
        <map mr="crypto_buf" vaddr="0x10010000" perms="r" />
        <irq irq="44" id="2" />
    </protection_domain>

    <protection_domain name="crypto" priority="180">
        <program_image path="crypto.elf" />
        <map mr="net_buf" vaddr="0x10000000" perms="r" />
        <map mr="crypto_buf" vaddr="0x10010000" perms="rw" />
    </protection_domain>

    <channel>
        <end pd="sensor_drv" id="1" />
        <end pd="critical_ctrl" id="1" />
    </channel>

    <channel>
        <end pd="network" id="3" />
        <end pd="crypto" id="3" />
    </channel>
</system>
