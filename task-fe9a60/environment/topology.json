{
  "description": "Multi-VRF BGP L3VPN route-leaking topology with 3 FRR routers. Each router uses BGP VPN semantics (RT/RD) for inter-VRF route leaking on the same router.",
  "routers": {
    "R1": {
      "as_number": 65001,
      "router_id": "10.1.1.1",
      "interfaces": {
        "lo": {"address": "10.1.1.1/32"},
        "eth0": {"address": "10.0.12.1/30", "description": "link to R2"},
        "eth1": {"address": "10.100.1.1/24", "vrf": "CUST"},
        "eth2": {"address": "10.200.1.1/24", "vrf": "MGMT"}
      },
      "vrfs": {
        "CUST": {
          "description": "Customer VRF - receives management routes for monitoring",
          "rd": "65001:100",
          "rt_export": ["65001:100"],
          "rt_import": ["65001:100", "65001:200"]
        },
        "MGMT": {
          "description": "Management VRF - exports management network routes to CUST",
          "rd": "65001:200",
          "rt_export": ["65001:200"],
          "rt_import": ["65001:200"]
        }
      }
    },
    "R2": {
      "as_number": 65001,
      "router_id": "10.1.1.2",
      "interfaces": {
        "lo": {"address": "10.1.1.2/32"},
        "eth0": {"address": "10.0.12.2/30", "description": "link to R1"},
        "eth1": {"address": "10.0.23.1/30", "description": "link to R3"},
        "eth2": {"address": "10.100.2.1/24", "vrf": "CUST"},
        "eth3": {"address": "10.200.2.1/24", "vrf": "INTERNAL"}
      },
      "vrfs": {
        "CUST": {
          "description": "Customer VRF",
          "rd": "65001:100",
          "rt_export": ["65001:100"],
          "rt_import": ["65001:100"]
        },
        "INTERNAL": {
          "description": "Internal services - receives customer routes for service delivery",
          "rd": "65001:250",
          "rt_export": ["65001:250"],
          "rt_import": ["65001:100"]
        }
      }
    },
    "R3": {
      "as_number": 65001,
      "router_id": "10.1.1.3",
      "interfaces": {
        "lo": {"address": "10.1.1.3/32"},
        "eth0": {"address": "10.0.23.2/30", "description": "link to R2"},
        "eth1": {"address": "10.100.3.1/24", "vrf": "SERVICES"},
        "eth2": {"address": "10.200.3.1/24", "vrf": "PROD"}
      },
      "vrfs": {
        "SERVICES": {
          "description": "Shared services VRF - provides DNS, NTP, monitoring",
          "rd": "65001:300",
          "rt_export": ["65001:300"],
          "rt_import": ["65001:300"]
        },
        "PROD": {
          "description": "Production workloads - receives shared service routes",
          "rd": "65001:400",
          "rt_export": ["65001:400"],
          "rt_import": ["65001:300"]
        }
      }
    }
  },
  "links": [
    {"endpoints": ["R1:eth0", "R2:eth0"], "subnet": "10.0.12.0/30"},
    {"endpoints": ["R2:eth1", "R3:eth0"], "subnet": "10.0.23.0/30"}
  ],
  "bgp_peerings": [
    {"router1": "R1", "router2": "R2", "type": "iBGP"},
    {"router2": "R2", "router3": "R3", "type": "iBGP"}
  ]
}
