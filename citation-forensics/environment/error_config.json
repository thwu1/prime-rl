{
  "pipeline": {
    "version": "2.1.0",
    "error_detection": {
      "methodology": "structural_decomposition",
      "decomposition_target": "volume_reporter_page",
      "severity_model": {
        "name": "citation_component_severity",
        "version": "1.0",
        "weights": {
          "citation_errors": {
            "volume": {
              "weight": 3.0,
              "description": "Wrong volume number indicates reference to an entirely different case",
              "impact_category": "critical",
              "precedent_risk": "high"
            },
            "reporter": {
              "weight": 2.0,
              "description": "Wrong reporter series indicates different publication venue",
              "impact_category": "major",
              "precedent_risk": "medium"
            },
            "page": {
              "weight": 1.0,
              "description": "Wrong page number — correct case vicinity but imprecise pinpoint",
              "impact_category": "minor",
              "precedent_risk": "low"
            }
          },
          "non_citation_errors": {
            "party_name": {
              "weight": 0.5,
              "description": "Misspelled party name in case caption"
            },
            "year": {
              "weight": 0.25,
              "description": "Wrong decision year in parenthetical"
            },
            "court_designation": {
              "weight": 0.3,
              "description": "Incorrect court abbreviation"
            }
          }
        }
      },
      "evaluation_pairs": {
        "format": "3-choice",
        "description": "Each pair presents a cited and canonical citation form. Style '3-fake' indicates the cited form contains an intentional perturbation; '3-true' indicates authentic citation.",
