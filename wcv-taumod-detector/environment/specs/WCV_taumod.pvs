% ============================================================
% WCV: 3D Well-Clear Volume (combines horizontal and vertical)
% From NASA DAIDALUS PVS Formal Specification
% ============================================================
%
% Parameters: TAUMOD, TCOA (nnreal), DTHR, ZTHR (posreal)
%
% Uses Vect3 = (x, y, z) where:
%   vect2(v) = (v`x, v`y)   -- horizontal projection
%   v`z                      -- vertical component
%
% --- WCV definition ---
%
% WCV(tvar)(s, v): bool =
%   horizontal_WCV(tvar)(vect2(s), vect2(v)) AND vertical_WCV(s`z, v`z)
%
% For WCV_taumod:
%   WCV_taumod(s, v) = WCV(taumod)(s, v)
%
% This means: well-clear is violated iff BOTH horizontal AND vertical
% conditions are simultaneously met.
%
% --- WCV_interval (3D) ---
%
% WCV_interval(tvar, hi)(B, T, s, v): EntryExit[B, T] =
%   LET ventryexit = vertical_WCV_interval(B, T, s`z, v`z),
%       (ventry, vexit) = (ventryexit`entry, ventryexit`exit)
%   IN
%   IF ventry > vexit THEN
%     EmptyInterval[B,T]                    % no vertical violation
%   ELSIF ventry = vexit AND horizontal_WCV(tvar)(vect2(s)+ventry*vect2(v), vect2(v)) THEN
%     (# entry := ventry, exit := ventry #) % single-point violation
%   ELSIF ventry = vexit THEN
%     EmptyInterval[B,T]                    % single point, no horizontal
%   ELSE
%     LET hni = hi(vexit - ventry, vect2(s) + ventry * vect2(v), vect2(v))
%     IN (# entry := hni`entry + ventry,
%          exit  := hni`exit  + ventry #)
%   ENDIF
%
% CRITICAL ALGORITHM:
% 1. First compute the vertical violation interval [ventry, vexit]
% 2. If vertical interval is empty: no 3D violation possible
% 3. Otherwise: TIME-SHIFT the horizontal computation into the vertical window
%    - Shift origin to ventry: compute horizontal interval for
%      the state at time ventry, over duration (vexit - ventry)
%    - The horizontal state at ventry is: s_h + ventry * v_h
%    - Then shift the result back by adding ventry to entry/exit
%
% This time-shifting is essential for correctness when the vertical
% interval does not start at B. It ensures the horizontal interval
% is computed only within the time window where vertical violation holds.
%
% --- WCV_taumod_interval ---
%
% WCV_taumod_interval(B, T, s, v) =
%   WCV_interval(taumod, horizontal_WCV_taumod_interval)(B, T, s, v)
%
% --- Key Properties (proven in PVS) ---
%
% WCV_taumod_symmetric: WCV_taumod(s,v) = WCV_taumod(-s,-v)
% WCV_taumod_local_convexity: The violation region is a single
%   contiguous interval in time (no gaps).
% WCV_taumod_interval_correct: For all t in [B,T]:
%   WCV_taumod(s+t*v, v) IFF (tentry <= t AND t <= texit)
