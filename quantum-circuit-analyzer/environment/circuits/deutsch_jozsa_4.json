    {"gate": "CNOT", "targets": [0, 3]},
    {"gate": "CNOT", "targets": [1, 3]},
    {"gate": "CNOT", "targets": [2, 3]},
    {"gate": "H", "targets": [0]},
    {"gate": "H", "targets": [1]},
    {"gate": "H", "targets": [2]}
  ]
}
