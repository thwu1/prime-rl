        "T2_T1": "static temperature ratio",
        "rho2_rho1": "density ratio",
        "Pt2_Pt1": "total pressure ratio"
      },
      "strong_shock": {
        "beta_deg": "shock wave angle [degrees]",
        "M2": "downstream Mach number",
