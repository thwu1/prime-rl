                "dst_ip": "8.8.8.8",
                "dst_port": 443,
                "ct_state": "new",
                "iifname": "eth1",
                "oifname": "eth0",
                "expected_verdict": "accept"
            },
            {
                "id": "rtr_6",
                "description": "Forward WAN to LAN port 80",
