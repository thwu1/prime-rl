            {
                "id": "rtr_7",
                "description": "Forward WAN to LAN port 3306 blocked",
                "hook": "forward",
                "protocol": "tcp",
                "src_ip": "1.2.3.4",
                "dst_ip": "192.168.1.100",
                "dst_port": 3306,
                "ct_state": "new",
                "iifname": "eth0",
                "oifname": "eth1",
                "expected_verdict": "drop"
            },
            {
                "id": "rtr_8",
                "description": "ICMP from WAN",
                "hook": "input",
                "protocol": "icmp",
                "src_ip": "1.2.3.4",
                "ct_state": "new",
