                "hook": "input",
                "protocol": "tcp",
                "src_ip": "10.1.2.3",
                "dst_port": 22,
                "ct_state": "new",
                "iifname": "eth0",
                "expected_verdict": "accept"
            },
            {
                "id": "srv_3",
