        "router": [
            {
                "id": "rtr_1",
                "description": "SSH from WAN",
                "hook": "input",
                "protocol": "tcp",
                "src_ip": "1.2.3.4",
                "dst_port": 22,
                "ct_state": "new",
                "iifname": "eth0",
                "expected_verdict": "accept"
            },
            {
                "id": "rtr_2",
                "description": "HTTP from WAN to router blocked",
                "hook": "input",
                "protocol": "tcp",
                "src_ip": "1.2.3.4",
                "dst_port": 80,
                "ct_state": "new",
                "iifname": "eth0",
                "expected_verdict": "drop"
            },
            {
                "id": "rtr_3",
                "description": "HTTP from LAN",
                "hook": "input",
                "protocol": "tcp",
                "src_ip": "192.168.1.50",
                "dst_port": 80,
                "ct_state": "new",
                "iifname": "eth1",
                "expected_verdict": "accept"
            },
            {
                "id": "rtr_4",
                "description": "DHCP from LAN",
                "hook": "input",
                "protocol": "udp",
                "src_ip": "192.168.1.50",
                "dst_port": 67,
                "ct_state": "new",
                "iifname": "eth1",
                "expected_verdict": "accept"
            },
            {
                "id": "rtr_5",
                "description": "Forward LAN to WAN",
                "hook": "forward",
