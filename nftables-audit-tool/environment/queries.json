{
    "structural_analysis": {
        "tables": true,
        "base_chains": true,
        "named_sets": true,
        "jump_graph": true
    },
    "security_analysis": {
        "open_tcp_ports": true,
        "open_udp_ports": true,
        "allows_loopback": true,
        "allows_icmp": true,
        "has_rate_limiting": true,
        "rate_limited_ports": true,
        "has_nat": true,
        "has_masquerade": true,
        "uses_connection_tracking": true
    },
    "packet_tests": {
        "workstation": [
            {
                "id": "ws_1",
                "description": "External SSH access",
                "hook": "input",
                "protocol": "tcp",
                "src_ip": "8.8.8.8",
                "dst_port": 22,
                "ct_state": "new",
                "iifname": "eth0",
                "expected_verdict": "accept"
            },
            {
                "id": "ws_2",
                "description": "External HTTP access blocked",
                "hook": "input",
                "protocol": "tcp",
                "src_ip": "8.8.8.8",
                "dst_port": 80,
                "ct_state": "new",
                "iifname": "eth0",
                "expected_verdict": "drop"
            },
            {
                "id": "ws_3",
                "description": "LAN Samba access",
                "hook": "input",
                "protocol": "tcp",
                "src_ip": "192.168.1.50",
                "dst_port": 445,
                "ct_state": "new",
                "iifname": "eth0",
                "expected_verdict": "accept"
            },
            {
                "id": "ws_4",
                "description": "External Samba access blocked",
                "hook": "input",
                "protocol": "tcp",
                "src_ip": "8.8.8.8",
                "dst_port": 445,
                "ct_state": "new",
                "iifname": "eth0",
                "expected_verdict": "drop"
            },
            {
                "id": "ws_5",
                "description": "LAN mDNS access",
                "hook": "input",
                "protocol": "udp",
                "src_ip": "10.1.2.3",
                "dst_port": 5353,
                "ct_state": "new",
                "iifname": "eth0",
                "expected_verdict": "accept"
            },
            {
                "id": "ws_6",
                "description": "ICMP from external",
                "hook": "input",
                "protocol": "icmp",
                "src_ip": "1.2.3.4",
                "ct_state": "new",
                "iifname": "eth0",
                "expected_verdict": "accept"
            },
            {
                "id": "ws_7",
                "description": "Established TCP connection",
                "hook": "input",
                "protocol": "tcp",
                "src_ip": "8.8.8.8",
                "dst_port": 443,
                "ct_state": "established",
                "iifname": "eth0",
                "expected_verdict": "accept"
            }
        ],
        "server": [
