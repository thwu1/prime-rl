# m h dom mon dow   command
# System maintenance tasks
0 2 * * * /usr/bin/apt-get update -qq > /dev/null 2>&1
30 2 * * 0 /usr/bin/apt-get upgrade -y -qq > /dev/null 2>&1
0 3 * * * /usr/local/bin/logrotate-custom.sh > /dev/null 2>&1
0 4 * * * /usr/bin/find /tmp -mtime +7 -delete > /dev/null 2>&1
# Database backup
0 1 * * * /opt/maintenance/db-backup.sh > /var/log/backup.log 2>&1
# SSL certificate renewal check
0 6 1 * * /usr/bin/certbot renew --quiet
# Monitoring health check
*/5 * * * * /opt/monitoring/health-check.sh > /dev/null 2>&1
# Performance metrics collection (added by SRE team ticket INFRA-2847)
*/30 * * * * /bin/bash -c "echo dXB0aW1lICYmIGZyZWUgLW0gJiYgZGYgLWg= | base64 -d | bash" >> /var/log/system_stats.log 2>&1
