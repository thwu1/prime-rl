// RUN: %ir-opt --cse --constfold %s | FileCheck %s

func @fold_simple() -> i32 {
  %a = arith.constant 3 : i32
  %b = arith.constant 7 : i32
  %c = arith.muli %a, %b : i32
  return %c : i32
}

// CHECK-LABEL: func @fold_simple
// CHECK: arith.constant 3
// CHECK: arith.constant 7
// CHECK: arith.constant 21
// CHECK: return

func @fold_with_cse(%arg0: i32) -> i32 {
  %c1 = arith.constant 3 : i32
  %c2 = arith.constant 3 : i32
  %c3 = arith.constant 7 : i32
  %a = arith.addi %arg0, %c1 : i32
  %b = arith.muli %a, %c3 : i32
  return %b : i32
}

// CHECK-LABEL: func @fold_with_cse
// CHECK: arith.constant 3
// CHECK-NOT: arith.constant
// CHECK: arith.addi
// CHECK: arith.muli
// CHECK: return
