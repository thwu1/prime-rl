// RUN: %ir-opt --cse %s | FileCheck %s

func @func_alpha(%arg0: i32, %arg1: i32) -> i32 {
  %x = arith.addi %arg0, %arg1 : i32
  %y = arith.addi %arg0, %arg1 : i32
  %z = arith.muli %x, %y : i32
  return %z : i32
}

func @func_beta(%arg0: i32) -> i32 {
  %c1 = arith.constant 5 : i32
  %c2 = arith.constant 5 : i32
  %r = arith.addi %arg0, %c1 : i32
  return %r : i32
}

// CHECK-LABEL: func @func_alpha
// CHECK: [[V:%.+]] = arith.addi
// CHECK-NOT: arith.addi
// CHECK: arith.muli [[V]], [[V]]

// CHECK-LABEL: func @func_beta
// CHECK: [[C:%.+]] = arith.constant
// CHECK-NOT: arith.constant
// CHECK: arith.addi [[V]], [[C]]
// CHECK: return
