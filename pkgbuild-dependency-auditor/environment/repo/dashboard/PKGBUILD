# Maintainer: Package Maintainer <maintainer@example.com>

pkgname=dashboard
pkgver=3.1.0
pkgrel=1
pkgdesc="Monitoring dashboard UI"
arch=('x86_64')
url="https://example.com/dashboard"
license=('MIT')
depends=('frontend' 'analytics' 'webstack')
makedepends=('npm')
source=("https://example.com/releases/${pkgname}-${pkgver}.tar.gz")
sha256sums=('c3c4c5c6c1c2c3c4c5c6c1c2c3c4c5c6c1c2c3c4c5c6c1c2c3c4c5c6c1c2c3c4')

build() {
    cd "${pkgname}-${pkgver}"
    npm run build
}

package() {
    cd "${pkgname}-${pkgver}"
    install -d "${pkgdir}/usr/share/${pkgname}"
    cp -r build/* "${pkgdir}/usr/share/${pkgname}/"
}
