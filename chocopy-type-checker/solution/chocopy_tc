#!/usr/bin/env python3
"""
ChocoPy type checker CLI tool.

"""
import argparse
import json
import sys

from typechecker import type_check


def main():
    parser = argparse.ArgumentParser(description="ChocoPy type checker")
    parser.add_argument("source", help="Path to ChocoPy source file")
    parser.add_argument("--pretty", action="store_true",
                        help="Pretty-print JSON output with indentation")
    args = parser.parse_args()

    with open(args.source) as f:
        source = f.read()

    result = type_check(source)

    if args.pretty:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(json.dumps(result, sort_keys=True))

    sys.exit(0 if result["well_typed"] else 1)


if __name__ == "__main__":
    main()
