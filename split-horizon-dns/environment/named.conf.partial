options {
    directory "/var/cache/bind";

    // TODO: Configure listening address and port (must use port 8053)
    // TODO: Configure recursion policy
    // TODO: Configure query access control
    // TODO: Disable DNSSEC validation for this lab environment
    dnssec-validation no;

    auth-nxdomain no;
};

