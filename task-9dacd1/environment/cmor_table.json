      "must_have_bounds": true,
      "stored_direction": "increasing"
    },
    "latitude": {
      "var_name": "lat",
      "standard_name": "latitude",
      "long_name": "latitude",
      "units": "degrees_north",
      "range": [-90.0, 90.0],
      "must_have_bounds": true,
      "stored_direction": "increasing"
    },
    "time": {
      "var_name": "time",
      "standard_name": "time",
      "long_name": "time",
      "units": "days since 1950-1-1 00:00:00",
