       IDENTIFICATION DIVISION.
       PROGRAM-ID. GENDATA.

       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT ACCT-FILE ASSIGN TO "accounts.dat"
               ORGANIZATION IS SEQUENTIAL.
           SELECT TXN-FILE  ASSIGN TO "txns.dat"
               ORGANIZATION IS SEQUENTIAL.

       DATA DIVISION.
       FILE SECTION.
       FD  ACCT-FILE RECORD CONTAINS 66 CHARACTERS.
       01  ACCT-REC.
           COPY "ACCOUNT-REC.cpy".

       FD  TXN-FILE  RECORD CONTAINS 80 CHARACTERS.
       01  TXN-REC.
           COPY "TXN-REC.cpy".

       WORKING-STORAGE SECTION.
       77  WS-SCENARIO  PIC X  VALUE "1".

       PROCEDURE DIVISION.
       MAIN.
           ACCEPT WS-SCENARIO FROM ENVIRONMENT "SCENARIO"
           IF WS-SCENARIO = SPACES
              MOVE "1" TO WS-SCENARIO
           END-IF
           OPEN OUTPUT ACCT-FILE TXN-FILE
           EVALUATE WS-SCENARIO
              WHEN "1" PERFORM GEN-SCENARIO-1
              WHEN "2" PERFORM GEN-SCENARIO-2
              WHEN "3" PERFORM GEN-SCENARIO-3
           END-EVALUATE
           CLOSE ACCT-FILE TXN-FILE
           GOBACK.

