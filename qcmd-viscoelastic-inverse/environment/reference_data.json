    },
    {
      "id": "viscoelastic_film_liquid_n5",
      "description": "Viscoelastic film on semi-infinite liquid, 5th harmonic",
      "n": 5,
      "layers": {
        "1": {"grho3": 1e9, "phi": 30.0, "drho": 5e-4},
        "2": {"grho3": 9.4e7, "phi": 90.0, "drho": "inf"}
      },
      "expected_delf": 373.472,
      "expected_delgamma": 6010.856,
      "tolerance_hz": 0.5
