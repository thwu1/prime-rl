      "expected_delf": -1696.883,
      "tolerance_hz": 0.1
    },
    {
      "id": "rigid_film_n5",
      "description": "Thin rigid film, 5th harmonic",
      "n": 5,
      "layers": {"1": {"grho3": 1e12, "phi": 0.01, "drho": 1e-4}},
      "expected_delf": -2828.287,
      "tolerance_hz": 0.1
    },
    {
      "id": "newtonian_liquid_n3",
      "description": "Semi-infinite Newtonian liquid (phi=90), 3rd harmonic. For a Newtonian fluid, delf = -delgamma.",
      "n": 3,
      "layers": {"1": {"grho3": 9.4e7, "phi": 90.0, "drho": "inf"}},
      "expected_delf": -1234.289,
      "expected_delgamma": 1234.289,
      "tolerance_hz": 0.1
    },
    {
      "id": "viscoelastic_film_liquid_n3",
