CC = gcc
CFLAGS = -O2 -Wall -Wextra -std=c99
TARGET = fdtd3d
SOURCES = main.c reference.c solver.c analyze.c
OBJECTS = $(SOURCES:.c=.o)

$(TARGET): $(OBJECTS)
	$(CC) $(OBJECTS) -o $@ -lm

%.o: %.c fdtd3d.h
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJECTS) $(TARGET) output_naive.bin output_tiled.bin results.json

.PHONY: clean
