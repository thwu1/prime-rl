# Maintainer: Leo Sched <leo@example.org>
pkgname=scheduler
pkgver=3.1.0
pkgrel=2
_dashver=${pkgver//./-}
pkgdesc="Task scheduling and job orchestration service"
arch=('x86_64')
url="https://github.com/example/scheduler"
license=('Apache-2.0')
depends=('auth-svc' 'log-api>=1.0')
makedepends=('rust' 'cargo')
provides=('cron-backend=3.1.0')
source=("https://github.com/example/${pkgname}/releases/download/v${_dashver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('f1a2b3c4d5e60000000000000000000000000000000000000000000000000000')

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  cargo build --release
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 "target/release/scheduler" "${pkgdir}/usr/bin/scheduler"
}
