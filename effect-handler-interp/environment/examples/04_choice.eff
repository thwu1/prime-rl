// Choice effect: nondeterminism (multi-shot continuations)
effect Choice {
    Choose()
}

val results = handle {
    val x = do Choose();
    val y = do Choose();
    if x then (if y then 1 else 2) else (if y then 3 else 4)
} with Choice {
    return(x) => x ++ ""
    Choose(resume) => resume(true) ++ "," ++ resume(false)
};
print(results)
