#
# /etc/pam.d/common-password - password-related modules common to all services
#
# This file is managed by pam-auth-update(8). Manual changes will be
# overwritten the next time this tool is run.
#
# Hardened for DISA STIG password requirements

password        requisite                       pam_pwquality.so retry=3 minlen=4
password        [success=1 default=ignore]      pam_unix.so obscure use_authtok try_first_pass yescrypt
password        requisite                       pam_deny.so
password        required                        pam_permit.so
# end of pam-auth-update
