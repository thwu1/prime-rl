$ORIGIN bench.example.
$TTL 3600

@   IN  SOA ns1.bench.example. admin.bench.example. (
            2024010101  ; serial
            3600        ; refresh
            900         ; retry
            604800      ; expire
            86400       ; minimum TTL
        )

@       IN  NS      ns1.bench.example.
@       IN  NS      ns2.bench.example.
ns1     IN  A       10.0.0.1
ns2     IN  A       10.0.0.2

@       IN  A       192.0.2.1
@       IN  A       192.0.2.2
@       IN  AAAA    2001:db8::1

www     IN  A       192.0.2.10
www     IN  AAAA    2001:db8::10
mail    IN  A       192.0.2.20
mail2   IN  A       192.0.2.21

cdn     IN  CNAME   www.bench.example.
blog    IN  CNAME   cdn.bench.example.

@       IN  MX      10 mail.bench.example.
@       IN  MX      20 mail2.bench.example.

@       IN  TXT     "v=spf1 include:_spf.bench.example ~all"
_dmarc  IN  TXT     "v=DMARC1; p=reject; rua=mailto:dmarc@bench.example"

_sip._tcp   IN  SRV     10 60 5060 sip.bench.example.
sip     IN  A       192.0.2.30

*       IN  A       192.0.2.100
*       IN  TXT     "wildcard record"

specific    IN  A   192.0.2.200
