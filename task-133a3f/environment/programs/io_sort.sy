int main() {
    int n = getint();
    int a[100];
    int i = 0;
    while (i < n) {
        a[i] = getint();
        i = i + 1;
    }

    // Bubble sort
    i = 0;
    while (i < n - 1) {
        int j = 0;
        while (j < n - 1 - i) {
            if (a[j] > a[j + 1]) {
                int temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Print sorted array
    i = 0;
    while (i < n) {
        putint(a[i]);
        putch(32);
        i = i + 1;
    }
    putch(10);
    return 0;
}
