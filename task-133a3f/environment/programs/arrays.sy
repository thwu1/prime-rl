int main() {
    int a[10];
    int i = 0;
    while (i < 10) {
        a[i] = i * i;
        i = i + 1;
    }

    // Print 1D array
    i = 0;
    while (i < 10) {
        putint(a[i]);
        putch(32);
        i = i + 1;
    }
    putch(10);

    // 2D array
    int b[3][4];
    int r = 0;
    while (r < 3) {
        int c = 0;
        while (c < 4) {
            b[r][c] = r * 4 + c;
            c = c + 1;
        }
        r = r + 1;
    }

    // Print 2D array
    r = 0;
    while (r < 3) {
        int c = 0;
        while (c < 4) {
            putint(b[r][c]);
            putch(32);
            c = c + 1;
        }
        putch(10);
        r = r + 1;
    }

    return 0;
}
