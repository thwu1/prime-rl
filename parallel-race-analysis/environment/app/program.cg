# Computation Graph for Parallel Program Analysis

# --- Node declarations ---
NODE 0 WEIGHT 2
NODE 1 WEIGHT 3
NODE 2 WEIGHT 5
NODE 3 WEIGHT 1
NODE 4 WEIGHT 4
NODE 5 WEIGHT 2
NODE 6 WEIGHT 3
NODE 7 WEIGHT 6
NODE 8 WEIGHT 2
NODE 9 WEIGHT 1
NODE 10 WEIGHT 4
NODE 11 WEIGHT 3
NODE 12 WEIGHT 2
NODE 13 WEIGHT 5
NODE 14 WEIGHT 1

# --- Memory accesses ---
ACCESS 0 WRITE x
ACCESS 1 READ x
ACCESS 1 WRITE y
ACCESS 2 WRITE x
ACCESS 2 READ z
ACCESS 3 READ y
ACCESS 3 WRITE z
ACCESS 4 READ x
ACCESS 4 READ y
ACCESS 5 WRITE y
ACCESS 5 WRITE z
ACCESS 6 READ z
ACCESS 6 WRITE w
ACCESS 7 READ x
ACCESS 7 WRITE w
ACCESS 8 READ w
ACCESS 8 READ y
ACCESS 9 READ x
ACCESS 9 READ z
ACCESS 10 WRITE x
ACCESS 10 WRITE y
ACCESS 11 READ w
ACCESS 11 WRITE z
ACCESS 12 READ y
ACCESS 12 READ z
ACCESS 13 WRITE w
ACCESS 14 READ x
ACCESS 14 READ y
ACCESS 14 READ z
ACCESS 14 READ w

# --- Edges ---
# Main task spine
CONTINUE 0 -> 1
CONTINUE 1 -> 4
CONTINUE 4 -> 8

# Async spawns from main
SPAWN 0 -> 2
SPAWN 1 -> 3

# First async group internal
CONTINUE 2 -> 5
SPAWN 2 -> 6
CONTINUE 5 -> 10
SPAWN 5 -> 7
CONTINUE 10 -> 12

# Second async group internal
CONTINUE 3 -> 9

# Nested async internal
CONTINUE 6 -> 11

# Future resolution
FUTURE_GET 7 -> 12

# --- Finish scopes ---
# FS0: top-level finish wrapping everything
FINISH_SCOPE FS0 PARENT NONE
FINISH_MEMBER FS0 0
FINISH_MEMBER FS0 1
FINISH_MEMBER FS0 4
FINISH_MEMBER FS0 8
FINISH_MEMBER FS0 12
FINISH_MEMBER FS0 13
FINISH_END FS0 14

# FS1: finish scope for first async group
FINISH_SCOPE FS1 PARENT FS0
FINISH_MEMBER FS1 2
FINISH_MEMBER FS1 5
FINISH_MEMBER FS1 6
FINISH_MEMBER FS1 7
FINISH_MEMBER FS1 10
FINISH_MEMBER FS1 11
FINISH_END FS1 12

# FS2: finish scope for second async group
FINISH_SCOPE FS2 PARENT FS0
FINISH_MEMBER FS2 3
FINISH_MEMBER FS2 9
FINISH_END FS2 13
