<?xml version="1.0"?>
<robot name="kuka_youbot">

  <!-- ====================================================== -->
  <!-- Mobile Base                                             -->
  <!-- ====================================================== -->
  <link name="base_footprint"/>

  <link name="base_link">
    <inertial>
      <mass value="22.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.42" ixy="0" ixz="0" iyy="0.70" iyz="0" izz="0.98"/>
    </inertial>
    <visual>
      <geometry><box size="0.58 0.38 0.14"/></geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry><box size="0.58 0.38 0.14"/></geometry>
    </collision>
  </link>

  <joint name="base_footprint_to_base" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0963" rpy="0 0 0"/>
  </joint>

  <!-- ====================================================== -->
  <!-- Mecanum Wheels                                          -->
  <!-- ====================================================== -->

  <!-- Wheel 1 (front-left) -->
  <link name="wheel_1">
    <inertial>
      <mass value="1.4"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0019"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.0475" length="0.025"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
  </link>
  <joint name="wheel_1_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_1"/>
    <origin xyz="0.235 0.15 -0.0963" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <gazebo reference="wheel_1">
    <mu1>0.5</mu1>
    <mu2>0.2</mu2>
    <mecanum_roller_angle>-0.7854</mecanum_roller_angle>
  </gazebo>

  <!-- Wheel 2 (front-right) -->
  <link name="wheel_2">
    <inertial>
      <mass value="1.4"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0019"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.0475" length="0.025"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
  </link>
  <joint name="wheel_2_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_2"/>
    <origin xyz="0.235 -0.15 -0.0963" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <gazebo reference="wheel_2">
    <mu1>0.5</mu1>
    <mu2>0.2</mu2>
    <mecanum_roller_angle>0.7854</mecanum_roller_angle>
  </gazebo>

  <!-- Wheel 3 (rear-right) -->
  <link name="wheel_3">
    <inertial>
      <mass value="1.4"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0019"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.0475" length="0.025"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
  </link>
  <joint name="wheel_3_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_3"/>
    <origin xyz="-0.235 -0.15 -0.0963" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <gazebo reference="wheel_3">
    <mu1>0.5</mu1>
    <mu2>0.2</mu2>
    <mecanum_roller_angle>-0.7854</mecanum_roller_angle>
  </gazebo>

  <!-- Wheel 4 (rear-left) -->
  <link name="wheel_4">
    <inertial>
      <mass value="1.4"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0012" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0019"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.0475" length="0.025"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
  </link>
  <joint name="wheel_4_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_4"/>
    <origin xyz="-0.235 0.15 -0.0963" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <gazebo reference="wheel_4">
    <mu1>0.5</mu1>
    <mu2>0.2</mu2>
    <mecanum_roller_angle>0.7854</mecanum_roller_angle>
  </gazebo>

  <!-- ====================================================== -->
  <!-- 5-DOF Robot Arm                                         -->
  <!-- ====================================================== -->

  <link name="arm_base_link">
    <inertial>
      <mass value="0.96"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.04" length="0.03"/></geometry>
      <material name="orange"><color rgba="0.9 0.5 0.1 1.0"/></material>
    </visual>
  </link>

  <joint name="base_to_arm_base" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="0.1662 0 0.0026" rpy="0 0 0"/>
  </joint>

  <!-- Joint 1 (base rotation) -->
  <link name="arm_link_1">
    <inertial>
      <mass value="1.39"/>
      <origin xyz="0 0 0.073" rpy="0 0 0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.035" length="0.147"/></geometry>
      <origin xyz="0 0 0.0735" rpy="0 0 0"/>
      <material name="orange"><color rgba="0.9 0.5 0.1 1.0"/></material>
    </visual>
  </link>
  <joint name="arm_joint_1" type="revolute">
    <parent link="arm_base_link"/>
    <child link="arm_link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-5.0" upper="5.0" effort="9.5" velocity="1.57"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Joint 2 (shoulder) -->
  <link name="arm_link_2">
    <inertial>
      <mass value="1.32"/>
      <origin xyz="0 0 0.078" rpy="0 0 0"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><box size="0.03 0.03 0.155"/></geometry>
      <origin xyz="0 0 0.0775" rpy="0 0 0"/>
      <material name="orange"><color rgba="0.9 0.5 0.1 1.0"/></material>
    </visual>
  </link>
  <joint name="arm_joint_2" type="revolute">
    <parent link="arm_link_1"/>
    <child link="arm_link_2"/>
    <origin xyz="0.033 0 0.147" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-5.0" upper="5.0" effort="9.5" velocity="1.57"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Joint 3 (elbow) -->
  <link name="arm_link_3">
    <inertial>
      <mass value="1.18"/>
      <origin xyz="0 0 0.068" rpy="0 0 0"/>
      <inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><box size="0.028 0.028 0.135"/></geometry>
      <origin xyz="0 0 0.0675" rpy="0 0 0"/>
      <material name="orange"><color rgba="0.9 0.5 0.1 1.0"/></material>
    </visual>
  </link>
  <joint name="arm_joint_3" type="revolute">
    <parent link="arm_link_2"/>
    <child link="arm_link_3"/>
    <origin xyz="0 0 0.155" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-5.0" upper="5.0" effort="6.0" velocity="1.57"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Joint 4 (wrist pitch) -->
  <link name="arm_link_4">
    <inertial>
      <mass value="0.55"/>
      <origin xyz="0 0 0.109" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0004"/>
    </inertial>
    <visual>
      <geometry><box size="0.024 0.024 0.2176"/></geometry>
      <origin xyz="0 0 0.1088" rpy="0 0 0"/>
      <material name="orange"><color rgba="0.9 0.5 0.1 1.0"/></material>
    </visual>
  </link>
  <joint name="arm_joint_4" type="revolute">
    <parent link="arm_link_3"/>
    <child link="arm_link_4"/>
    <origin xyz="0 0 0.135" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-5.0" upper="5.0" effort="2.0" velocity="1.57"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Joint 5 (wrist rotation) -->
  <link name="arm_link_5">
    <inertial>
      <mass value="0.25"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.015" length="0.01"/></geometry>
      <material name="silver"><color rgba="0.7 0.7 0.7 1.0"/></material>
    </visual>
  </link>
  <joint name="arm_joint_5" type="revolute">
    <parent link="arm_link_4"/>
    <child link="arm_link_5"/>
    <origin xyz="0 0 0.2176" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-5.0" upper="5.0" effort="1.0" velocity="1.57"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- End-effector frame -->
  <link name="end_effector">
    <visual>
      <geometry><sphere radius="0.005"/></geometry>
      <material name="red"><color rgba="1.0 0.0 0.0 1.0"/></material>
    </visual>
  </link>
  <joint name="ee_fixed_joint" type="fixed">
    <parent link="arm_link_5"/>
    <child link="end_effector"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
