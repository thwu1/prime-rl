/dts-v1/;

/ {
    compatible = "brcm,bcm2711";

    fragment@0 {
        target = <&i2c0>;
        __overlay__ {
            status = "okay";
            #address-cells = <1>;
            #size-cells = <0>;

            mcp23017: mcp23017@20 {
                compatible = "microchip,mcp23017";
                reg = <0x20>;
                gpio-controller;
                #gpio-cells = <2>;
                interrupt-controller;
                #interrupt-cells = <2>;
            };

            ds3231: rtc@68 {
                compatible = "dallas,ds3231";
                reg = <0x68>;
            };
        };
    };

    fragment@1 {
        target = <&spi0>;
        __overlay__ {
            status = "ok";
            #address-cells = <1>;
            #size-cells = <0>;

            mcp3008: mcp3008@0 {
                compatible = "microchip,mcp3008";
                spi-max-frequency = <1000000>;
            };
        };
    };
};
