              ]
            }
          ]}
        ]
      }
    },
    {
      "id": "SIP_RG_V_005",
      "description": "Verify IUT handles provisional 100 Trying before final 200 OK on re-registration",
      "pics_expr": "PICS_SIP_REG AND PICS_UA",
      "group": "Registration/Registrant/Valid",
      "components": {"mtc": {}},
      "timers": {"TWait": 5.0},
      "behavior": {
        "mtc": [
          {"op": "send", "msg_key": "register_reregister"},
          {"op": "start_timer", "name": "TWait"},
          {"op": "alt", "alts": [
            {
              "guard": "receive",
              "template_ref": "response_1xx_tmpl",
              "body": [
                {"op": "repeat"}
              ]
            },
            {
              "guard": "receive",
              "template_ref": "response_200_ok_tmpl",
              "body": [
                {"op": "stop_timer", "name": "TWait"},
                {"op": "setverdict", "v": "pass"}
              ]
            },
            {
              "guard": "receive",
              "template_ref": "response_4xx_tmpl",
              "body": [
                {"op": "stop_timer", "name": "TWait"},
                {"op": "setverdict", "v": "fail"}
              ]
            },
            {
              "guard": "timeout",
              "timer": "TWait",
              "body": [
                {"op": "setverdict", "v": "inconc"}
              ]
            }
          ]}
        ]
      }
    },
    {
      "id": "SIP_RG_V_006",
      "description": "Verify concurrent registration of two user agents via parallel test components",
      "pics_expr": "PICS_SIP_REG AND PICS_UA AND PICS_MULTI_UA",
      "group": "Registration/Registrant/Valid",
      "components": {"mtc": {}, "ua2": {}},
      "timers": {"TWait": 5.0},
      "behavior": {
        "mtc": [
          {"op": "send", "msg_key": "register_ua1"},
          {"op": "start_timer", "name": "TWait"},
          {"op": "alt", "alts": [
            {
              "guard": "receive",
              "template_ref": "response_200_ok_tmpl",
              "body": [
                {"op": "stop_timer", "name": "TWait"},
                {"op": "setverdict", "v": "pass"}
              ]
            },
            {
              "guard": "timeout",
              "timer": "TWait",
              "body": [
                {"op": "setverdict", "v": "inconc"}
              ]
            }
          ]},
          {"op": "sync", "point": "registered"}
        ],
        "ua2": [
          {"op": "send", "msg_key": "register_ua2"},
          {"op": "start_timer", "name": "TWait"},
          {"op": "alt", "alts": [
            {
              "guard": "receive",
              "template_ref": "response_200_ok_tmpl",
              "body": [
                {"op": "stop_timer", "name": "TWait"},
                {"op": "setverdict", "v": "pass"}
              ]
            },
            {
              "guard": "timeout",
              "timer": "TWait",
              "body": [
                {"op": "setverdict", "v": "inconc"}
              ]
            }
          ]},
          {"op": "sync", "point": "registered"}
        ]
      }
    }
  ]
}
