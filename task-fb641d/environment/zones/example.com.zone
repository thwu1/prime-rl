$ORIGIN example.com.
$TTL 3600

; SOA record
@       IN  SOA   ns1.example.com. admin.example.com. (
                    2024010101  ; serial
                    3600        ; refresh
                    900         ; retry
                    604800      ; expire
                    86400       ; minimum TTL
                    )

; NS records
@       IN  NS    ns1.example.com.
@       IN  NS    ns2.example.com.

; A and AAAA records for apex
@       IN  A     192.0.2.1
@       IN  AAAA  2001:db8::1

; MX records
@       IN  MX    10 mail.example.com.
@       IN  MX    20 mail2.example.com.

; TXT record
@       IN  TXT   "v=spf1 include:_spf.example.com ~all"

; Nameserver host records
ns1     IN  A     192.0.2.2
ns2     IN  A     192.0.2.3

; Mail server records
mail    IN  A     192.0.2.4
mail2   IN  A     192.0.2.5

; CNAME records (single and chained)
www     IN  CNAME example.com.
blog    IN  CNAME www.example.com.

; Wildcard records
*.wild  IN  A     192.0.2.100

; Subdomain with multiple record types
sub     IN  A     192.0.2.50
sub     IN  AAAA  2001:db8::50

; SRV record
_sip._tcp IN SRV  10 60 5060 sip.example.com.
sip     IN  A     192.0.2.60
