{
  "design": {
    "name": "arbiter_subsystem",
    "modules": {
      "top": {
        "submodules": ["arbiter", "fifo_ctrl", "priority_encoder", "req_tracker"],
        "ports": {
          "clk": "input",
          "rst_n": "input",
          "req": "input[3:0]",
          "grant": "output[3:0]",
          "fifo_full": "output",
          "fifo_empty": "output"
        }
      },
      "arbiter": {
        "submodules": [],
        "ports": {"clk": "input", "rst_n": "input", "req": "input[3:0]", "pri": "input[3:0]", "grant": "output[3:0]"}
      },
      "fifo_ctrl": {
        "submodules": [],
        "ports": {"clk": "input", "rst_n": "input", "push": "input", "pop": "input", "full": "output", "empty": "output", "count": "output[4:0]"}
      },
      "priority_encoder": {
        "submodules": [],
        "ports": {"req": "input[3:0]", "pri": "output[3:0]"}
      },
      "req_tracker": {
        "submodules": [],
        "ports": {"clk": "input", "rst_n": "input", "req": "input[3:0]", "grant": "input[3:0]", "pending": "output[3:0]"}
      }
    }
  },
  "properties": [
    {
      "id": "P1",
      "name": "mutual_exclusion",
      "description": "At most one grant is active at any time",
      "expression": "$onehot0(grant)",
      "type": "safety"
    },
    {
      "id": "P2",
      "name": "no_grant_without_request",
      "description": "A grant is only given if there is a corresponding request",
      "expression": "(grant & ~req) == 0",
      "type": "safety"
    },
    {
      "id": "P3",
      "name": "liveness",
      "description": "Every persistent request is eventually granted",
      "expression": "req[i] |-> ##[1:100] grant[i]",
      "type": "liveness"
    },
    {
      "id": "P4",
      "name": "fifo_no_overflow",
      "description": "FIFO never overflows",
      "expression": "!(full && push && !pop)",
      "type": "safety"
    },
    {
      "id": "P5",
      "name": "fifo_no_underflow",
      "description": "FIFO never underflows",
      "expression": "!(empty && pop && !push)",
      "type": "safety"
    },
    {
      "id": "P6",
      "name": "priority_correctness",
      "description": "Highest priority request gets granted first",
      "expression": "grant == (1 << highest_pri_req)",
      "type": "safety"
    },
    {
      "id": "P7",
      "name": "reset_behavior",
      "description": "After reset, all grants are deasserted",
      "expression": "!rst_n |=> grant == 0",
      "type": "safety"
    },
    {
      "id": "P8",
      "name": "request_tracking",
      "description": "Pending requests are accurately tracked",
      "expression": "pending == (req & ~grant)",
      "type": "safety"
    },
    {
      "id": "P9",
      "name": "fairness",
      "description": "No requester is starved indefinitely under contention",
      "expression": "req[i] && always(req[i]) |-> eventually(grant[i])",
      "type": "liveness"
    },
    {
      "id": "P10",
      "name": "deadlock_freedom",
      "description": "Arbiter never deadlocks with pending requests",
      "expression": "(|req) |-> ##[1:50] (|grant)",
      "type": "liveness"
    }
  ],
  "proof_nodes": [
