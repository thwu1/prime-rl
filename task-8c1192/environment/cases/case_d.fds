&HEAD CHID='heat_conduction_d', TITLE='1D Heat Conduction Verification - Case D (Bi=0.1)' /

&MESH IJK=3,3,3, XB=-0.15,0.15,-0.15,0.15,0.0,0.3 /

&TIME T_END=50000., WALL_INCREMENT=1, DT=0.5 /

&MISC SOLID_PHASE_ONLY=.TRUE. /

&SURF ID        = 'SLAB'
      MATL_ID   = 'SLAB_D'
      TMP_GAS_FRONT = 120.
      THICKNESS = 0.1
      STRETCH_FACTOR = 1.
      HEAT_TRANSFER_COEFFICIENT = 10.
      BACKING   = 'INSULATED' /

&MATL ID            = 'SLAB_D'
      CONDUCTIVITY  = 10.0
      EMISSIVITY    = 0.
      SPECIFIC_HEAT = 1.0
      DENSITY       = 10000. /

&VENT XB = -0.05,0.05,-0.05,0.05,0.0,0.0, SURF_ID='SLAB' /

&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /

&DEVC XYZ = 0.0,0.0,0.0, IOR = 3, ID='T_back',  QUANTITY = 'BACK WALL TEMPERATURE' /
&DEVC XYZ = 0.0,0.0,0.0, IOR = 3, ID='T_d08',   QUANTITY = 'INSIDE WALL TEMPERATURE', DEPTH=0.08 /
&DEVC XYZ = 0.0,0.0,0.0, IOR = 3, ID='T_d06',   QUANTITY = 'INSIDE WALL TEMPERATURE', DEPTH=0.06 /
&DEVC XYZ = 0.0,0.0,0.0, IOR = 3, ID='T_d04',   QUANTITY = 'INSIDE WALL TEMPERATURE', DEPTH=0.04 /
&DEVC XYZ = 0.0,0.0,0.0, IOR = 3, ID='T_d02',   QUANTITY = 'INSIDE WALL TEMPERATURE', DEPTH=0.02 /
&DEVC XYZ = 0.0,0.0,0.0, IOR = 3, ID='T_front', QUANTITY = 'WALL TEMPERATURE' /

&TAIL /
