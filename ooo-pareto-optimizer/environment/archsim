#!/usr/bin/env python3
"""
archsim - Analytical Out-of-Order Processor Simulator

Cycle-approximate performance, area, and power modeling for OoO processor
design space exploration. Supports solo and paired (shared-L2 interference)
simulation modes.
"""

import argparse
import json
import math
import sys

ARCH_REGS = 32
CLOCK_FREQ_GHZ = 1.0
SIM_INSTS = 1000000
INTERFERENCE_COEFF = 0.20

