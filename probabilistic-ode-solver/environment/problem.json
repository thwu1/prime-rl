{
  "ode_type": "lotka_volterra",
  "description": "Lotka-Volterra predator-prey model: dy1/dt = alpha*y1 - beta*y1*y2, dy2/dt = -gamma*y2 + delta*y1*y2",
  "parameters": {
    "alpha": 0.5,
    "beta": 0.025,
    "gamma": 0.5,
    "delta": 0.025
  },
  "initial_conditions": [30.0, 10.0],
  "time_span": [0.0, 20.0],
  "solver": {
    "step_size": 0.01,
    "prior_order": 3
  }
}
