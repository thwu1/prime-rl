    if not os.path.exists(sp):
        print(f"Error: shard {args.shard_id} not found", file=sys.stderr)
        return 1

    result = subprocess.run(
        [sys.executable, "/app/generator/generate.py", sp],
        capture_output=True, text=True
    )

    if result.stdout:
        print(result.stdout.strip())
    if result.returncode != 0 and result.stderr:
        print(result.stderr.strip(), file=sys.stderr)

    return result.returncode


def cmd_deploy_canary(args):
    """Run canary deployment from a shard.

    Generates config from the specified shard, validates it,
    tests it against a shadow proxy, and reports results.
    """
    sp = os.path.join(SHARD_DIR, f"shard_{args.shard_id}.db")
    if not os.path.exists(sp):
        print(f"Error: shard {args.shard_id} not found", file=sys.stderr)
        return 1

    print(f"Running canary deployment from shard {args.shard_id}...")

    # Step 1: Generate
    result = subprocess.run(
        [sys.executable, "/app/generator/generate.py", sp],
        capture_output=True, text=True
    )
    if result.returncode != 0:
        print(f"CANARY FAILED: Generator error: {result.stderr}", file=sys.stderr)
        return 1
    print(f"  Generation: OK")

    # Step 2: Validate
    if '/app/config_safety' not in sys.path:
        sys.path.insert(0, '/app/config_safety')
    try:
        from validator import validate_config
        with open(FEATURE_FILE) as f:
            data = json.load(f)
        valid, errors = validate_config(data)
        if not valid:
            print(f"CANARY FAILED: Validation errors:")
            for err in errors:
                print(f"  - {err}")
            return 1
        print(f"  Validation: PASSED ({len(data.get('features', []))} features)")
    except ImportError:
        print("  Validation: SKIPPED (validator not installed)")

    # Step 3: Test proxy load
    result = subprocess.run(
        [sys.executable, "-c",
         "import sys; sys.path.insert(0,'/app'); "
         "from proxy.server import ProxyServer; s=ProxyServer(); s.initialize(); "
         "r=s.handle_request({'user_agent_entropy':0.5,'request_rate_1m':10}); "
         "assert r['status']==200; print('OK')"],
        capture_output=True, text=True, timeout=30
    )
    if result.returncode != 0:
        print(f"CANARY FAILED: Proxy test failed: {result.stderr}")
        return 1
    print(f"  Proxy test: PASSED")

    print(f"CANARY PASSED: Safe to deploy from shard {args.shard_id}")
    return 0


def cmd_verify(args):
    """Run comprehensive system verification."""
    print("Running system verification...")
    print("=" * 55)

    errors = []
    passed = 0

    # 1. Shard consistency
    print("\n[1] Checking shard consistency...")
    counts = {}
    for sf in sorted(os.listdir(SHARD_DIR)):
        if not sf.endswith('.db'):
            continue
        sp = os.path.join(SHARD_DIR, sf)
        result = subprocess.run(
            [sys.executable, "/app/generator/generate.py", sp],
            capture_output=True, text=True
        )
        if result.returncode != 0:
            errors.append(f"Generator failed on {sf}: {result.stderr.strip()}")
            continue
        with open(FEATURE_FILE) as f:
            data = json.load(f)
        counts[sf] = len(data['features'])

    unique = set(counts.values())
    if len(unique) > 1:
        errors.append(f"Inconsistent feature counts: {counts}")
        print(f"    FAIL: counts vary: {counts}")
    elif len(unique) == 1:
        print(f"    PASS: all shards produce {list(unique)[0]} features")
        passed += 1

    # 2. Duplicate check
    print("\n[2] Checking for duplicate features...")
    if os.path.exists(FEATURE_FILE):
        with open(FEATURE_FILE) as f:
            data = json.load(f)
        names = [f['name'] for f in data.get('features', [])]
        dupes = len(names) - len(set(names))
        if dupes > 0:
            errors.append(f"{dupes} duplicate features")
            print(f"    FAIL: {dupes} duplicates found")
        else:
            print(f"    PASS: no duplicates")
            passed += 1

    # 3. Proxy startup
    print("\n[3] Checking proxy startup...")
    result = subprocess.run(
        [sys.executable, "-c",
         "import sys; sys.path.insert(0,'/app'); "
         "from proxy.server import ProxyServer; s=ProxyServer(); s.initialize(); "
         "r=s.handle_request({'user_agent_entropy':0.5,'request_rate_1m':10}); "
         "assert r['status']==200; print('OK')"],
        capture_output=True, text=True, timeout=30
    )
    if result.returncode != 0:
        errors.append(f"Proxy startup failed: {result.stderr.strip()[:100]}")
        print(f"    FAIL: {result.stderr.strip()[:80]}")
    else:
        print(f"    PASS: proxy starts and serves")
        passed += 1

    # 4. Proxy resilience
    print("\n[4] Checking proxy resilience (oversized config)...")
    result = subprocess.run(
        [sys.executable, "-c", """
import json, sys, os
sys.path.insert(0, '/app')
os.makedirs('/app/features', exist_ok=True)
oversized = {"version": 2, "generated_at": "test", "shard_source": "test",
    "features": [{"name": f"f_{i}", "type": "Float64", "enabled": True, "weight": 0.01}
                 for i in range(250)], "feature_count": 250}
with open('/app/features/bot_features.json', 'w') as f:
    json.dump(oversized, f)
from proxy.server import ProxyServer
s = ProxyServer()
try:
    s.initialize()
    r = s.handle_request({"user_agent_entropy": 0.5})
    print("GRACEFUL")
except SystemExit:
    print("CRASH")
    sys.exit(1)
"""],
        capture_output=True, text=True, timeout=30
    )
    if 'CRASH' in result.stdout or result.returncode != 0:
        errors.append("Proxy crashes on oversized config")
        print(f"    FAIL: proxy crashed")
    else:
        print(f"    PASS: handles oversized config gracefully")
        passed += 1

    # Restore valid config
    subprocess.run(
        [sys.executable, "/app/generator/generate.py",
         os.path.join(SHARD_DIR, "shard_4.db")],
        capture_output=True
    )

    # 5. Config validator
    print("\n[5] Checking configuration validator...")
    try:
        if '/app/config_safety' not in sys.path:
            sys.path.insert(0, '/app/config_safety')
        # Force reimport
        if 'validator' in sys.modules:
            del sys.modules['validator']
        from validator import validate_config
        with open(FEATURE_FILE) as f:
            data = json.load(f)
        valid, errs = validate_config(data)
        if valid:
            print(f"    PASS: validator accepts valid config")
            passed += 1
        else:
            errors.append(f"Validator rejects valid config: {errs}")
            print(f"    FAIL: rejects valid config: {errs}")
    except ImportError:
        errors.append("Validator not found at /app/config_safety/validator.py")
        print(f"    FAIL: validator not installed")
    except Exception as e:
        errors.append(f"Validator error: {e}")
        print(f"    FAIL: error: {e}")

    # 6. Design document
    print("\n[6] Checking design document...")
    if os.path.exists("/app/design_doc.md"):
        with open("/app/design_doc.md") as f:
            content = f.read()
        if len(content) >= 800:
            print(f"    PASS: design document exists ({len(content)} chars)")
            passed += 1
        else:
            errors.append(f"Design document too short ({len(content)} chars)")
            print(f"    FAIL: too short ({len(content)} chars)")
    else:
        errors.append("Design document not found")
        print(f"    FAIL: not found at /app/design_doc.md")

    # 7. Incident report
    print("\n[7] Checking incident report...")
    if os.path.exists("/app/incident_report.txt"):
        with open("/app/incident_report.txt") as f:
            content = f.read()
        if len(content) >= 300:
            print(f"    PASS: incident report exists ({len(content)} chars)")
            passed += 1
        else:
            errors.append("Incident report too short")
            print(f"    FAIL: too short")
    else:
        errors.append("Incident report not found")
        print(f"    FAIL: not found")

    # Summary
    total = passed + len(errors)
    print(f"\n{'=' * 55}")
    if errors:
        print(f"VERIFICATION FAILED: {passed}/{total} checks passed")
        print(f"\nFailures:")
        for i, err in enumerate(errors, 1):
            print(f"  {i}. {err}")
        return 1
    else:
        print(f"VERIFICATION PASSED: {passed}/{total} checks passed")
        return 0


def main():
    parser = argparse.ArgumentParser(
        prog='cfctl',
        description='CDN Feature Configuration Management Tool',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  cfctl status                                    System overview
  cfctl shard list                                List shards and migration state
  cfctl shard inspect 0                           Inspect shard 0 schema
  cfctl shard query 0 "SELECT count(*) ..."       Run SQL against shard
  cfctl config show                               Show current feature config
  cfctl config show --raw | jq '.features | length'   Feature count via jq
  cfctl config validate /app/features/bot_features.json
  cfctl config diff file1.json file2.json         Compare two configs
  cfctl config history                            Show change history
  cfctl deploy generate 0                         Generate from shard 0
  cfctl deploy canary 0                           Canary deploy from shard 0
  cfctl verify                                    Run all verification checks
"""
    )
    parser.add_argument('--format', choices=['table', 'json'], default='table',
                        help='Output format (default: table)')
    parser.add_argument('--verbose', '-v', action='store_true',
                        help='Enable verbose output')

    subparsers = parser.add_subparsers(dest='command', help='Available commands')

    # status
    subparsers.add_parser('status', help='Show system status overview')

    # shard
    shard_parser = subparsers.add_parser('shard', help='Database shard operations')
    shard_sub = shard_parser.add_subparsers(dest='shard_command')

    shard_sub.add_parser('list', help='List all shards with migration state')

    inspect_p = shard_sub.add_parser('inspect', help='Inspect shard schema and metadata')
    inspect_p.add_argument('shard_id', type=int, help='Shard ID (0-4)')

    query_p = shard_sub.add_parser('query', help='Execute SQL against a shard')
    query_p.add_argument('shard_id', type=int, help='Shard ID (0-4)')
    query_p.add_argument('sql', help='SQL query to execute')

    # config
    config_parser = subparsers.add_parser('config', help='Configuration operations')
    config_sub = config_parser.add_subparsers(dest='config_command')

    show_p = config_sub.add_parser('show', help='Show current feature configuration')
    show_p.add_argument('--raw', action='store_true', help='Output raw JSON')

    validate_p = config_sub.add_parser('validate',
                                        help='Validate a configuration file')
    validate_p.add_argument('file', help='Path to configuration JSON file')

    diff_p = config_sub.add_parser('diff', help='Diff two configuration files')
    diff_p.add_argument('file1', help='First config file')
    diff_p.add_argument('file2', help='Second config file')

    config_sub.add_parser('history', help='Show configuration change history')

    # deploy
    deploy_parser = subparsers.add_parser('deploy', help='Deployment operations')
    deploy_sub = deploy_parser.add_subparsers(dest='deploy_command')

    gen_p = deploy_sub.add_parser('generate', help='Generate config from specific shard')
    gen_p.add_argument('shard_id', type=int, help='Shard ID (0-4)')

    canary_p = deploy_sub.add_parser('canary', help='Run canary deployment from shard')
    canary_p.add_argument('shard_id', type=int, help='Shard ID (0-4)')

    # verify
    subparsers.add_parser('verify', help='Run system verification checks')

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return 1

    cmd_map = {
        'status': cmd_status,
        'verify': cmd_verify,
    }

    if args.command in cmd_map:
        return cmd_map[args.command](args) or 0

    if args.command == 'shard':
        shard_cmds = {
            'list': cmd_shard_list,
            'inspect': cmd_shard_inspect,
            'query': cmd_shard_query,
        }
        if args.shard_command in shard_cmds:
            return shard_cmds[args.shard_command](args) or 0
        shard_parser.print_help()
        return 1

    if args.command == 'config':
        config_cmds = {
            'show': cmd_config_show,
            'validate': cmd_config_validate,
            'diff': cmd_config_diff,
            'history': cmd_config_history,
        }
        if args.config_command in config_cmds:
            return config_cmds[args.config_command](args) or 0
        config_parser.print_help()
        return 1

    if args.command == 'deploy':
        deploy_cmds = {
            'generate': cmd_deploy_generate,
            'canary': cmd_deploy_canary,
        }
        if args.deploy_command in deploy_cmds:
            return deploy_cmds[args.deploy_command](args) or 0
        deploy_parser.print_help()
        return 1

    parser.print_help()
    return 1


if __name__ == '__main__':
    sys.exit(main())
