{
  "classification": {
    "priority_order": ["memory-bound", "frontend-stalled", "branch-heavy", "compute-bound"],
    "default": "mixed",
    "rules": {
      "memory-bound": [
        {"metric": "ipc", "op": "<", "value": 1.0},
        {"metric": "backend_stall_ratio", "op": ">=", "value": 0.40}
      ],
      "frontend-stalled": [
        {"metric": "frontend_stall_ratio", "op": ">=", "value": 0.30}
      ],
      "branch-heavy": [
        {"metric": "branch_miss_rate", "op": ">=", "value": 0.05}
      ],
      "compute-bound": [
        {"metric": "ipc", "op": ">=", "value": 1.5},
        {"metric": "backend_stall_ratio", "op": "<", "value": 0.25}
      ]
    }
  },
  "regression": {
    "min_relative_ipc_decrease": 0.10,
    "cause_method": "largest_relative_increase",
    "cause_labels": {
      "cache_miss_rate": "cache_miss_increase",
      "branch_miss_rate": "branch_prediction_degradation",
      "frontend_stall_ratio": "frontend_stall_increase",
      "backend_stall_ratio": "backend_stall_increase"
    },
    "severity": {
      "critical_max_delta": -0.5,
      "moderate_max_delta": -0.2
    }
  },
  "validation": {
    "noisy_ctx_switches_per_sec": 5000,
    "migration_per_sec": 100
  }
}
