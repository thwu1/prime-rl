program TestBoolCompound
  int a, b, c;
{
  void main()
    boolean r;
  {
    a = 3; b = 7; c = 12;
    r = a < b && b < c;
    print(r, 0);
    r = a > b || b < c;
    print(r, 0);
    r = a > b && b < c;
    print(r, 0);
    r = a > b || b > c;
    print(r, 0);
    r = (a < b || b > 100) && c == 12;
    print(r, 0);
    r = (a > 100 || b > 100) && c == 12;
    print(r, 0);
  }
}
