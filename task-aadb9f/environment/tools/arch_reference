#!/usr/bin/env python3
"""NVIDIA GPU Architecture Reference Database.

Provides verified architecture parameters for cross-referencing
against local specification files.
"""

import argparse
import json
import sys

REFERENCE_DB = {
    "volta": {
        "name": "volta",
        "compute_capability": "7.0",
        "gpu_model": "Tesla V100",
        "warp_size": 32,
        "max_threads_per_block": 1024,
        "max_threads_per_multiprocessor": 2048,
        "max_warps_per_multiprocessor": 64,
        "max_thread_blocks_per_multiprocessor": 32,
        "max_registers_per_multiprocessor": 65536,
        "register_alloc_unit_size": 256,
        "max_shared_memory_per_multiprocessor": 98304,
        "shared_memory_alloc_unit_size": 256,
        "max_shared_memory_per_block": 49152,
    },
    "ampere": {
        "name": "ampere",
        "compute_capability": "8.0",
        "gpu_model": "A100",
        "warp_size": 32,
        "max_threads_per_block": 1024,
        "max_threads_per_multiprocessor": 2048,
        "max_warps_per_multiprocessor": 64,
        "max_thread_blocks_per_multiprocessor": 32,
        "max_registers_per_multiprocessor": 65536,
        "register_alloc_unit_size": 256,
        "max_shared_memory_per_multiprocessor": 167936,
        "shared_memory_alloc_unit_size": 128,
        "max_shared_memory_per_block": 167936,
    },
    "hopper": {
        "name": "hopper",
        "compute_capability": "9.0",
        "gpu_model": "H100",
        "warp_size": 32,
        "max_threads_per_block": 1024,
        "max_threads_per_multiprocessor": 2048,
        "max_warps_per_multiprocessor": 64,
        "max_thread_blocks_per_multiprocessor": 32,
        "max_registers_per_multiprocessor": 65536,
        "register_alloc_unit_size": 256,
        "max_shared_memory_per_multiprocessor": 233472,
        "shared_memory_alloc_unit_size": 128,
        "max_shared_memory_per_block": 233472,
    },
}

PARAM_KEYS = [
    "compute_capability",
    "warp_size",
    "max_threads_per_block",
    "max_threads_per_multiprocessor",
    "max_warps_per_multiprocessor",
    "max_thread_blocks_per_multiprocessor",
    "max_registers_per_multiprocessor",
    "register_alloc_unit_size",
    "max_shared_memory_per_multiprocessor",
    "shared_memory_alloc_unit_size",
    "max_shared_memory_per_block",
]


def cmd_list(args):
    for name, ref in REFERENCE_DB.items():
        print(f"{name:<12} SM {ref['compute_capability']:<6} ({ref['gpu_model']})")


def cmd_query(args):
    arch_name = args.architecture.lower()
    if arch_name not in REFERENCE_DB:
        print(f"Error: Unknown architecture '{arch_name}'", file=sys.stderr)
        print(f"Available: {', '.join(REFERENCE_DB.keys())}", file=sys.stderr)
        sys.exit(1)

    ref = REFERENCE_DB[arch_name]

    if args.parameter:
        param = args.parameter
        if param not in ref:
            print(f"Error: Unknown parameter '{param}'", file=sys.stderr)
            print(f"Available: {', '.join(PARAM_KEYS)}", file=sys.stderr)
            sys.exit(1)
        print(ref[param])
    else:
        print(f"Architecture: {arch_name} (SM {ref['compute_capability']}, {ref['gpu_model']})")
        print("Parameters:")
        for key in PARAM_KEYS:
            print(f"  {key:<45} = {ref[key]}")


def cmd_compare(args):
    with open(args.spec_file) as f:
        spec = json.load(f)

    arch_name = spec.get("name", "").lower()
    if arch_name not in REFERENCE_DB:
        print(f"Error: Spec file architecture '{arch_name}' not in reference database",
              file=sys.stderr)
        sys.exit(1)

    ref = REFERENCE_DB[arch_name]
    mismatches = 0
    matches = 0

    print(f"Comparing against reference for architecture '{arch_name}':")
    for key in PARAM_KEYS:
        if key not in spec:
            continue
        ref_val = ref[key]
        spec_val = spec[key]
        if str(ref_val) != str(spec_val):
            print(f"  {key}: MISMATCH (file: {spec_val}, reference: {ref_val})")
            mismatches += 1
        else:
            matches += 1

    if mismatches == 0:
        print(f"  All {matches} parameters match reference values.")
    else:
        print(f"  [{matches} other parameters match]")
    print(f"{mismatches} mismatches found.")
    sys.exit(1 if mismatches > 0 else 0)


def main():
    parser = argparse.ArgumentParser(
        description="NVIDIA GPU Architecture Reference Database"
    )
    sub = parser.add_subparsers(dest="command")

    sub.add_parser("list", help="List all supported architectures")

    p_query = sub.add_parser("query", help="Query architecture parameters")
    p_query.add_argument("architecture", help="Architecture name (volta, ampere, hopper)")
    p_query.add_argument("parameter", nargs="?", default=None,
                         help="Specific parameter to query (omit for all)")

    p_compare = sub.add_parser("compare",
                               help="Compare a spec file against reference values")
    p_compare.add_argument("spec_file", help="Path to architecture spec JSON file")

    args = parser.parse_args()

    if args.command == "list":
        cmd_list(args)
    elif args.command == "query":
        cmd_query(args)
    elif args.command == "compare":
        cmd_compare(args)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
