// Test 11: I/O functions (getint, putint, putch), stdin handling
int main() {
    int n = getint();
    int a[100];
    int i = 0;
    while (i < n) {
        a[i] = getint();
        i = i + 1;
    }
    int j = n - 1;
    while (j >= 0) {
        putint(a[j]);
        if (j > 0) putch(32);
        j = j - 1;
    }
    putch(10);
    return n;
}
