// Test 12: Complex program - bubble sort with array parameter modification
void swap(int a[], int i, int j) {
    int temp = a[i];
    a[i] = a[j];
    a[j] = temp;
}

void bubbleSort(int a[], int n) {
    int i = 0;
    while (i < n - 1) {
        int j = 0;
        while (j < n - 1 - i) {
            if (a[j] > a[j + 1]) {
                swap(a, j, j + 1);
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

int main() {
    int n = getint();
    int a[100];
    int i = 0;
    while (i < n) {
        a[i] = getint();
        i = i + 1;
    }
    bubbleSort(a, n);
    i = 0;
    while (i < n) {
        putint(a[i]);
        if (i < n - 1) putch(32);
        i = i + 1;
    }
    putch(10);
    return 0;
}
