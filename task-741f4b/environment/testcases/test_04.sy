// Test 04: While loops, break, continue, nested loops
int main() {
    int i = 0;
    int sum = 0;
    while (i < 10) {
        i = i + 1;
        if (i == 5) continue;
        if (i == 8) break;
        sum = sum + i;
    }
    putint(sum); putch(32);
    // Nested loops: inner break only breaks inner loop
    int count = 0;
    i = 0;
    while (i < 4) {
        int j = 0;
        while (j < 4) {
            if (j == 2) break;
            count = count + 1;
            j = j + 1;
        }
        i = i + 1;
    }
    putint(count); putch(10);
    return 0;
}
