// Test 07: 1D and 2D arrays, initialization, partial initialization
int main() {
    int a[5] = {10, 20, 30, 40, 50};
    int b[2][3] = {{1, 2, 3}, {4, 5, 6}};
    int sum1 = 0;
    int i = 0;
    while (i < 5) {
        sum1 = sum1 + a[i];
        i = i + 1;
    }
    putint(sum1); putch(32);
    int sum2 = 0;
    i = 0;
    while (i < 2) {
        int j = 0;
        while (j < 3) {
            sum2 = sum2 + b[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    putint(sum2); putch(32);
    // Partial initialization
    int c[5] = {1, 2};
    putint(c[0]); putch(32);
    putint(c[1]); putch(32);
    putint(c[2]); putch(10);
    return 0;
}
