{
  "conntrack_max": 8,
  "rules": {
    "raw_PREROUTING": [
      {"match": {"proto": "tcp", "dst_port": 443}, "action": "NOTRACK"}
    ],
    "mangle_PREROUTING": [],
    "filter_INPUT": [
      {"match": {"proto": "tcp", "dst_port": 22}, "action": "DROP"},
      {"match": {}, "action": "ACCEPT"}
    ]
  }
}
