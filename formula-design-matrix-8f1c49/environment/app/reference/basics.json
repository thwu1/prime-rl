{
  "test_cases": [
    {
      "name": "single_numeric",
      "formula": "x",
      "data": {"x": [1.0, 2.0, 3.0]},
      "expected_columns": ["Intercept", "x"],
      "expected_matrix": [[1, 1], [1, 2], [1, 3]]
    },
    {
      "name": "two_numeric_additive",
      "formula": "x + y",
      "data": {"x": [1.0, 2.0], "y": [3.0, 4.0]},
      "expected_columns": ["Intercept", "x", "y"],
      "expected_matrix": [[1, 1, 3], [1, 2, 4]]
    },
    {
      "name": "no_intercept_numeric",
      "formula": "0 + x",
      "data": {"x": [1.0, 2.0, 3.0]},
      "expected_columns": ["x"],
      "expected_matrix": [[1], [2], [3]]
    },
    {
      "name": "intercept_only",
      "formula": "1",
      "data": {"x": [1.0, 2.0]},
      "expected_columns": ["Intercept"],
      "expected_matrix": [[1], [1]]
    }
  ]
}
