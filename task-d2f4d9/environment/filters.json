    "fs_readonly": {
      "description": "Allows read-only filesystem access: read, close, fstat, lseek, exit, exit_group, and open ONLY when the access mode bits indicate O_RDONLY (args[1] & O_ACCMODE == 0, where O_ACCMODE = 3 and args[1] is the flags parameter).",
      "policy": {
        "allow": [
          {"syscall": "read", "nr": 0},
          {"syscall": "close", "nr": 3},
          {"syscall": "fstat", "nr": 5},
          {"syscall": "lseek", "nr": 8},
          {"syscall": "exit", "nr": 60},
