{
  "filters": {
    "stdio_mmap": {
      "description": "Allows basic I/O (read, write), process lifecycle (exit, exit_group), memory management (brk), and memory mapping (mmap) but MUST deny mmap when PROT_EXEC (bit 2) is set in args[2] (the prot parameter).",
      "policy": {
        "allow": [
          {"syscall": "read", "nr": 0},
          {"syscall": "write", "nr": 1},
          {"syscall": "exit", "nr": 60},
          {"syscall": "exit_group", "nr": 231},
          {"syscall": "brk", "nr": 12},
          {"syscall": "mmap", "nr": 9, "constraint": "args[2] (prot) must not have bit 2 (PROT_EXEC) set"}
        ],
        "default": "KILL"
      },
      "instructions": [
        {"code": 32, "jt": 0, "jf": 0, "k": 0},
        {"code": 21, "jt": 7, "jf": 0, "k": 0},
        {"code": 21, "jt": 6, "jf": 0, "k": 1},
        {"code": 21, "jt": 5, "jf": 0, "k": 60},
        {"code": 21, "jt": 4, "jf": 0, "k": 231},
