        {"code": 6, "jt": 0, "jf": 0, "k": 2147418112},
        {"code": 6, "jt": 0, "jf": 0, "k": 0}
      ]
    },
    "network_socket": {
      "description": "Allows basic I/O (read, write, close), networking (connect, sendto, recvfrom), and socket creation ONLY for AF_INET (2) or AF_INET6 (10) with SOCK_STREAM (1) or SOCK_DGRAM (2). The socket type check must mask out SOCK_CLOEXEC (0x80000) and SOCK_NONBLOCK (0x800) before comparison.",
      "policy": {
        "allow": [
          {"syscall": "read", "nr": 0},
          {"syscall": "write", "nr": 1},
          {"syscall": "close", "nr": 3},
          {"syscall": "connect", "nr": 42},
          {"syscall": "sendto", "nr": 44},
          {"syscall": "recvfrom", "nr": 45},
          {"syscall": "socket", "nr": 41, "constraint": "args[0] (domain) must be 2 (AF_INET) or 10 (AF_INET6); args[1] (type) masked with ~0x80800 must be 1 (SOCK_STREAM) or 2 (SOCK_DGRAM)"}
        ],
        "default": "KILL"
      },
      "instructions": [
        {"code": 32, "jt": 0, "jf": 0, "k": 0},
