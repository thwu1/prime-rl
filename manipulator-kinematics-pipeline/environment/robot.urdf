<?xml version="1.0" encoding="utf-8"?>
<robot name="rbx600">

  <!-- ======================================================= -->
  <!-- RBX-600: 6-DOF Industrial Serial Manipulator            -->
  <!-- URDF generated from CAD assembly rev.3                   -->
  <!-- All units: meters, radians, kilograms                    -->
  <!-- ======================================================= -->

  <!-- Base mounting plate -->
  <link name="base_link">
    <inertial>
      <mass value="8.2"/>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <inertia ixx="0.043" ixy="0.0" ixz="0.0" iyy="0.043" iyz="0.0" izz="0.067"/>
    </inertial>
  </link>

  <!-- Shoulder housing -->
  <link name="shoulder_link">
    <inertial>
      <mass value="5.4"/>
      <origin xyz="0.0 0.0 0.16" rpy="0 0 0"/>
      <inertia ixx="0.039" ixy="0.0" ixz="0.0" iyy="0.039" iyz="0.0" izz="0.013"/>
    </inertial>
  </link>

  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9671" upper="2.9671" effort="87.0" velocity="2.175"/>
    <dynamics damping="0.5" friction="0.12"/>
  </joint>

  <!-- Upper arm segment -->
  <link name="upper_arm_link">
    <inertial>
      <mass value="4.9"/>
      <origin xyz="0.19 0.0 0.0" rpy="0 0 0"/>
      <inertia ixx="0.013" ixy="0.0" ixz="0.0" iyy="0.195" iyz="0.0" izz="0.195"/>
    </inertial>
  </link>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.340" rpy="1.5707963267948966 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0944" upper="2.0944" effort="87.0" velocity="2.175"/>
    <dynamics damping="0.5" friction="0.12"/>
  </joint>

  <!-- Forearm segment -->
  <link name="forearm_link">
    <inertial>
      <mass value="3.1"/>
      <origin xyz="0.02 0.0 0.0" rpy="0 0 0"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.032" iyz="0.0" izz="0.032"/>
    </inertial>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0.400 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9671" upper="2.9671" effort="40.0" velocity="3.15"/>
    <dynamics damping="0.3" friction="0.08"/>
  </joint>

  <!-- Wrist pitch housing -->
  <link name="wrist_1_link">
    <inertial>
      <mass value="1.8"/>
      <origin xyz="0.0 0.0 0.19" rpy="0 0 0"/>
      <inertia ixx="0.009" ixy="0.0" ixz="0.0" iyy="0.009" iyz="0.0" izz="0.004"/>
    </inertial>
  </link>

  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0.040 0 0" rpy="1.5707963267948966 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9671" upper="2.9671" effort="40.0" velocity="3.15"/>
    <dynamics damping="0.3" friction="0.08"/>
  </joint>

  <!-- Wrist roll housing -->
  <link name="wrist_2_link">
    <inertial>
      <mass value="1.8"/>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <inertia ixx="0.009" ixy="0.0" ixz="0.0" iyy="0.009" iyz="0.0" izz="0.004"/>
    </inertial>
  </link>

  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 0 0.400" rpy="-1.5707963267948966 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0944" upper="2.0944" effort="28.0" velocity="3.15"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- Wrist yaw / flange -->
  <link name="wrist_3_link">
    <inertial>
      <mass value="0.6"/>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0 0" rpy="1.5707963267948966 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9671" upper="2.9671" effort="28.0" velocity="3.15"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <!-- Tool mounting flange -->
  <link name="tool0">
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0.0 0.0 0.063" rpy="0 0 0"/>
      <inertia ixx="0.0003" ixy="0.0" ixz="0.0" iyy="0.0003" iyz="0.0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="tool0_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.126" rpy="0 0 0"/>
  </joint>

  <!-- Auxiliary sensor mount (wrist-mounted depth camera) -->
  <link name="camera_mount">
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0.025 0 0.015" rpy="0 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00003"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="tool0"/>
    <child link="camera_mount"/>
    <origin xyz="0.050 0 0.030" rpy="0 0.2618 0"/>
  </joint>

</robot>
