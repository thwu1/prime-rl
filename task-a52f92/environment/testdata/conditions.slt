# Conditional execution tests (skipif / onlyif)

statement ok
CREATE TABLE c1(x INTEGER)

statement ok
INSERT INTO c1 VALUES(1)

# Only runs when label 'sqlite' is NOT present
skipif sqlite
statement ok
INSERT INTO c1 VALUES(100)

# Only runs when label 'sqlite' IS present
onlyif sqlite
statement ok
INSERT INTO c1 VALUES(2)

# With sqlite: values are 1, 2 -> sum=3
onlyif sqlite
query I nosort
SELECT sum(x) FROM c1
----
3

# With postgres: values are 1, 100 -> sum=101
onlyif postgres
query I nosort
SELECT sum(x) FROM c1
----
101
