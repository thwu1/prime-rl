# Combined: exercises all optimization categories together
function combined(2):
bb0:
  v0 = add a0 a1
  v1 = const 1
  v2 = store a0 0 v1
  branch a0 bb1 bb2
bb1:
  v3 = add a0 a1
  v4 = load a0 0
  jump bb3
bb2:
  v5 = add a0 a1
  v6 = load a0 0
  jump bb3
bb3:
  v7 = phi bb1:v3 bb2:v5
  v8 = add a0 a1
  v9 = mul v7 v8
  return v9
