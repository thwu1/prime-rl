# ==== CATALOG ====
<http://env-data.europa.eu/catalog> a dcat:Catalog ;
    dct:title "European Environmental Data Portal"@en ;
    dct:title "Portail européen de données environnementales"@fr ;
    dct:description "A comprehensive catalog of environmental monitoring datasets from across Europe"@en ;
    dct:publisher <http://env-data.europa.eu/publisher/eea> ;
    dct:language "en" ;
    dct:language "fr" ;
    dct:spatial <http://publications.europa.eu/resource/authority/country/EUR> ;
    dcat:themeTaxonomy <http://publications.europa.eu/resource/authority/data-theme> ;
    dct:issued "2022-01-15"^^xsd:date ;
    dct:modified "2024-06-01"^^xsd:date ;
    dct:license <https://spdx.org/licenses/CC-BY-4.0> ;
    foaf:homepage <http://env-data.europa.eu> ;
    dcat:contactPoint [
        a vcard:Kind ;
        vcard:fn "Environmental Data Office" ;
        vcard:hasEmail <mailto:contact@env-data.europa.eu>
    ] ;
    dcat:dataset <http://env-data.europa.eu/dataset/DS001> ,
                 <http://env-data.europa.eu/dataset/DS002> ,
                 <http://env-data.europa.eu/dataset/DS003> ,
                 <http://env-data.europa.eu/dataset/DS004> ;
    dcat:service <http://env-data.europa.eu/service/api> .

# ==== PUBLISHERS ====
<http://env-data.europa.eu/publisher/eea> a foaf:Organization ;
    foaf:name "European Environment Agency"@en .

<http://env-data.europa.eu/publisher/irceline> a foaf:Organization ;
    foaf:name "Belgian Interregional Environment Agency"@en ;
    foaf:name "Agence interrégionale de l'environnement belge"@fr .

<http://env-data.europa.eu/publisher/uba> a foaf:Organization ;
    foaf:name "German Federal Environment Agency"@en ;
    foaf:name "Umweltbundesamt"@de .

# ==== DATASET SERIES ====
<http://env-data.europa.eu/series/aq-monitoring> a dcat:Dataset ;
    dct:title "European Air Quality Monitoring Series"@en ;
    dct:description "Time-series collection of air quality monitoring data"@en ;
    dct:publisher <http://env-data.europa.eu/publisher/eea> .

# ==== DS001: Air Quality Index ====
<http://env-data.europa.eu/dataset/DS001> a dcat:Dataset ;
    dct:title "Air Quality Index 2024"@en ;
    dct:title "Indice de qualité de l'air 2024"@fr ;
    dct:description "Hourly air quality index values from 500+ monitoring stations across Europe"@en ;
    dct:publisher <http://env-data.europa.eu/publisher/eea> ;
    dcat:theme <http://data.europa.eu/resource/authority/data-theme/ENVI> ,
              <http://data.europa.eu/resource/authority/data-theme/HEAL> ;
    dcat:keyword "air quality"@en , "pollution"@en , "monitoring"@en , "AQI"@en ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/HOURLY> ;
    dct:spatial <http://publications.europa.eu/resource/authority/country/EUR> ;
    dct:temporal [
        a dct:PeriodOfTime ;
        dcat:startDate "2024-01-01"^^xsd:date ;
        dcat:endDate "2024-12-31"^^xsd:date
    ] ;
    dcat:landingPage <http://env-data.europa.eu/datasets/air-quality-2024> ;
    dcat:contactPoint "AQ Data Team" ;
    dcat:inSeries <http://env-data.europa.eu/series/aq-monitoring> ;
    dcat:distribution <http://env-data.europa.eu/distribution/DIST001> ,
                      <http://env-data.europa.eu/distribution/DIST002> .

<http://env-data.europa.eu/distribution/DIST001> a dcat:Distribution ;
    dct:title "Air Quality CSV Export"@en ;
    dcat:accessURL "http://env-data.europa.eu/api/aq/2024" ;
    dcat:downloadURL <http://env-data.europa.eu/download/aq-2024.csv> ;
    dct:format "text/csv" ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/csv> ;
    dcat:byteSize 524288000 ;
    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> .

<http://env-data.europa.eu/distribution/DIST002> a dcat:Distribution ;
    dct:title "Air Quality JSON-LD"@en ;
    dcat:accessURL <http://env-data.europa.eu/api/aq/2024/jsonld> ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/JSON_LD> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/application/ld+json> ;
    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> .

# ==== DS002: Water Quality ====
<http://env-data.europa.eu/dataset/DS002> a dcat:Dataset ;
    dct:title "Water Quality Measurements"@en ;
    dct:description "Chemical and biological water quality parameters from river monitoring stations"@en ;
    dct:publisher <http://env-data.europa.eu/publisher/irceline> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/ENVI> ;
    dcat:keyword "water quality"@en , "rivers"@en ;
    dct:accrualPeriodicity <http://purl.org/cld/freq/quarterly> ;
    dct:spatial <http://publications.europa.eu/resource/authority/country/BEL> ;
