{
  "deployment": {
    "region": "us-east-1",
    "cluster": "prod-metrics-v3",
    "retention_days": 30
  },
  "service_tiers": {
    "web": {
      "description": "User-facing web application endpoints",
      "priority": 1,
      "routing": {
        "ingestion_endpoint": "/v1/metrics/web",
        "output_topic": "metrics.web.aggregated"
      },
      "sla": {
        "accuracy": {
          "max_relative_error": 0.005,
          "critical_percentiles": ["p99", "p999"],
          "evaluation_window_count": 5
        },
        "resources": {
          "max_memory_bytes_per_sketch": 49152,
          "max_merge_latency_us": 500,
          "max_concurrent_sketches": 1000
        }
      }
    },
    "batch": {
      "description": "Background batch processing jobs",
      "priority": 3,
      "routing": {
        "ingestion_endpoint": "/v1/metrics/batch",
        "output_topic": "metrics.batch.aggregated"
      },
      "sla": {
        "accuracy": {
          "max_relative_error": 0.05,
          "critical_percentiles": ["p50", "p90"],
          "evaluation_window_count": 10
        },
        "resources": {
          "max_memory_bytes_per_sketch": 4096,
          "max_merge_latency_us": 5000,
          "max_concurrent_sketches": 200
        }
      }
    },
    "realtime": {
      "description": "Real-time event streaming services",
      "priority": 2,
      "routing": {
        "ingestion_endpoint": "/v1/metrics/realtime",
        "output_topic": "metrics.realtime.aggregated"
      },
      "sla": {
        "accuracy": {
          "max_relative_error": 0.01,
          "critical_percentiles": ["p95", "p99"],
          "evaluation_window_count": 3
        },
        "resources": {
          "max_memory_bytes_per_sketch": 24576,
          "max_merge_latency_us": 1000,
          "max_concurrent_sketches": 500
        }
      }
    }
  },
  "constraints": {
    "global_memory_budget_bytes": 1048576,
    "window_size_sec": 10,
    "percentiles": [0.5, 0.9, 0.95, 0.99, 0.999],
    "bytes_per_bin": 12,
    "sketch_overhead_bytes": 64
  }
}
