<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#"
         xml:base="http://example.org/rpt">

  <owl:Ontology rdf:about="http://example.org/rpt">
    <rdfs:label>Retail Product Taxonomy</rdfs:label>
    <rdfs:comment>A product classification system organized by retail department and storage requirements</rdfs:comment>
  </owl:Ontology>

  <!-- ============ TOP-LEVEL CLASSES ============ -->

  <owl:Class rdf:about="http://example.org/rpt#Edible">
    <rdfs:label>Edible</rdfs:label>
    <rdfs:comment>Any consumable item sold in retail for eating or drinking</rdfs:comment>
    <skos:altLabel>Food and drink</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#NonEdible">
    <rdfs:label>Non-Edible</rdfs:label>
    <rdfs:comment>Retail products not intended for human consumption including cleaning paper and personal care</rdfs:comment>
  </owl:Class>

  <!-- ============ DAIRY ============ -->

  <owl:Class rdf:about="http://example.org/rpt#DairyItem">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#Edible"/>
    <rdfs:label>Dairy Item</rdfs:label>
    <rdfs:comment>Products originating from milk</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#LiquidDairy">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#DairyItem"/>
    <rdfs:label>Liquid Dairy</rdfs:label>
    <rdfs:comment>Pourable dairy products including whole milk skim milk and cream</rdfs:comment>
    <skos:altLabel>Fluid dairy</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#SolidDairy">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#DairyItem"/>
    <rdfs:label>Solid Dairy</rdfs:label>
    <rdfs:comment>Firm or semi-firm dairy products including cheese and butter</rdfs:comment>
    <skos:altLabel>Hard dairy</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#CulturedDairy">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#DairyItem"/>
    <rdfs:label>Cultured Dairy</rdfs:label>
    <rdfs:comment>Dairy products produced through controlled bacterial fermentation</rdfs:comment>
    <skos:altLabel>Fermented dairy</skos:altLabel>
  </owl:Class>

  <!-- ============ PROTEIN ============ -->

  <owl:Class rdf:about="http://example.org/rpt#ProteinItem">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#Edible"/>
    <rdfs:label>Protein Item</rdfs:label>
    <rdfs:comment>High-protein food products sourced from animals including meat poultry and seafood</rdfs:comment>
    <skos:altLabel>Animal protein</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#BeefProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#ProteinItem"/>
    <rdfs:label>Beef Product</rdfs:label>
    <rdfs:comment>Meat products from cattle</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#PorkProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#ProteinItem"/>
    <rdfs:label>Pork Product</rdfs:label>
    <rdfs:comment>Meat products from swine</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#ChickenProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#ProteinItem"/>
    <rdfs:label>Chicken Product</rdfs:label>
    <rdfs:comment>Meat products from domesticated poultry primarily chicken</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#FishItem">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#ProteinItem"/>
    <rdfs:label>Fish Item</rdfs:label>
    <rdfs:comment>Products from finned aquatic animals</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#ShellfishItem">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#ProteinItem"/>
    <rdfs:label>Shellfish Item</rdfs:label>
    <rdfs:comment>Products from aquatic crustaceans and mollusks</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#DeliMeat">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#ProteinItem"/>
    <rdfs:label>Deli Meat</rdfs:label>
    <rdfs:comment>Pre-cooked or cured meat products sold sliced at delicatessen counters</rdfs:comment>
    <skos:altLabel>Luncheon meat</skos:altLabel>
  </owl:Class>

  <!-- ============ PRODUCE ============ -->

  <owl:Class rdf:about="http://example.org/rpt#ProduceItem">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#Edible"/>
    <rdfs:label>Produce Item</rdfs:label>
    <rdfs:comment>Plant-based food items including fresh and dried fruits vegetables herbs and spices</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#FruitItem">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#ProduceItem"/>
    <rdfs:label>Fruit Item</rdfs:label>
    <rdfs:comment>Edible fruits sold fresh or minimally processed</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#VegetableItem">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#ProduceItem"/>
    <rdfs:label>Vegetable Item</rdfs:label>
    <rdfs:comment>Edible vegetables sold fresh or minimally processed</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#HerbSpice">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#ProduceItem"/>
    <rdfs:label>Herb and Spice</rdfs:label>
    <rdfs:comment>Aromatic plant-based seasonings sold fresh or dried for culinary use</rdfs:comment>
    <skos:altLabel>Seasoning</skos:altLabel>
  </owl:Class>

  <!-- ============ BAKED ============ -->

  <owl:Class rdf:about="http://example.org/rpt#BakedItem">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#Edible"/>
    <rdfs:label>Baked Item</rdfs:label>
    <rdfs:comment>Products produced by baking in an oven</rdfs:comment>
    <skos:altLabel>Baked goods</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#BreadLoaf">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#BakedItem"/>
    <rdfs:label>Bread Loaf</rdfs:label>
    <rdfs:comment>Leavened or unleavened bread products sold as loaves or rolls</rdfs:comment>
    <skos:altLabel>Bread</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#CakeItem">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#BakedItem"/>
    <rdfs:label>Cake Item</rdfs:label>
    <rdfs:comment>Sweet layered or frosted baked confection</rdfs:comment>
    <skos:altLabel>Cake</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#PastryItem">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#BakedItem"/>
    <rdfs:label>Pastry Item</rdfs:label>
    <rdfs:comment>Baked goods made from rich dough or puff pastry</rdfs:comment>
    <skos:altLabel>Pastry</skos:altLabel>
  </owl:Class>

  <!-- ============ DRINKS ============ -->

  <owl:Class rdf:about="http://example.org/rpt#DrinkItem">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#Edible"/>
    <rdfs:label>Drink Item</rdfs:label>
    <rdfs:comment>Beverages for retail sale</rdfs:comment>
    <skos:altLabel>Beverage</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#CoffeeTeaDrink">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#DrinkItem"/>
    <rdfs:label>Coffee and Tea</rdfs:label>
    <rdfs:comment>Brewed beverages from roasted coffee beans or steeped tea leaves served hot or iced</rdfs:comment>
    <skos:altLabel>Hot infusion</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#JuiceSodaDrink">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#DrinkItem"/>
    <rdfs:label>Juice and Soda</rdfs:label>
    <rdfs:comment>Non-alcoholic fruit-based and carbonated beverages</rdfs:comment>
    <skos:altLabel>Soft drink</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#WaterDrink">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#DrinkItem"/>
    <rdfs:label>Water</rdfs:label>
    <rdfs:comment>Bottled still or sparkling water products</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#BeerWineLiquor">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#DrinkItem"/>
    <rdfs:label>Beer Wine and Liquor</rdfs:label>
    <rdfs:comment>Beverages containing alcohol produced by fermentation or distillation</rdfs:comment>
    <skos:altLabel>Alcoholic beverage</skos:altLabel>
  </owl:Class>

  <!-- ============ STAPLES ============ -->

  <owl:Class rdf:about="http://example.org/rpt#StapleItem">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#Edible"/>
    <rdfs:label>Staple Item</rdfs:label>
    <rdfs:comment>Shelf-stable pantry essentials including grains pasta and baking ingredients</rdfs:comment>
    <skos:altLabel>Pantry staple</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#RiceItem">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#StapleItem"/>
    <rdfs:label>Rice Item</rdfs:label>
    <rdfs:comment>Processed rice grains for cooking</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#PastaItem">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#StapleItem"/>
    <rdfs:label>Pasta Item</rdfs:label>
    <rdfs:comment>Dried or fresh pasta products</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#CerealItem">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#StapleItem"/>
    <rdfs:label>Cereal Item</rdfs:label>
    <rdfs:comment>Ready-to-eat or cook breakfast grain products</rdfs:comment>
    <skos:altLabel>Breakfast cereal</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#FlourItem">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#StapleItem"/>
    <rdfs:label>Flour Item</rdfs:label>
    <rdfs:comment>Ground grain powder used for baking and cooking</rdfs:comment>
  </owl:Class>

  <!-- ============ CLEANING ============ -->

  <owl:Class rdf:about="http://example.org/rpt#CleaningProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#NonEdible"/>
    <rdfs:label>Cleaning Product</rdfs:label>
    <rdfs:comment>Products for sanitizing cleaning and maintaining household surfaces and items</rdfs:comment>
    <skos:altLabel>Cleaning supply</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#FabricCleaner">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#CleaningProduct"/>
    <rdfs:label>Fabric Cleaner</rdfs:label>
    <rdfs:comment>Detergent and products specifically for washing textiles and clothing</rdfs:comment>
    <skos:altLabel>Laundry detergent</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#SurfaceCleaner">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#CleaningProduct"/>
    <rdfs:label>Surface Cleaner</rdfs:label>
    <rdfs:comment>Products for cleaning hard surfaces countertops and dishes</rdfs:comment>
  </owl:Class>

  <!-- ============ PAPER ============ -->

  <owl:Class rdf:about="http://example.org/rpt#PaperProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#NonEdible"/>
    <rdfs:label>Paper Product</rdfs:label>
    <rdfs:comment>Disposable paper items for household use</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#FacialTissue">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#PaperProduct"/>
    <rdfs:label>Facial Tissue</rdfs:label>
    <rdfs:comment>Soft disposable paper for face and nose</rdfs:comment>
    <skos:altLabel>Tissue</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#KitchenTowel">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#PaperProduct"/>
    <rdfs:label>Kitchen Towel</rdfs:label>
    <rdfs:comment>Absorbent paper rolls for kitchen surface cleanup</rdfs:comment>
    <skos:altLabel>Paper towel</skos:altLabel>
  </owl:Class>

  <!-- ============ BODY CARE ============ -->

  <owl:Class rdf:about="http://example.org/rpt#BodyCareProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#NonEdible"/>
    <rdfs:label>Body Care Product</rdfs:label>
    <rdfs:comment>Products for personal body maintenance and hygiene</rdfs:comment>
    <skos:altLabel>Personal care</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#HairProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#BodyCareProduct"/>
    <rdfs:label>Hair Product</rdfs:label>
    <rdfs:comment>Shampoo conditioner and styling products for hair</rdfs:comment>
    <skos:altLabel>Hair care</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#SkinProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#BodyCareProduct"/>
    <rdfs:label>Skin Product</rdfs:label>
    <rdfs:comment>Lotions creams and treatment products for skin health</rdfs:comment>
    <skos:altLabel>Skin care</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/rpt#DentalProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/rpt#BodyCareProduct"/>
    <rdfs:label>Dental Product</rdfs:label>
    <rdfs:comment>Toothpaste mouthwash and oral hygiene items</rdfs:comment>
    <skos:altLabel>Oral care</skos:altLabel>
  </owl:Class>

  <!-- ============ PROPERTIES ============ -->

  <owl:DatatypeProperty rdf:about="http://example.org/rpt#hasNutritionInfo">
    <rdfs:domain rdf:resource="http://example.org/rpt#Edible"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>has nutrition info</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.org/rpt#storageTemperature">
    <rdfs:domain rdf:resource="http://example.org/rpt#Edible"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>storage temperature</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.org/rpt#packageFormat">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>package format</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.org/rpt#retailPrice">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label>retail price</rdfs:label>
  </owl:DatatypeProperty>

</rdf:RDF>
