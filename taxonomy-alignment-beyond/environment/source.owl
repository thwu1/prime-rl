<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#"
         xml:base="http://example.org/gpc">

  <owl:Ontology rdf:about="http://example.org/gpc">
    <rdfs:label>Generic Product Classification</rdfs:label>
    <rdfs:comment>A hierarchical classification system for retail consumer products</rdfs:comment>
  </owl:Ontology>

  <!-- ============ TOP-LEVEL CLASSES ============ -->

  <owl:Class rdf:about="http://example.org/gpc#FoodProduct">
    <rdfs:label>Food Product</rdfs:label>
    <rdfs:comment>Any product intended for human consumption including food and beverages</rdfs:comment>
    <skos:altLabel>Consumable goods</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#HouseholdProduct">
    <rdfs:label>Household Product</rdfs:label>
    <rdfs:comment>Products used for domestic maintenance including cleaning supplies and disposable paper goods</rdfs:comment>
    <skos:altLabel>Home care product</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#PersonalCareProduct">
    <rdfs:label>Personal Care Product</rdfs:label>
    <rdfs:comment>Products for personal hygiene grooming and body maintenance</rdfs:comment>
    <skos:altLabel>Toiletry</skos:altLabel>
  </owl:Class>

  <!-- ============ DAIRY ============ -->

  <owl:Class rdf:about="http://example.org/gpc#DairyProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#FoodProduct"/>
    <rdfs:label>Dairy Product</rdfs:label>
    <rdfs:comment>Products derived from animal milk through various processing methods</rdfs:comment>
    <skos:altLabel>Milk-based product</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#Milk">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#DairyProduct"/>
    <rdfs:label>Milk</rdfs:label>
    <rdfs:comment>Liquid dairy product obtained from mammals used for drinking or cooking</rdfs:comment>
    <skos:altLabel>Fresh milk</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#Cheese">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#DairyProduct"/>
    <rdfs:label>Cheese</rdfs:label>
    <rdfs:comment>Solid dairy product made by coagulating milk protein casein</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#Yogurt">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#DairyProduct"/>
    <rdfs:label>Yogurt</rdfs:label>
    <rdfs:comment>Semi-solid fermented dairy product with bacterial cultures</rdfs:comment>
    <skos:altLabel>Yoghurt</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#Butter">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#DairyProduct"/>
    <rdfs:label>Butter</rdfs:label>
    <rdfs:comment>Solid fat dairy product made by churning cream or fermented cream</rdfs:comment>
  </owl:Class>

  <!-- ============ MEAT ============ -->

  <owl:Class rdf:about="http://example.org/gpc#MeatProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#FoodProduct"/>
    <rdfs:label>Meat Product</rdfs:label>
    <rdfs:comment>Products from animal flesh intended for human consumption</rdfs:comment>
    <skos:altLabel>Meat</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#RedMeat">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#MeatProduct"/>
    <rdfs:label>Red Meat</rdfs:label>
    <rdfs:comment>Meat from mammals including beef pork and lamb that appears red when raw</rdfs:comment>
    <skos:altLabel>Mammalian meat</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#Poultry">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#MeatProduct"/>
    <rdfs:label>Poultry</rdfs:label>
    <rdfs:comment>Meat from domesticated birds such as chicken turkey and duck</rdfs:comment>
    <skos:altLabel>Fowl meat</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#ProcessedMeat">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#MeatProduct"/>
    <rdfs:label>Processed Meat</rdfs:label>
    <rdfs:comment>Meat preserved or flavored through smoking curing salting or adding preservatives</rdfs:comment>
    <skos:altLabel>Cured meat</skos:altLabel>
  </owl:Class>

  <!-- ============ SEAFOOD ============ -->

  <owl:Class rdf:about="http://example.org/gpc#SeafoodProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#FoodProduct"/>
    <rdfs:label>Seafood Product</rdfs:label>
    <rdfs:comment>Edible aquatic animals including both fish and shellfish</rdfs:comment>
    <skos:altLabel>Marine food</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#Fish">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#SeafoodProduct"/>
    <rdfs:label>Fish</rdfs:label>
    <rdfs:comment>Finned aquatic vertebrates harvested for food</rdfs:comment>
    <skos:altLabel>Finfish</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#Shellfish">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#SeafoodProduct"/>
    <rdfs:label>Shellfish</rdfs:label>
    <rdfs:comment>Aquatic invertebrates with exoskeletons including crustaceans and mollusks</rdfs:comment>
    <skos:altLabel>Crustaceans and mollusks</skos:altLabel>
  </owl:Class>

  <!-- ============ BAKERY ============ -->

  <owl:Class rdf:about="http://example.org/gpc#BakeryProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#FoodProduct"/>
    <rdfs:label>Bakery Product</rdfs:label>
    <rdfs:comment>Products made by baking dough or batter in an oven</rdfs:comment>
    <skos:altLabel>Baked goods</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#Bread">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#BakeryProduct"/>
    <rdfs:label>Bread</rdfs:label>
    <rdfs:comment>Staple food made from flour water and leavening agent baked into loaves or rolls</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#Cake">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#BakeryProduct"/>
    <rdfs:label>Cake</rdfs:label>
    <rdfs:comment>Sweet baked confection made from flour sugar eggs and fat</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#Pastry">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#BakeryProduct"/>
    <rdfs:label>Pastry</rdfs:label>
    <rdfs:comment>Baked product made with enriched dough containing butter or shortening</rdfs:comment>
  </owl:Class>

  <!-- ============ BEVERAGE ============ -->

  <owl:Class rdf:about="http://example.org/gpc#Beverage">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#FoodProduct"/>
    <rdfs:label>Beverage</rdfs:label>
    <rdfs:comment>Liquid products intended for drinking</rdfs:comment>
    <skos:altLabel>Drink</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#HotDrink">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#Beverage"/>
    <rdfs:label>Hot Drink</rdfs:label>
    <rdfs:comment>Beverages typically prepared and served at elevated temperature including coffee tea and hot chocolate</rdfs:comment>
    <skos:altLabel>Warm beverage</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#ColdDrink">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#Beverage"/>
    <rdfs:label>Cold Drink</rdfs:label>
    <rdfs:comment>Beverages typically served chilled or at room temperature including juice soda and iced tea</rdfs:comment>
    <skos:altLabel>Chilled beverage</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#AlcoholicDrink">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#Beverage"/>
    <rdfs:label>Alcoholic Drink</rdfs:label>
    <rdfs:comment>Beverages containing ethanol produced by fermentation or distillation</rdfs:comment>
    <skos:altLabel>Alcoholic beverage</skos:altLabel>
  </owl:Class>

  <!-- ============ PRODUCE ============ -->

  <owl:Class rdf:about="http://example.org/gpc#FreshProduce">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#FoodProduct"/>
    <rdfs:label>Fresh Produce</rdfs:label>
    <rdfs:comment>Unprocessed plant-based foods sold in fresh form including fruits vegetables and herbs</rdfs:comment>
    <skos:altLabel>Farm produce</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#Fruit">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#FreshProduce"/>
    <rdfs:label>Fruit</rdfs:label>
    <rdfs:comment>Edible seed-bearing structures of flowering plants</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#Vegetable">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#FreshProduce"/>
    <rdfs:label>Vegetable</rdfs:label>
    <rdfs:comment>Edible plant parts such as roots stems and leaves excluding fruit structures</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#Herb">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#FreshProduce"/>
    <rdfs:label>Herb</rdfs:label>
    <rdfs:comment>Aromatic fresh plants used primarily for flavoring in cooking</rdfs:comment>
    <skos:altLabel>Culinary herb</skos:altLabel>
  </owl:Class>

  <!-- ============ GRAIN ============ -->

  <owl:Class rdf:about="http://example.org/gpc#GrainProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#FoodProduct"/>
    <rdfs:label>Grain Product</rdfs:label>
    <rdfs:comment>Products derived from cereal grains such as wheat rice oats and corn</rdfs:comment>
    <skos:altLabel>Cereal product</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#Rice">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#GrainProduct"/>
    <rdfs:label>Rice</rdfs:label>
    <rdfs:comment>Edible grain of the grass species Oryza sativa or Oryza glaberrima</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#Pasta">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#GrainProduct"/>
    <rdfs:label>Pasta</rdfs:label>
    <rdfs:comment>Shaped dough products typically from durum wheat semolina served cooked</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#Cereal">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#GrainProduct"/>
    <rdfs:label>Cereal</rdfs:label>
    <rdfs:comment>Processed grain food typically eaten at breakfast with milk</rdfs:comment>
    <skos:altLabel>Breakfast cereal</skos:altLabel>
  </owl:Class>

  <!-- ============ CLEANING ============ -->

  <owl:Class rdf:about="http://example.org/gpc#CleaningAgent">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#HouseholdProduct"/>
    <rdfs:label>Cleaning Agent</rdfs:label>
    <rdfs:comment>Chemical products designed for removing dirt stains and contaminants from surfaces and fabrics</rdfs:comment>
    <skos:altLabel>Cleanser</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#LaundryProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#CleaningAgent"/>
    <rdfs:label>Laundry Product</rdfs:label>
    <rdfs:comment>Products specifically for washing clothing and textile items</rdfs:comment>
    <skos:altLabel>Fabric care</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#DishwashingProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#CleaningAgent"/>
    <rdfs:label>Dishwashing Product</rdfs:label>
    <rdfs:comment>Products for cleaning dishes cookware and kitchen utensils</rdfs:comment>
  </owl:Class>

  <!-- ============ PAPER ============ -->

  <owl:Class rdf:about="http://example.org/gpc#PaperGoods">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#HouseholdProduct"/>
    <rdfs:label>Paper Goods</rdfs:label>
    <rdfs:comment>Single-use disposable paper products for household cleaning and personal use</rdfs:comment>
    <skos:altLabel>Paper products</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#Tissue">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#PaperGoods"/>
    <rdfs:label>Tissue</rdfs:label>
    <rdfs:comment>Soft thin disposable paper sheets for nose blowing and face cleaning</rdfs:comment>
    <skos:altLabel>Facial tissue</skos:altLabel>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#PaperTowel">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#PaperGoods"/>
    <rdfs:label>Paper Towel</rdfs:label>
    <rdfs:comment>Absorbent disposable paper sheets on rolls for wiping surfaces and hands</rdfs:comment>
    <skos:altLabel>Kitchen towel</skos:altLabel>
  </owl:Class>

  <!-- ============ PERSONAL CARE ============ -->

  <owl:Class rdf:about="http://example.org/gpc#HairCareProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#PersonalCareProduct"/>
    <rdfs:label>Hair Care Product</rdfs:label>
    <rdfs:comment>Products for cleaning conditioning and styling human hair</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#SkinCareProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#PersonalCareProduct"/>
    <rdfs:label>Skin Care Product</rdfs:label>
    <rdfs:comment>Products for maintaining and improving skin health and appearance</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://example.org/gpc#OralCareProduct">
    <rdfs:subClassOf rdf:resource="http://example.org/gpc#PersonalCareProduct"/>
    <rdfs:label>Oral Care Product</rdfs:label>
    <rdfs:comment>Products for dental hygiene and oral health including toothpaste and mouthwash</rdfs:comment>
    <skos:altLabel>Dental care</skos:altLabel>
  </owl:Class>

  <!-- ============ PROPERTIES ============ -->

  <owl:DatatypeProperty rdf:about="http://example.org/gpc#hasIngredient">
    <rdfs:domain rdf:resource="http://example.org/gpc#FoodProduct"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label>has ingredient</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.org/gpc#hasShelfLifeDays">
    <rdfs:domain rdf:resource="http://example.org/gpc#FoodProduct"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>has shelf life in days</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.org/gpc#requiresRefrigeration">
    <rdfs:domain rdf:resource="http://example.org/gpc#FoodProduct"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label>requires refrigeration</rdfs:label>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="http://example.org/gpc#hasNetWeight">
    <rdfs:domain rdf:resource="http://example.org/gpc#FoodProduct"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:label>has net weight</rdfs:label>
  </owl:DatatypeProperty>

</rdf:RDF>
