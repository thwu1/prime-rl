# Application Configuration File
# Generated by Ansible - DO NOT EDIT MANUALLY
# Host: {{ ansible_hostname }}
# Date: {{ ansible_date_time.date }

[application]
hostname = {{ ansible_hostname }}
fqdn = {{ ansible_fqdn }}
environment = {{ env_name | upper }
project = {{ project_name }}

[paths]
base_dir = {{ deploy_base }}
config_dir = {{ deploy_base }}/config
data_dir = {{ deploy_base }}/data
log_dir = {{ deploy_base }}/logs

{% if 'production' in group_names %}
[database]
host = {{ db_host | default('127.0.0.1') }}
port = {{ db_port | default(5432) }}
password = {{ vault_db_password }}
max_connections = 100
{% endif %}

{% if 'monitoring' in group_names %}
[monitoring]
enabled = true
port = {{ monitoring_port }}
interval = {{ monitoring_interval }}
api_key = {{ vault_api_key }}
{% endif %}

[cluster_members]
{% for host in groups['webservers'] %}
server_{{ loop.index }} = {{ host }}
{% endfor %}
