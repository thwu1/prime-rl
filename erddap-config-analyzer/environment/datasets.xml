<!-- Local NetCDF file dataset -->
<dataset type="EDDGridFromNcFiles" datasetID="localBathyGrid" active="true">
  <fileDir>/app/source_data/</fileDir>
  <fileNameRegex>sample_bathy\.nc</fileNameRegex>
  <reloadEveryNMinutes>10080</reloadEveryNMinutes>
  <addAttributes>
    <att name="title">Local Bathymetry Grid</att>
    <att name="institution">NOAA NGDC</att>
    <att name="Conventions">CF-1.6</att>
  </addAttributes>
  <axisVariable>
    <sourceName>latitude</sourceName>
  </axisVariable>
  <axisVariable>
    <sourceName>longitude</sourceName>
  </axisVariable>
  <dataVariable>
    <sourceName>elevation</sourceName>
    <destinationName>topo</destinationName>
    <dataType>short</dataType>
    <addAttributes>
      <att name="long_name">Topography/Bathymetry</att>
      <att name="standard_name">surface_altitude</att>
      <att name="units">m</att>
    </addAttributes>
  </dataVariable>
</dataset>

</erddapDatasets>
