<!-- Deep nesting: EDDGridLon0360 wrapping EDDGridSideBySide with two EDDGridFromDap children -->
<dataset type="EDDGridLon0360" datasetID="erdWindComposite_0360">
  <dataset type="EDDGridSideBySide" datasetID="erdWindComposite_sbs">
    <dataset type="EDDGridFromDap" datasetID="erdQSwind_u">
      <sourceUrl>https://coastwatch.pfeg.noaa.gov/thredds/dodsC/satellite/QS/ux10/1day</sourceUrl>
      <reloadEveryNMinutes>10080</reloadEveryNMinutes>
      <addAttributes>
        <att name="title">Wind, QuikSCAT, Zonal, Global, Science Quality</att>
        <att name="institution">NOAA NMFS SWFSC ERD</att>
      </addAttributes>
      <axisVariable><sourceName>time</sourceName></axisVariable>
      <axisVariable><sourceName>altitude</sourceName></axisVariable>
      <axisVariable>
        <sourceName>lat</sourceName>
        <destinationName>latitude</destinationName>
      </axisVariable>
      <axisVariable>
        <sourceName>lon</sourceName>
        <destinationName>longitude</destinationName>
      </axisVariable>
      <dataVariable>
        <sourceName>ux10</sourceName>
        <destinationName>x_wind</destinationName>
        <dataType>float</dataType>
        <addAttributes>
          <att name="ioos_category">Wind</att>
          <att name="long_name">Zonal Wind Speed at 10m</att>
          <att name="standard_name">x_wind</att>
          <att name="units">m s-1</att>
        </addAttributes>
      </dataVariable>
    </dataset>
    <dataset type="EDDGridFromDap" datasetID="erdQSwind_v">
      <sourceUrl>https://coastwatch.pfeg.noaa.gov/thredds/dodsC/satellite/QS/uy10/1day</sourceUrl>
      <reloadEveryNMinutes>10080</reloadEveryNMinutes>
      <addAttributes>
        <att name="title">Wind, QuikSCAT, Meridional, Global, Science Quality</att>
        <att name="institution">NOAA NMFS SWFSC ERD</att>
      </addAttributes>
      <axisVariable><sourceName>time</sourceName></axisVariable>
      <axisVariable><sourceName>altitude</sourceName></axisVariable>
      <axisVariable>
        <sourceName>lat</sourceName>
        <destinationName>latitude</destinationName>
      </axisVariable>
      <axisVariable>
        <sourceName>lon</sourceName>
        <destinationName>longitude</destinationName>
      </axisVariable>
      <dataVariable>
        <sourceName>uy10</sourceName>
        <destinationName>y_wind</destinationName>
        <dataType>float</dataType>
        <addAttributes>
          <att name="ioos_category">Wind</att>
          <att name="long_name">Meridional Wind Speed at 10m</att>
          <att name="standard_name">y_wind</att>
          <att name="units">m s-1</att>
        </addAttributes>
      </dataVariable>
    </dataset>
  </dataset>
</dataset>

