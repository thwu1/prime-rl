netcdf sample_bathy {
dimensions:
	latitude = 10 ;
	longitude = 20 ;
variables:
	float latitude(latitude) ;
		latitude:units = "degrees_north" ;
		latitude:standard_name = "latitude" ;
		latitude:axis = "Y" ;
		latitude:long_name = "Latitude" ;
	float longitude(longitude) ;
		longitude:units = "degrees_east" ;
		longitude:standard_name = "longitude" ;
		longitude:axis = "X" ;
		longitude:long_name = "Longitude" ;
	short elevation(latitude, longitude) ;
		elevation:units = "m" ;
		elevation:long_name = "Elevation relative to sea level" ;
		elevation:standard_name = "surface_altitude" ;
		elevation:_FillValue = -32768s ;
	byte land_mask(latitude, longitude) ;
		land_mask:long_name = "Land-Ocean mask" ;
		land_mask:flag_values = 0b, 1b ;
		land_mask:flag_meanings = "ocean land" ;

// global attributes:
		:title = "Sample Bathymetry/Topography" ;
		:Conventions = "CF-1.6" ;
		:institution = "NOAA NGDC" ;
