{
  "properties": {
    "coherence": {
      "expression": "G(read -> F data_valid)",
      "signals": ["read", "data_valid", "cache_hit"],
      "temporal_depth": 8
    }
  },
  "signal_dependencies": {
    "read": [],
    "data_valid": ["cache_hit", "read"],
    "cache_hit": []
  },
  "decompositions": [
    {
      "strategy": "assume_guarantee",
      "target": "coherence",
      "params": {
        "sub_properties": {
          "fast_path": {
