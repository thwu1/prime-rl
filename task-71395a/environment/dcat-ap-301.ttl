        sh:name "temporal coverage"@en ;
    ] ;
    sh:property [
        sh:path dct:spatial ;
        sh:class dct:Location ;
        sh:severity sh:Warning ;
        sh:name "spatial coverage"@en ;
    ] ;
    sh:property [
        sh:path dct:accrualPeriodicity ;
        sh:class dct:Frequency ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:name "frequency"@en ;
    ] ;
    sh:property [
        sh:path dct:language ;
        sh:class dct:LinguisticSystem ;
        sh:severity sh:Warning ;
        sh:name "language"@en ;
    ] ;
    sh:property [
        sh:path dcat:landingPage ;
        sh:class foaf:Document ;
        sh:severity sh:Warning ;
        sh:name "landing page"@en ;
    ] ;
    sh:property [
        sh:path dct:conformsTo ;
        sh:class dct:Standard ;
        sh:severity sh:Warning ;
        sh:name "conforms to"@en ;
    ] ;
    sh:property [
        sh:path r5r:applicableLegislation ;
        sh:class eli:LegalResource ;
        sh:severity sh:Warning ;
        sh:name "applicable legislation"@en ;
    ] ;
    sh:property [
        sh:path dct:accessRights ;
        sh:class dct:RightsStatement ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:name "access rights"@en ;
    ] ;
    sh:property [
        sh:path dcat:contactPoint ;
        sh:class vcard:Kind ;
        sh:severity sh:Warning ;
        sh:name "contact point"@en ;
    ] ;
    sh:property [
        sh:path dct:issued ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:severity sh:Warning ;
        sh:name "release date"@en ;
    ] ;
    sh:property [
        sh:path dct:modified ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:severity sh:Warning ;
        sh:name "modification date"@en ;
    ] ;
    sh:property [
        sh:path dct:creator ;
        sh:class foaf:Agent ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:name "creator"@en ;
    ] ;
    sh:property [
        sh:path dct:license ;
        sh:class dct:LicenseDocument ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:name "licence"@en ;
    ] ;
    sh:property [
        sh:path dct:identifier ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Warning ;
        sh:name "identifier"@en ;
    ] ;
    sh:property [
        sh:path dct:type ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:name "type"@en ;
    ] ;
    sh:property [
        sh:path dct:rights ;
        sh:class dct:RightsStatement ;
        sh:severity sh:Warning ;
        sh:name "rights"@en ;
    ] .

# ============================================================
# Distribution
# ============================================================

<urn:dcatap:shapes:DistributionShape> a sh:NodeShape ;
    sh:targetClass dcat:Distribution ;
    sh:property [
        sh:path dcat:accessURL ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Violation ;
        sh:name "access URL"@en ;
        sh:description "A URL that gives access to the Distribution of the Dataset."@en ;
    ] ;
    sh:property [
        sh:path dct:format ;
        sh:class dct:MediaTypeOrExtent ;
        sh:severity sh:Warning ;
        sh:name "format"@en ;
    ] ;
    sh:property [
        sh:path dcat:mediaType ;
        sh:class dct:MediaType ;
        sh:severity sh:Warning ;
        sh:name "media type"@en ;
    ] ;
    sh:property [
        sh:path dct:license ;
        sh:class dct:LicenseDocument ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:name "licence"@en ;
    ] ;
    sh:property [
        sh:path dct:title ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Warning ;
        sh:name "title"@en ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Warning ;
        sh:name "description"@en ;
    ] ;
    sh:property [
        sh:path dcat:downloadURL ;
        sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
        sh:name "download URL"@en ;
    ] ;
    sh:property [
        sh:path dcat:byteSize ;
        sh:maxCount 1 ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:severity sh:Warning ;
        sh:name "byte size"@en ;
    ] ;
    sh:property [
        sh:path dct:issued ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:severity sh:Warning ;
        sh:name "release date"@en ;
    ] ;
    sh:property [
        sh:path dct:modified ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:severity sh:Warning ;
        sh:name "modification date"@en ;
    ] ;
    sh:property [
        sh:path dct:conformsTo ;
        sh:class dct:Standard ;
        sh:severity sh:Warning ;
        sh:name "linked schemas"@en ;
    ] ;
    sh:property [
        sh:path dct:rights ;
        sh:class dct:RightsStatement ;
        sh:severity sh:Warning ;
        sh:name "rights"@en ;
    ] ;
    sh:property [
        sh:path dct:language ;
        sh:class dct:LinguisticSystem ;
        sh:severity sh:Warning ;
        sh:name "language"@en ;
    ] ;
    sh:property [
        sh:path adms:status ;
        sh:class skos:Concept ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:name "status"@en ;
    ] ;
    sh:property [
        sh:path r5r:applicableLegislation ;
        sh:class eli:LegalResource ;
        sh:severity sh:Warning ;
        sh:name "applicable legislation"@en ;
    ] ;
    sh:property [
        sh:path dcat:accessService ;
        sh:class dcat:DataService ;
        sh:severity sh:Warning ;
        sh:name "access service"@en ;
    ] .

