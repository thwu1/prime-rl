# ============================================================
# Supporting Classes — Agents, Concepts, etc.
# ============================================================

<urn:dcatap:shapes:AgentShape> a sh:NodeShape ;
    sh:targetClass foaf:Agent ;
    sh:property [
        sh:path foaf:name ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Violation ;
        sh:name "name"@en ;
        sh:description "A name of the Agent."@en ;
    ] .

<urn:dcatap:shapes:DocumentShape> a sh:NodeShape ;
    sh:targetClass foaf:Document .

<urn:dcatap:shapes:ConceptShape> a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Violation ;
        sh:name "preferred label"@en ;
        sh:description "A preferred label of the Concept."@en ;
    ] .

<urn:dcatap:shapes:ConceptSchemeShape> a sh:NodeShape ;
    sh:targetClass skos:ConceptScheme ;
    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Violation ;
        sh:name "title"@en ;
        sh:description "A name of the Concept Scheme."@en ;
    ] .

# ============================================================
# Dublin Core Supporting Classes
# ============================================================

<urn:dcatap:shapes:FrequencyShape> a sh:NodeShape ;
    sh:targetClass dct:Frequency .

<urn:dcatap:shapes:LicenseDocumentShape> a sh:NodeShape ;
    sh:targetClass dct:LicenseDocument .

<urn:dcatap:shapes:LinguisticSystemShape> a sh:NodeShape ;
    sh:targetClass dct:LinguisticSystem .

<urn:dcatap:shapes:LocationShape> a sh:NodeShape ;
    sh:targetClass dct:Location .

<urn:dcatap:shapes:MediaTypeShape> a sh:NodeShape ;
    sh:targetClass dct:MediaType .

<urn:dcatap:shapes:MediaTypeOrExtentShape> a sh:NodeShape ;
    sh:targetClass dct:MediaTypeOrExtent .

<urn:dcatap:shapes:PeriodOfTimeShape> a sh:NodeShape ;
    sh:targetClass dct:PeriodOfTime ;
    sh:property [
        sh:path dcat:startDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:severity sh:Warning ;
        sh:name "start date"@en ;
    ] ;
    sh:property [
        sh:path dcat:endDate ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:severity sh:Warning ;
        sh:name "end date"@en ;
    ] .

<urn:dcatap:shapes:RightsStatementShape> a sh:NodeShape ;
    sh:targetClass dct:RightsStatement .

<urn:dcatap:shapes:StandardShape> a sh:NodeShape ;
    sh:targetClass dct:Standard .

# ============================================================
# Other Supporting Classes
# ============================================================

<urn:dcatap:shapes:LegalResourceShape> a sh:NodeShape ;
    sh:targetClass eli:LegalResource .

<urn:dcatap:shapes:KindShape> a sh:NodeShape ;
    sh:targetClass vcard:Kind .
