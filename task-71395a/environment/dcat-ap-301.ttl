# DCAT-AP 3.0.1 SHACL Shapes
# Derived from https://semiceu.github.io/DCAT-AP/releases/3.0.1
# Application Profile for Data Portals in Europe
# Constraints enforce mandatory/recommended properties, cardinality,
# class typing, datatype, and node kind.
#
# Build stamp: dcatap-shapes-v2-20260610

@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix eli:   <http://data.europa.eu/eli/ontology#> .
@prefix r5r:   <http://data.europa.eu/r5r/> .
@prefix spdx:  <http://spdx.org/rdf/terms#> .
@prefix adms:  <http://www.w3.org/ns/adms#> .
@prefix locn:  <http://www.w3.org/ns/locn#> .
@prefix odrl:  <http://www.w3.org/ns/odrl/2/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix time:  <http://www.w3.org/2006/time#> .

# ============================================================
# Catalogue
# ============================================================

<urn:dcatap:shapes:CatalogShape> a sh:NodeShape ;
    sh:targetClass dcat:Catalog ;
    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Violation ;
        sh:name "title"@en ;
        sh:description "A name given to the Catalogue."@en ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Violation ;
        sh:name "description"@en ;
        sh:description "A free-text account of the Catalogue."@en ;
    ] ;
    sh:property [
        sh:path dct:publisher ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class foaf:Agent ;
        sh:severity sh:Violation ;
        sh:name "publisher"@en ;
        sh:description "An entity responsible for making the Catalogue available."@en ;
    ] ;
    sh:property [
        sh:path dcat:dataset ;
        sh:class dcat:Dataset ;
        sh:severity sh:Warning ;
        sh:name "dataset"@en ;
        sh:description "A Dataset that is part of the Catalogue."@en ;
    ] ;
    sh:property [
        sh:path dcat:service ;
        sh:class dcat:DataService ;
        sh:severity sh:Warning ;
        sh:name "service"@en ;
        sh:description "A site or end-point that is listed in the Catalogue."@en ;
    ] ;
    sh:property [
        sh:path dct:language ;
        sh:class dct:LinguisticSystem ;
        sh:severity sh:Warning ;
        sh:name "language"@en ;
    ] ;
    sh:property [
        sh:path dct:spatial ;
        sh:class dct:Location ;
        sh:severity sh:Warning ;
        sh:name "geographical coverage"@en ;
    ] ;
    sh:property [
        sh:path dcat:themeTaxonomy ;
        sh:class skos:ConceptScheme ;
        sh:severity sh:Warning ;
        sh:name "themes"@en ;
    ] ;
    sh:property [
        sh:path dct:license ;
        sh:class dct:LicenseDocument ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:name "licence"@en ;
    ] ;
    sh:property [
        sh:path dct:issued ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:severity sh:Warning ;
        sh:name "release date"@en ;
    ] ;
    sh:property [
        sh:path dct:modified ;
        sh:maxCount 1 ;
        sh:datatype xsd:date ;
        sh:severity sh:Warning ;
        sh:name "modification date"@en ;
    ] ;
    sh:property [
        sh:path foaf:homepage ;
        sh:class foaf:Document ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:name "homepage"@en ;
    ] ;
    sh:property [
        sh:path dct:temporal ;
        sh:class dct:PeriodOfTime ;
        sh:severity sh:Warning ;
        sh:name "temporal coverage"@en ;
    ] ;
    sh:property [
        sh:path dct:creator ;
        sh:class foaf:Agent ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:name "creator"@en ;
    ] ;
    sh:property [
        sh:path dct:rights ;
        sh:class dct:RightsStatement ;
        sh:severity sh:Warning ;
        sh:name "rights"@en ;
    ] ;
    sh:property [
        sh:path r5r:applicableLegislation ;
        sh:class eli:LegalResource ;
        sh:severity sh:Warning ;
        sh:name "applicable legislation"@en ;
    ] .

# ============================================================
# Dataset
# ============================================================

<urn:dcatap:shapes:DatasetShape> a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Violation ;
        sh:name "title"@en ;
        sh:description "A name given to the Dataset."@en ;
    ] ;
    sh:property [
        sh:path dct:description ;
        sh:minCount 1 ;
        sh:nodeKind sh:Literal ;
        sh:severity sh:Violation ;
        sh:name "description"@en ;
        sh:description "A free-text account of the Dataset."@en ;
    ] ;
    sh:property [
        sh:path dcat:distribution ;
        sh:class dcat:Distribution ;
        sh:severity sh:Warning ;
        sh:name "distribution"@en ;
    ] ;
    sh:property [
        sh:path dct:publisher ;
        sh:class foaf:Agent ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:name "publisher"@en ;
    ] ;
    sh:property [
        sh:path dcat:theme ;
        sh:class skos:Concept ;
        sh:severity sh:Warning ;
        sh:name "theme"@en ;
    ] ;
    sh:property [
        sh:path dcat:keyword ;
