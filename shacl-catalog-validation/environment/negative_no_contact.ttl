@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

# Negative sample: dataset is missing dcat:contactPoint

<http://neg-test/ds-contact> a dcat:Dataset ;
    dct:title "Contact Point Test"@en ;
    dct:description "Dataset without a contact point"@en ;
    dct:spatial [
        a dct:Location ;
        locn:geometry "POLYGON((10 50, 11 50, 11 51, 10 51, 10 50))"^^geo:wktLiteral ;
        locn:geographicName "Test Region"
    ] ;
    dct:temporal [
        a dct:PeriodOfTime ;
        dcat:startDate "2019-06-01"^^xsd:date ;
        dcat:endDate "2022-05-31"^^xsd:date
    ] ;
    dcat:keyword "monitoring"@en , "environment"@en , "Umwelt"@de ;
    dcat:theme <http://neg-test/concept/t6> ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/MONTHLY> ;
    dcat:spatialResolutionInMeters "500.0"^^xsd:decimal ;
    dct:conformsTo <http://neg-test/standard/s6> ;
    dct:creator <http://neg-test/agent/a6> ;
    dcat:distribution <http://neg-test/dist/d6> .

<http://neg-test/concept/t6> a skos:Concept ;
    skos:prefLabel "Environment Theme"@en .

<http://neg-test/agent/a6> a foaf:Agent ;
    foaf:name "Test Agency" ;
    foaf:mbox <mailto:info@neg-test.eu> .

<http://neg-test/dist/d6> a dcat:Distribution ;
    dcat:accessURL <http://neg-test/access/6> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/csv> ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/CSV> ;
    dcat:byteSize "8388608"^^xsd:nonNegativeInteger ;
    spdx:checksum [
        a spdx:Checksum ;
        spdx:checksumValue "b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3" ;
        spdx:algorithm <http://spdx.org/rdf/terms#checksumAlgorithm_sha256>
    ] .
