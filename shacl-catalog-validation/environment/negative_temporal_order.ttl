@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .

# Negative sample: startDate is AFTER endDate (must be rejected by SPARQL ordering constraint)

<http://neg-test/ds-temporal> a dcat:Dataset ;
    dct:title "Temporal Order Test"@en ;
    dct:description "Dataset with reversed temporal dates"@en ;
    dct:spatial [
        a dct:Location ;
        locn:geometry "POLYGON((10 50, 11 50, 11 51, 10 51, 10 50))"^^geo:wktLiteral ;
        locn:geographicName "Test Region"
    ] ;
    dct:temporal [
        a dct:PeriodOfTime ;
        dcat:startDate "2025-06-01"^^xsd:date ;
        dcat:endDate "2020-01-15"^^xsd:date
    ] ;
    dcat:keyword "test alpha"@en , "test beta"@en , "Testbegriff"@de ;
    dcat:theme <http://neg-test/concept/t1> ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/ANNUAL> ;
    dcat:spatialResolutionInMeters "100.0"^^xsd:decimal ;
    dct:conformsTo <http://neg-test/standard/s1> ;
    dct:creator <http://neg-test/agent/a1> ;
    dcat:contactPoint [
        a vcard:Kind ;
        vcard:hasEmail <mailto:contact@neg-test.eu> ;
        vcard:fn "Test Contact"
    ] ;
    dcat:distribution <http://neg-test/dist/d1> .

<http://neg-test/concept/t1> a skos:Concept ;
    skos:prefLabel "Test Theme"@en .

<http://neg-test/agent/a1> a foaf:Agent ;
    foaf:name "Test Agency" ;
    foaf:mbox <mailto:info@neg-test.eu> .

<http://neg-test/dist/d1> a dcat:Distribution ;
    dcat:accessURL <http://neg-test/access/1> ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/csv> ;
    dct:format <http://publications.europa.eu/resource/authority/file-type/CSV> ;
    dcat:byteSize "1048576"^^xsd:nonNegativeInteger ;
    spdx:checksum [
        a spdx:Checksum ;
        spdx:checksumValue "e3b0c44298fc1c149afbf4c8996fb924" ;
        spdx:algorithm <http://spdx.org/rdf/terms#checksumAlgorithm_sha256>
    ] .
