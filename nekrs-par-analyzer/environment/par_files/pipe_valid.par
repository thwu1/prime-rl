# Turbulent Pipe Flow: Re_bulk=19000, periodic in Z
[GENERAL]
polynomialOrder = 7
stopAt = endTime
endTime = 200

dt = 6.0e-3
timeStepper = tombo2
advectionSubCyclingSteps = 2

checkpointControl = simulationTime
checkpointInterval = 20

regularization = hpfrt + nModes=1 + scalingCoeff=10
constFlowRate = meanVelocity=1.0 + direction=Z

[FLUID PRESSURE]
residualTol = 1e-04

[FLUID VELOCITY]
boundaryTypeMap = zeroDirichlet
viscosity = 1/19000 # 1/Re_bulk
rho = 1.0
residualTol = 1e-06
