# RANS k-tau Channel (BROKEN - 3 errors)
[GENERAL]
polynomialOrder = 5

stopAt = endTime
endTime = 100

dt = targetCFL=0.5+initial=1e-3

timeStepper = tombo2

checkpointControl = simulationTime
checkpointInterval = 100

constFlowRate = meanVelocity=1.0 + direction=X

scalars = K, TAU

[FLUID PRESSURE]
residualTol = 1e-04

[FLUID VELOCITY]
boundaryTypeMap = zeroDirichlet
viscosity = -1/10595
rho = 1.0
residualTol = 1e-06

[SCALAR K]
boundaryTypeMap = udfDirichlet
residualTol = 1e-08
