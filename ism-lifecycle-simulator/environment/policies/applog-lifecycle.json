{
  "_id": "applog-lifecycle",
  "_seq_no": 5,
  "_primary_term": 1,
  "policy": {
    "policy_id": "applog-lifecycle",
    "description": "Application log index lifecycle with hot-warm-cold tiers",
    "default_state": "hot",
    "states": [
      {
        "name": "hot",
        "actions": [
          {
            "rollover": {
              "min_doc_count": 10000000,
              "min_index_age": "2d"
            }
          }
        ],
        "transitions": [
          {
            "state_name": "warm",
            "conditions": { "min_index_age": "5d" }
          }
        ]
      },
      {
        "name": "warm",
        "actions": [
          { "replica_count": { "number_of_replicas": 1 } },
          { "force_merge": { "max_num_segments": 1 } }
        ],
        "transitions": [
          {
            "state_name": "cold",
            "conditions": { "min_index_age": "10d" }
          }
        ]
      },
      {
        "name": "cold",
        "actions": [
          { "read_only": {} },
          { "replica_count": { "number_of_replicas": 0 } }
        ],
        "transitions": [
          {
            "state_name": "delete",
            "conditions": { "min_index_age": "15d" }
          }
        ]
      },
      {
        "name": "delete",
        "actions": [{ "delete": {} }],
        "transitions": []
      }
    ]
  }
}
