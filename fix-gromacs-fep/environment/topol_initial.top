; Methanol in water - OPLS-AA + SPC (self-contained topology)
;

[ defaults ]
; nbfunc  comb-rule  gen-pairs  fudgeLJ  fudgeQQ
  1       3          yes        0.5      0.5

[ atomtypes ]
; name      at.num  mass       charge  ptype  sigma          epsilon
opls_157    6       12.01100   0.000   A      3.50000e-01    2.76144e-01
opls_140    1        1.00800   0.000   A      2.50000e-01    1.25520e-01
opls_154    8       15.99940   0.000   A      3.12000e-01    7.11280e-01
opls_155    1        1.00800   0.000   A      0.00000e+00    0.00000e+00
OW          8       15.99940   0.000   A      3.16557e-01    6.50170e-01
HW          1        1.00800   0.000   A      0.00000e+00    0.00000e+00

; ========================================
; Methanol molecule
; ========================================
[ moleculetype ]
; name  nrexcl
MOL     3

