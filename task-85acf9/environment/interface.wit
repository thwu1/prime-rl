// WIT interface definitions for canonical ABI type tests.
//
// These types mirror the JSON definitions in types.json and are used
// for cross-referencing with the canonical ABI specification.
//

package component:abi-test@0.1.0;

interface types {

    record point2d {
        x: f32,
        y: f32,
    }

    record rgba {
        r: u8,
        g: u8,
        b: u8,
        a: u8,
    }

    record mixed-align {
        flag: bool,
        value: f64,
        tag: u16,
    }

    enum direction {
        north,
        east,
        south,
        west,
    }

    flags small-flags {
        read,
        write,
        execute,
        delete,
        create,
    }

    flags medium-flags {
        f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11,
    }

    flags large-flags {
        f0, f1, f2, f3, f4, f5, f6, f7,
        f8, f9, f10, f11, f12, f13, f14, f15,
        f16, f17, f18, f19, f20, f21, f22, f23,
        f24, f25, f26, f27, f28, f29, f30, f31,
        f32x, f33, f34, f35, f36, f37, f38, f39,
    }

    variant error-info {
        %none,
        code(u32),
        detail(point2d),
    }

    // option<f64>
    type maybe-value = option<f64>;

    // result<u32, error-info>
    type op-result = result<u32, error-info>;

    // tuple<u32, f64>
    type pair = tuple<u32, f64>;

    record nested-record {
        id: u64,
        pos: point2d,
        color: rgba,
        active: bool,
    }

    // option<option<f64>>
    type nested-opt = option<maybe-value>;

    variant complex-variant {
        empty,
        flag(bool),
        small(u8),
        medium(u32),
        large(f64),
        compound(pair),
    }

    record wide-record {
        a: f64, b: f64, c: f64,
        d: f64, e: f64, f: f64,
        g: f64, h: f64, i: f64,
    }

    record mega-record {
        f0: u32, f1: u32, f2: u32, f3: u32,
        f4: u32, f5: u32, f6: u32, f7: u32,
        f8: u32, f9: u32, f10: u32, f11: u32,
        f12: u32, f13: u32, f14: u32, f15: u32,
        f16: u32,
    }

    record message {
        priority: u8,
        text: string,
        timestamp: u64,
    }

    type point-list = list<point2d>;
}
