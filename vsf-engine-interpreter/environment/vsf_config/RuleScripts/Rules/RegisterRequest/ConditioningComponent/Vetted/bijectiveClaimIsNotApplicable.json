{
    "vsfScript": [
        {
            "lineType": "Branch",
            "description": "When vetted, bijectiveClaim is not applicable and must be null",
            "conditions": [
                {
                    "if": {
                        "scriptLines": [
                            {
                                "lineType": "Rule",
                                "parameters": {
                                    "ruleText": "parentProperty.IsVetted == true"
                                }
                            }
                        ]
                    },
                    "then": {
                        "scriptLines": [
                            {
                                "lineType": "Rule",
                                "ruleType": "External",
                                "parameters": {
                                    "ruleText": "currentProperty == null"
                                }
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
