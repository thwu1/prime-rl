<?xml version="1.0" ?>
<!-- Custom 6-DOF revolute robot arm with RPY-encoded frame rotations -->
<robot name="hex_arm_6r">
  <link name="base_link"/>
  <link name="link_1"/>
  <link name="link_2"/>
  <link name="link_3"/>
  <link name="link_4"/>
  <link name="link_5"/>
  <link name="link_6"/>
  <link name="end_effector"/>

  <!-- Joint 1: Base pan (rotation about Z) -->
  <joint name="joint_1" type="revolute">
    <origin xyz="0 0 0.185" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <parent link="base_link"/>
    <child link="link_1"/>
    <limit lower="-2.967" upper="2.967" effort="100" velocity="2.0"/>
  </joint>

  <!-- Joint 2: Shoulder lift (frame tilted pi/2 about Y so local Z aligns with parent X) -->
  <joint name="joint_2" type="revolute">
    <origin xyz="0.038 0 0" rpy="0 1.5707963268 0"/>
    <axis xyz="0 0 1"/>
    <parent link="link_1"/>
    <child link="link_2"/>
    <limit lower="-2.094" upper="2.094" effort="100" velocity="2.0"/>
  </joint>

  <!-- Joint 3: Elbow (no frame tilt, upper arm length 0.378) -->
  <joint name="joint_3" type="revolute">
    <origin xyz="-0.378 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <parent link="link_2"/>
    <child link="link_3"/>
    <limit lower="-2.618" upper="2.618" effort="50" velocity="3.0"/>
  </joint>

  <!-- Joint 4: Wrist 1 (forearm length 0.327, lateral offset 0.1075, pi/2 tilt) -->
  <joint name="joint_4" type="revolute">
    <origin xyz="-0.327 0 0.1075" rpy="0 1.5707963268 0"/>
    <axis xyz="0 0 1"/>
    <parent link="link_3"/>
    <child link="link_4"/>
    <limit lower="-3.14159" upper="3.14159" effort="28" velocity="3.2"/>
  </joint>

  <!-- Joint 5: Wrist 2 (Y offset creates spherical wrist center, -pi/2 tilt) -->
  <joint name="joint_5" type="revolute">
    <origin xyz="0 -0.0922 0" rpy="0 -1.5707963268 0"/>
    <axis xyz="0 0 1"/>
    <parent link="link_4"/>
    <child link="link_5"/>
    <limit lower="-2.094" upper="2.094" effort="28" velocity="3.2"/>
  </joint>

  <!-- Joint 6: Tool rotation (cancelling Y offset for spherical wrist) -->
  <joint name="joint_6" type="revolute">
    <origin xyz="0 0.0922 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <parent link="link_5"/>
    <child link="link_6"/>
    <limit lower="-3.14159" upper="3.14159" effort="28" velocity="3.2"/>
  </joint>

  <!-- Fixed end-effector frame with -45 degree yaw offset -->
  <joint name="ee_joint" type="fixed">
    <origin xyz="0 0 0.0825" rpy="0 0 -0.7853981634"/>
    <parent link="link_6"/>
    <child link="end_effector"/>
  </joint>
</robot>
