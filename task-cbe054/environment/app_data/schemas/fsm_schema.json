{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["protocol", "source", "states", "events", "transitions"],
  "properties": {
    "protocol": {"type": "string"},
    "source": {"type": "string"},
    "states": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "events": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "event", "to"],
        "properties": {
          "from": {"type": "string"},
          "event": {"type": "string"},
          "to": {"type": "string"},
          "condition": {"type": "string"},
          "action": {"type": "string"}
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  }
}
