SQL> SET LINESIZE 250
SQL> SET PAGESIZE 100
SQL> COLUMN NAME FORMAT A30
SQL> COLUMN VALUE FORMAT A20
SQL> COLUMN ISDEFAULT FORMAT A10
SQL> COLUMN DESCRIPTION FORMAT A70
SQL> SELECT NAME, VALUE, ISDEFAULT, DESCRIPTION
  2  FROM V$PARAMETER
  3  WHERE NAME IN ('db_cache_size','shared_pool_size','pga_aggregate_target',
  4    'sga_target','memory_target','cursor_sharing','optimizer_mode',
  5    'db_block_size','sga_max_size','statistics_level','result_cache_mode',
  6    'inmemory_size','log_buffer','open_cursors','session_cached_cursors')
  7  ORDER BY NAME;

NAME                           VALUE                ISDEFAULT  DESCRIPTION
------------------------------ -------------------- ---------- ----------------------------------------------------------------------
cursor_sharing                 EXACT                TRUE       how to convert literal to bind variables
db_block_size                  8192                 FALSE      Size of database block in bytes
db_cache_size                  536870912            FALSE      Size of DEFAULT buffer pool for buffers with the primary block size
inmemory_size                  0                    TRUE       size of the In-Memory Area
log_buffer                     16777216             FALSE      redo circular buffer size
memory_target                  0                    TRUE       Target size of Oracle Memory
open_cursors                   300                  TRUE       max # cursors per session
optimizer_mode                 ALL_ROWS             TRUE       optimizer mode
pga_aggregate_target           268435456            FALSE      Target size for the aggregate PGA memory consumed
result_cache_mode              MANUAL               TRUE       result cache operator usage mode
session_cached_cursors         50                   TRUE       Number of cursors to cache in a session
sga_max_size                   2147483648           FALSE      max SGA size
sga_target                     0                    TRUE       Target size of SGA
shared_pool_size               402653184            FALSE      size in bytes of shared pool
statistics_level               TYPICAL              TRUE       statistics level

15 rows selected.

SQL> spool off
