SQL> SET LINESIZE 200
SQL> SET PAGESIZE 100
SQL> COLUMN POOL FORMAT A15
SQL> COLUMN NAME FORMAT A30
SQL> SELECT POOL, NAME, BYTES FROM V$SGASTAT
  2  WHERE POOL IS NOT NULL OR NAME IN ('buffer_cache','log_buffer','fixed_sga')
  3  ORDER BY POOL, NAME;

