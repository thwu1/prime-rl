# Producer on chip 0 writes, consumers on chip 1 read
# Address 0x0000 homes on chip 0, 0x0080 homes on chip 0
0 WRITE 0x0000 0x100
4 READ 0x0000
5 READ 0x0000
6 READ 0x0000
7 READ 0x0000
0 WRITE 0x0000 0x200
4 READ 0x0000
5 READ 0x0000
6 READ 0x0000
7 READ 0x0000
0 WRITE 0x0000 0x300
4 READ 0x0000
5 READ 0x0000
6 READ 0x0000
7 READ 0x0000
# Second address on chip 0
0 WRITE 0x0080 0x400
4 READ 0x0080
5 READ 0x0080
6 READ 0x0080
7 READ 0x0080
0 WRITE 0x0080 0x500
4 READ 0x0080
5 READ 0x0080
6 READ 0x0080
7 READ 0x0080
