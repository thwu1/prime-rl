# Multiple addresses with mixed access patterns across chiplets
0 WRITE 0x0000 0x100
4 WRITE 0x0040 0x200
0 WRITE 0x0080 0x300
4 WRITE 0x00C0 0x400
# Cross-chiplet reads
4 READ 0x0000
5 READ 0x0000
0 READ 0x0040
1 READ 0x0040
4 READ 0x0080
0 READ 0x00C0
# Update and re-read across chiplets
0 WRITE 0x0000 0x500
5 READ 0x0000
6 READ 0x0000
7 READ 0x0000
4 WRITE 0x0040 0x600
1 READ 0x0040
2 READ 0x0040
3 READ 0x0040
# Complex interleaving
2 WRITE 0x0100 0x700
6 READ 0x0100
3 WRITE 0x0100 0x800
7 READ 0x0100
0 WRITE 0x0100 0x900
4 READ 0x0100
5 READ 0x0100
