<?xml version="1.0" encoding="UTF-8"?>
<ConformanceContext xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" UUID="tbench_adt_a01">
  <MetaData Name="RAD-1" OrgName="IHE" Version="1.0" Date="2024-01-01" Status="Active" />
  <Predicates>
    <Datatype>
      <ByID ID="HD">
        <Predicate ID="HD_P1" Target="3[1]" TrueUsage="R" FalseUsage="X">
          <Description>If HD.2 (Universal ID) is valued</Description>
          <Condition>
            <Presence Path="2[1]" />
          </Condition>
        </Predicate>
        <Predicate ID="HD_P2" Target="2[1]" TrueUsage="R" FalseUsage="X">
          <Description>If HD.3 (Universal ID Type) is valued</Description>
          <Condition>
            <Presence Path="3[1]" />
          </Condition>
        </Predicate>
      </ByID>
    </Datatype>
    <Segment>
      <ByID ID="OBX_RAD">
        <Predicate ID="OBX_P1" Target="2[1]" TrueUsage="R" FalseUsage="O">
          <Description>If OBX-5 (Observation Value) is valued</Description>
          <Condition>
            <Presence Path="5[1]" />
          </Condition>
        </Predicate>
        <Predicate ID="OBX_P2" Target="5[1]" TrueUsage="R" FalseUsage="O">
          <Description>If the value of OBX-11 is not one of list values: X,D,N,I</Description>
          <Condition>
            <NOT>
              <StringList Path="11[1]" CSV="X,D,N,I" />
            </NOT>
          </Condition>
        </Predicate>
      </ByID>
      <ByID ID="MSH_RAD">
        <Predicate ID="MSH_P1" Target="18[1]" TrueUsage="X" FalseUsage="R">
          <Description>If MSH-18 (Character Set) is not valued</Description>
          <Condition>
            <NOT>
              <Presence Path="18[1]" />
            </NOT>
          </Condition>
        </Predicate>
      </ByID>
    </Segment>
    <Group />
    <Message />
  </Predicates>
  <Constraints>
    <Datatype>
      <ByID ID="VID_V251">
        <Constraint ID="VID_C1">
          <Description>VID.1 SHALL contain the constant value '2.5.1'.</Description>
          <Assertion>
            <PlainText Path="1[1]" Text="2.5.1" IgnoreCase="false" />
          </Assertion>
        </Constraint>
      </ByID>
      <ByID ID="DTM">
        <Constraint ID="DTM_C1" Target=".">
          <Description>Year is required: YYYY format minimum.</Description>
          <Assertion>
            <Format Path="." Regex="([0-9]{4})(((0[1-9])|(1[0-2]))(((0[1-9])|([1-2][0-9])|(3[0-1]))((([0-1][0-9])|(2[0-3]))(([0-5][0-9])(([0-5][0-9])(\.[0-9]{1,4})?)?)?)?)?)?((\+|\-)[0-9]{4})?" />
          </Assertion>
        </Constraint>
      </ByID>
    </Datatype>
    <Segment />
    <Group />
    <Message>
      <ByID ID="msg_adt_a01">
        <Constraint ID="MSG_C1">
          <Description>MSH.9.1 SHALL contain the constant value 'ADT'.</Description>
          <Assertion>
            <PlainText Path="1[1].9[1].1[1]" Text="ADT" IgnoreCase="false" />
          </Assertion>
        </Constraint>
        <Constraint ID="MSG_C2">
          <Description>MSH.9.2 SHALL contain the constant value 'A01'.</Description>
          <Assertion>
            <PlainText Path="1[1].9[1].2[1]" Text="A01" IgnoreCase="false" />
          </Assertion>
        </Constraint>
        <Constraint ID="MSG_C3">
          <Description>MSH.9.3 SHALL contain the constant value 'ADT_A01'.</Description>
          <Assertion>
            <PlainText Path="1[1].9[1].3[1]" Text="ADT_A01" IgnoreCase="false" />
          </Assertion>
        </Constraint>
      </ByID>
    </Message>
  </Constraints>
</ConformanceContext>
