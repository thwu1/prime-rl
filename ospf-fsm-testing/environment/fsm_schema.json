{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OSPF Neighbor Finite State Machine",
  "type": "object",
  "required": ["states", "events", "transitions"],
  "properties": {
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_state", "event", "target_state"],
        "properties": {
          "source_state": {"type": "string"},
          "event": {"type": "string"},
          "conditions": {"type": "array", "items": {"type": "string"}},
          "actions": {"type": "array", "items": {"type": "string"}},
          "target_state": {"type": "string"}
        }
      }
    }
  }
}
