{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OSPF Conformance Test Cases",
  "type": "object",
  "required": ["test_cases"],
  "properties": {
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "objective", "setup", "stimulus", "expected_result", "fsm_transition"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "objective": {"type": "string"},
          "setup": {"type": "string"},
          "stimulus": {"type": "string"},
          "expected_result": {"type": "string"},
          "fsm_transition": {
            "type": "object",
            "required": ["source_state", "event", "target_state"],
            "properties": {
              "source_state": {"type": "string"},
              "event": {"type": "string"},
              "target_state": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
