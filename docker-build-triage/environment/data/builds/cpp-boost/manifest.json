{
  "project_name": "data-processor",
  "language": "cpp",
  "language_version": "c++20",
  "build_system": "cmake",
  "dependencies": [
    "Boost >= 1.74 (system, filesystem, program_options)",
    "Threads"
  ],
  "test_framework": "ctest",
  "test_command": "cd build && ctest --output-on-failure",
  "notes": "Requires CMake >= 3.16 and Boost >= 1.74 for C++20 coroutine support. Ubuntu 18.04 only provides Boost 1.65."
}
