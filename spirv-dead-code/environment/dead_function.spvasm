; SPIR-V
; Compute shader with an unused helper function
; The helper function is defined but never called
               OpCapability Shader
          %1 = OpExtInstImport "GLSL.std.450"
               OpMemoryModel Logical GLSL450
               OpEntryPoint GLCompute %main "main" %gl_GlobalInvocationID
               OpExecutionMode %main LocalSize 64 1 1
               OpDecorate %gl_GlobalInvocationID BuiltIn GlobalInvocationId
               OpDecorate %Buffer BufferBlock
               OpMemberDecorate %Buffer 0 Offset 0
               OpDecorate %ssbo DescriptorSet 0
               OpDecorate %ssbo Binding 0
               OpDecorate %arr ArrayStride 4
       %void = OpTypeVoid
    %fn_void = OpTypeFunction %void
       %uint = OpTypeInt 32 0
     %v3uint = OpTypeVector %uint 3
%ptr_in_v3uint = OpTypePointer Input %v3uint
      %float = OpTypeFloat 32
        %arr = OpTypeRuntimeArray %float
     %Buffer = OpTypeStruct %arr
  %ptr_u_buf = OpTypePointer Uniform %Buffer
  %ptr_u_flt = OpTypePointer Uniform %float
     %fn_f_f = OpTypeFunction %float %float
     %uint_0 = OpConstant %uint 0
  %float_1_0 = OpConstant %float 1.0
  %float_2_0 = OpConstant %float 2.0
%gl_GlobalInvocationID = OpVariable %ptr_in_v3uint Input
       %ssbo = OpVariable %ptr_u_buf Uniform
     %helper = OpFunction %float None %fn_f_f
    %h_param = OpFunctionParameter %float
    %h_entry = OpLabel
   %h_result = OpFMul %float %h_param %float_2_0
               OpReturnValue %h_result
               OpFunctionEnd
       %main = OpFunction %void None %fn_void
      %entry = OpLabel
       %gid3 = OpLoad %v3uint %gl_GlobalInvocationID
        %idx = OpCompositeExtract %uint %gid3 0
        %ptr = OpAccessChain %ptr_u_flt %ssbo %uint_0 %idx
               OpStore %ptr %float_1_0
               OpReturn
               OpFunctionEnd
