^SERIES = GSE99999
!Series_title = Gene expression profiling of clear cell renal cell carcinoma versus matched adjacent normal kidney tissue
!Series_geo_accession = GSE99999
!Series_status = Public on Jan 15 2024
!Series_submission_date = Dec 01 2023
!Series_last_update_date = Mar 22 2024
!Series_summary = Clear cell renal cell carcinoma (ccRCC) is the most common subtype of kidney cancer. We performed gene expression profiling on tumor and matched normal kidney tissue across all stages to identify stage-specific molecular signatures and potential therapeutic targets.
!Series_summary = Total RNA was extracted from flash-frozen tissue samples and hybridized to Affymetrix Human Genome U133 Plus 2.0 arrays.
!Series_overall_design = 16 samples total: 8 matched pairs of tumor and adjacent normal kidney tissue across 4 disease stages (2 pairs per stage)
!Series_type = Expression profiling by array
!Series_contributor = John,A,Copland
!Series_contributor = Christina,A,von Roemeling
!Series_contributor = Han,W,Tun
!Series_pubmed_id = 24962026
!Series_platform_id = GPL570
!Series_platform_organism = Homo sapiens
