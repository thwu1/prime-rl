{
  "system_name": "BigSpender Expense Management Platform",
  "description": "A distributed web-based expense management system with 28 components deployed across heterogeneous infrastructure nodes. The system handles expense submission, approval workflows, payment processing, fraud detection, reporting, and compliance auditing.",
