  "quality_attributes": {
    "latency_scenarios": [
      {
        "name": "User authentication flow",
        "description": "End-to-end latency for user login through identity verification",
        "path": ["web-gateway", "rate-limiter", "auth-service", "user-service"],
        "max_end_to_end_ms": 25.0
      },
      {
        "name": "Expense submission",
        "description": "End-to-end latency for submitting an expense with policy check",
        "path": ["web-gateway", "rate-limiter", "expense-service", "policy-engine"],
        "max_end_to_end_ms": 25.0
      },
      {
        "name": "Payment processing",
        "description": "Latency from expense approval through payment and fraud check",
        "path": ["expense-service", "payment-gateway-adapter", "fraud-detector", "compliance-checker"],
        "max_end_to_end_ms": 30.0
      },
      {
        "name": "Report retrieval",
        "description": "Latency for generating a cached expense report",
        "path": ["report-generator", "expense-service", "cache-layer"],
        "max_end_to_end_ms": 20.0
      },
      {
        "name": "End-to-end fraud check",
        "description": "Full path from gateway to fraud detection completion",
        "path": ["web-gateway", "rate-limiter", "expense-service", "payment-gateway-adapter", "fraud-detector"],
        "max_end_to_end_ms": 35.0
      }
    ],
    "az_distribution_requirements": [
      {
        "description": "Authentication components must span availability zones for fault tolerance",
        "component_group": ["auth-service", "session-manager", "user-service"],
        "min_zones": 2
      },
      {
        "description": "Core business workflow must span availability zones",
        "component_group": ["expense-service", "approval-workflow", "budget-tracker"],
        "min_zones": 2
      },
      {
        "description": "Payment and fraud components must span availability zones",
        "component_group": ["fraud-detector", "compliance-checker", "payment-gateway-adapter"],
        "min_zones": 2
      }
    ],
    "affinity_rules": [
      {
        "description": "Cache must be co-located with primary consumer for sub-millisecond access",
        "components": ["cache-layer", "expense-service"],
        "type": "same_node"
      },
      {
        "description": "Report generator and PDF renderer exchange large payloads",
        "components": ["report-generator", "pdf-renderer"],
        "type": "same_node"
      },
      {
        "description": "Health monitor and metrics collector share memory-mapped data",
        "components": ["health-monitor", "metrics-collector"],
        "type": "same_node"
      }
    ],
    "anti_affinity_rules": [
      {
        "description": "Auth and session services must be isolated for blast radius containment",
        "components": ["auth-service", "session-manager"],
        "type": "different_node"
      },
      {
        "description": "Fraud and compliance must be on separate nodes for regulatory independence",
        "components": ["fraud-detector", "compliance-checker"],
        "type": "different_node"
      }
    ]
  },
  "latency_model": {
    "same_node_ms": 0.5,
    "same_az_different_node_ms": 2.0,
    "cross_az_ms": 8.0,
    "description": "End-to-end latency for a path equals the sum of each component's processing_time_ms plus the sum of network hop latencies between consecutive components. Network hop latency depends on the relative placement of the two components."
  },
  "security_zone_hierarchy": {
    "description": "A component with security_classification X can only be placed on a node whose security_zone is at least X in the hierarchy. For example, a 'restricted' component requires a 'restricted' node; an 'internal' component can go on 'internal' or 'restricted' nodes.",
    "ordering": ["public", "internal", "restricted"]
  }
}
