    {
      "id": "web-gateway",
      "description": "API gateway and request router",
      "cpu_units": 2,
      "memory_mb": 2048,
      "security_classification": "public",
      "processing_time_ms": 1.0
    },
    {
      "id": "rate-limiter",
      "description": "Request rate limiting and throttling",
      "cpu_units": 1,
      "memory_mb": 1024,
      "security_classification": "public",
      "processing_time_ms": 0.5
    },
    {
      "id": "session-manager",
