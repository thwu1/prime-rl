# Thermal conductivity via direct energy injection (fix heat)
# LJ fluid: rho*=0.6, T*=1.35, rc=2.5 sigma
# Reference: Evans, Phys Rev A, 34, 1449 (1986), kappa ~ 3.4

# System dimensions: elongated in z for temperature gradient
variable        x equal 10
variable        y equal 10
variable        z equal 20

variable        rho equal 0.6
variable        t equal 1.35
variable        rc equal 2.5

# Setup
units           lj
atom_style      atomic

lattice         fcc ${rho}
region          box block 0 $x 0 $y 0 $z
create_box      1 box
create_atoms    1 box
mass            1 1.0

velocity        all create $t 87287

pair_style      lj/cut ${rc}
pair_coeff      1 1 1.0 1.0

neighbor        0.3 bin
neigh_modify    delay 0 every 1

# Define heat source and sink regions at opposite ends
region          hot block INF INF INF INF 0 1
region          cold block INF INF INF INF 10 11
compute         Thot all temp/region hot
compute         Tcold all temp/region cold

# 1st equilibration run (NVT)
fix             1 all nvt temp $t $t 0.5
thermo          100
run             1000

velocity        all scale $t
unfix           1

# 2nd equilibration run with heat injection
fix             1 all nve
fix             hot all heat 1 100.0 region hot
fix             cold all heat 1 -100.0 region cold

thermo_style    custom step temp c_Thot c_Tcold
thermo_modify   colname c_Thot Temp_hot colname c_Tcold Temp_cold
thermo          1000
run             10000

# Production run: measure temperature profile and compute kappa
compute         ke all ke/atom
variable        temp atom c_ke/1.5

compute         layers all chunk/atom bin/1d z lower 0.05 units reduced
fix             2 all ave/chunk 10 100 1000 layers v_temp file profile.heat

variable        tdiff equal f_2[1][3]-f_2[11][3]
fix             ave all ave/time 1 1 1000 v_tdiff ave running start 13000

# kappa = (energy_rate / cross_section_area / 2) * (half_box_length / delta_T)
# energy_rate = 100 (in LJ energy/time units, as specified in fix heat)
# factor of 2: heat flows in both +z and -z due to periodic boundaries
variable        kappa equal (100/(lx*ly)/2.0)*(lz/2.0)/f_ave
thermo_style    custom step temp c_Thot c_Tcold v_tdiff f_ave
thermo_modify   colname c_Thot Temp_hot colname c_Tcold Temp_cold &
                colname v_tdiff dTemp_step colname f_ave dTemp

run             20000
print           "Running average thermal conductivity: $(v_kappa:%.2f)"
