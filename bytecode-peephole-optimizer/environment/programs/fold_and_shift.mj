program FoldShift
{
  void main()
    int a; int b;
  {
    a = 100 + 200;
    print(a, 1);
    print(chr(10), 1);
    b = 1000 * 50;
    print(b, 1);
    print(chr(10), 1);
    a = 999 - 111;
    print(a, 1);
    print(chr(10), 1);
    a = 10 + 20 + 30;
    print(a, 1);
    print(chr(10), 1);
    a = 7;
    b = a * 8;
    print(b, 1);
    print(chr(10), 1);
    b = a * 16;
    print(b, 1);
    print(chr(10), 1);
    b = a * 32;
    print(b, 1);
    print(chr(10), 1);
  }
}
